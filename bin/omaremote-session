ERROR_RE = re.compile(r"\b(ERRCONNECT_[A-Z_]+|ERRINFO_[A-Z_]+)\b")


# ---------------------------------------------------------------- store

LEGACY_APP = "oma-remote"  # the name before OMARemote


def migrate_legacy():
    """Move config and cache from the old name once; the keyring moves per entry in secret_get."""
    for base in (os.path.dirname(CONFIG_DIR), os.path.dirname(CACHE_DIR)):
        old, new = os.path.join(base, LEGACY_APP), os.path.join(base, APP)
        if os.path.isdir(old) and not os.path.exists(new):
            try:
                os.rename(old, new)
            except OSError:
                pass


# Settings a group can set for its connections. A connection stores only what differs from what
# it inherits, so changing the group changes every connection that did not override it.
SETTING_KEYS = ("display", "width", "height", "scale", "multimon", "clipboard", "audio", "microphone",
                "homeDrive", "grabKeyboard", "security", "ignoreCert", "network", "gateway",
                "gatewayUser", "gatewayDomain", "kdc", "extraArgs", "openIn",
                "vncScaling", "vncQuality", "viewOnly")

DEFAULT_PORTS = {"rdp": 3389, "vnc": 5900, "ssh": 22}


def load_data(path=CONNECTIONS):
    """The saved file: {"connections": [...], "credentials": [...], "groups": {name: {...}}}."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    if isinstance(data, list):  # the very first format
        data = {"connections": data}
    return {
        "connections": [c for c in data.get("connections", []) if isinstance(c, dict)],
        "credentials": [c for c in data.get("credentials", []) if isinstance(c, dict) and c.get("id")],
        "groups": {k: v for k, v in (data.get("groups") or {}).items() if isinstance(v, dict)},
    }


def find_credential(cred_id, data):
    return next((c for c in data["credentials"] if c.get("id") == cred_id), None)


def resolve(conn, data):
    """The connection as it will be used: defaults, then its group's settings, then its own.

    Credentials come from one of three places, recorded in credentialSource:
      "custom"  the connection's own username/domain, password under the connection's id;
      "set"     a shared credential set (credential = its id), password under the set's id;
      "group"   credential = "inherit": the group's credential set, if it has one.
    secretKind/secretId say where the password lives in the keyring.
    """
    group = data["groups"].get(conn.get("group") or "", {})
    out = dict(DEFAULTS)
    out.update({k: v for k, v in (group.get("settings") or {}).items() if k in SETTING_KEYS})
    out.update(conn)
    if not conn.get("port"):
        out["port"] = DEFAULT_PORTS.get(out.get("protocol") or "rdp", 3389)

    mode = conn.get("credential") or "custom"
    cred_id = group.get("credential") if mode == "inherit" else (None if mode == "custom" else mode)
    if mode == "custom":
        out.update(credentialSource="custom", secretKind="connection", secretId=conn.get("id"))
    else:
        cred = find_credential(cred_id, data) if cred_id else None
        out.update(username=(cred or {}).get("username", ""), domain=(cred or {}).get("domain", ""),
                   savePassword=bool((cred or {}).get("savePassword")),
                   credentialSource="group" if mode == "inherit" else "set",
                   secretKind="credential", secretId=cred_id)
    return out


def load_connections(path=CONNECTIONS):
    data = load_data(path)
    return [resolve(c, data) for c in data["connections"]]


def find_connection(key, connections):
    for c in connections:
        if c.get("id") == key:
            return c
    lowered = key.lower()
    for c in connections:
        if c.get("name", "").lower() == lowered:
            return c
    # By host last, as the window's open() does.
    for c in connections:
        if c.get("host", "").lower() == lowered:
            return c
    return None


def mark_connected(conn_id, path=CONNECTIONS):
    """Stamp lastConnected; rewrites in place so the UI's watch on the file keeps firing."""
    try:
        with open(path, "r+", encoding="utf-8") as f:
            data = json.load(f)
            for c in data.get("connections", []):
                if c.get("id") == conn_id:
                    c["lastConnected"] = int(time.time())
            f.seek(0)
            f.write(json.dumps(data, indent=2))
            f.truncate()
    except (OSError, ValueError):
        pass


# ---------------------------------------------------------------- export, import and sync
#
# Connections and groups travel between systems; who signs in does not. A manual export is one
# file; folder sync is one file per system in a folder something else keeps in step (Nextcloud,
# Syncthing, …): each system writes only its own file, so none overwrites another, and merges the
# rest. Per connection and group the newest change wins (`modified`, ms). Deletions travel as
# tombstones and land in the trash, never straight out; a file that would trash many at once is
# held back for the UI to confirm. The UI stays the only writer of connections.json: the commands
# below print what to apply.

# Never leaves this machine (keep in step with localKeys in ui/Store.qml).
LOCAL_KEYS = ("username", "domain", "credential", "savePassword", "gatewayUser", "gatewayDomain",
              "extraArgs", "sshArgs", "sshKey", "lastConnected")
GROUP_LOCAL_SETTINGS = ("gatewayUser", "gatewayDomain", "extraArgs")
SYNC_SUFFIX = ".omaremote.json"
TRASH_DAYS = 30
DAY_MS = 24 * 3600 * 1000


def now_ms():
    return int(time.time() * 1000)


def load_raw(path=CONNECTIONS):
    """connections.json as stored, every key kept."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    if isinstance(data, list):
        data = {"connections": data}
    return data


def portable_connection(conn):
    return {k: v for k, v in conn.items() if k not in LOCAL_KEYS}


def portable_group(group):
    settings = {k: v for k, v in (group.get("settings") or {}).items() if k not in GROUP_LOCAL_SETTINGS}
    return {"settings": settings, "modified": group.get("modified", 0)}


def portable(data, system, kind="sync", now=None):
    """What other systems read. A manual export carries no deletions: importing one never removes."""
    return {
        "format": "omaremote-" + kind, "version": 1, "system": system,
        "written": now if now is not None else now_ms(),
        "connections": [portable_connection(c) for c in data.get("connections", [])
                        if isinstance(c, dict) and c.get("id")],
        "groups": {name: portable_group(g) for name, g in (data.get("groups") or {}).items() if isinstance(g, dict)},
        "deleted": dict(data.get("deleted") or {}) if kind == "sync" else {},
    }


def connection_key(conn):
    """The same server, whatever id each system gave it."""
    protocol = conn.get("protocol") or "rdp"
    try:
        port = int(conn.get("port") or DEFAULT_PORTS.get(protocol, 0))
    except (TypeError, ValueError):
        port = DEFAULT_PORTS.get(protocol, 0)
    return (protocol, (conn.get("host") or "").strip().lower(), port)


def _local_part(conn):
    return {k: v for k, v in conn.items() if k in LOCAL_KEYS}


def ids_of(conn):
    """A connection's id plus the ids other systems know it by (matched by host, see merge)."""
    return {conn.get("id")} | set(conn.get("aliases") or [])


def _with_aliases(new, *others):
    """new keeps its own id; every other id the same server goes by becomes an alias."""
    aliases = set()
    for c in others:
        aliases |= ids_of(c)
    aliases.discard(new.get("id"))
    aliases.discard(None)
    if aliases:
        new["aliases"] = sorted(aliases)
    return new


def merge(local, incoming, now=None, allow_deletions=()):
    """Merges other systems' files into connections.json's data. Returns (data, report).

    allow_deletions names systems whose mass deletion the user confirmed."""
    now = now if now is not None else now_ms()
    data = json.loads(json.dumps(local))
    conns = data.setdefault("connections", [])
    trash = data.setdefault("trash", [])
    deleted = data.setdefault("deleted", {})
    groups = data.setdefault("groups", {})
    report = {"added": [], "updated": [], "restored": [], "trashed": [], "pendingDeletions": [], "errors": []}

    for inc in incoming:
        if not isinstance(inc, dict) or inc.get("format") not in ("omaremote-sync", "omaremote-export"):
            report["errors"].append("not an OMARemote file: " + str((inc or {}).get("_path", "?")))
            continue
        if int(inc.get("version") or 0) > 1:
            report["errors"].append(f"{inc.get('system') or '?'}: written by a newer OMARemote")
            continue
        system = inc.get("system") or "another system"

        for name, g in (inc.get("groups") or {}).items():
            if not isinstance(g, dict):
                continue
            mine = groups.get(name)
            if mine is not None and g.get("modified", 0) <= mine.get("modified", 0):
                continue
            mine = dict(mine or {})
            kept = {k: v for k, v in (mine.get("settings") or {}).items() if k in GROUP_LOCAL_SETTINGS}
            mine["settings"] = dict({k: v for k, v in (g.get("settings") or {}).items()
                                     if k not in GROUP_LOCAL_SETTINGS}, **kept)
            mine["modified"] = g.get("modified", 0)
            mine.setdefault("credential", "")
            groups[name] = mine

        for ic in inc.get("connections") or []:
            if not isinstance(ic, dict) or not ic.get("id") or not (ic.get("host") or "").strip():
                continue
            changed = ic.get("modified", 0)
            theirs = ids_of(ic)
            if any(deleted.get(i, -1) >= changed for i in theirs):
                continue  # deleted here after that change
            key = connection_key(ic)
            match = next((c for c in conns if ids_of(c) & theirs), None) \
                or next((c for c in conns if connection_key(c) == key), None)
            if match is not None:
                if changed > match.get("modified", 0):
                    new = _with_aliases(dict(portable_connection(ic), **_local_part(match), id=match["id"]), match, ic)
                    conns[conns.index(match)] = new
                    report["updated"].append(new.get("name") or new.get("host"))
                elif not theirs <= ids_of(match):
                    # The same server under another id: remember it, so its deletion finds this one.
                    conns[conns.index(match)] = _with_aliases(dict(match), match, ic)
                continue
            binned = next((t for t in trash if ids_of(t.get("connection") or {}) & theirs), None) \
                or next((t for t in trash if connection_key(t.get("connection") or {}) == key), None)
            if binned is not None:
                if changed > binned.get("deleted", 0):
                    old = binned["connection"]
                    new = _with_aliases(dict(portable_connection(ic), **_local_part(old), id=old["id"]), old, ic)
                    trash.remove(binned)
                    deleted.pop(old["id"], None)
                    conns.append(new)
                    report["restored"].append(new.get("name") or new.get("host"))
                continue
            new = portable_connection(ic)
            new["credential"] = "inherit" if (groups.get(new.get("group") or "") or {}).get("credential") else "custom"
            conns.append(new)
            report["added"].append(new.get("name") or new.get("host"))

        doomed = []
        for cid, when in (inc.get("deleted") or {}).items():
            if not isinstance(when, (int, float)):
                continue
            c = next((c for c in conns if cid in ids_of(c)), None)
            if c is not None and when > c.get("modified", 0):
                doomed.append((c, when))
            elif c is None:
                deleted[cid] = max(deleted.get(cid, 0), when)  # passes the deletion on to others
        if doomed and len(doomed) > max(3, len(conns) // 4) and system not in allow_deletions:
            report["pendingDeletions"].append({"system": system, "ids": [c["id"] for c, _ in doomed],
                                               "names": [c.get("name") or c.get("host") for c, _ in doomed]})
            continue
        for c, when in doomed:
            conns.remove(c)
            trash.append({"connection": c, "deleted": when, "from": system})
            deleted[c["id"]] = max(deleted.get(c["id"], 0), when)
            report["trashed"].append(c.get("name") or c.get("host"))
    return data, report


def purge_trash(data, now=None):
    """Drops what was deleted more than TRASH_DAYS ago. Returns the ids whose keyring passwords go too."""
    now = now if now is not None else now_ms()
    cutoff = now - TRASH_DAYS * DAY_MS
    gone = [t["connection"]["id"] for t in data.get("trash", [])
            if t.get("deleted", 0) < cutoff and (t.get("connection") or {}).get("id")]
    data["trash"] = [t for t in data.get("trash", []) if t.get("deleted", 0) >= cutoff]
    data["deleted"] = {k: v for k, v in (data.get("deleted") or {}).items() if v >= cutoff}
    return gone


def system_name(raw=None):
    """This system's name in the sync folder: the one set, else the host name."""
    name = ((raw or {}).get("ui") or {}).get("sync", {}).get("system") or ""
    if not name:
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            name = os.uname().nodename
    return re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.") or "omarchy"


def write_json_atomic(path, data):
    """Written whole, then renamed into place: a syncing client never picks up half a file."""
    tmp = os.path.join(os.path.dirname(path) or ".", "." + os.path.basename(path) + ".tmp")
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, ensure_ascii=False)
        f.write("\n")
    os.replace(tmp, path)


def _same_content(a, b):
    strip = lambda d: {k: v for k, v in d.items() if k != "written"}
    return strip(a) == strip(b)


def sync_folder(path=CONNECTIONS, now=None, allow_deletions=()):
    """One sync round: refreshes this system's file in the folder, merges everyone else's.
    Returns {"data", "report", "purged", "system", "folder"} for the UI to apply."""
    now = now if now is not None else now_ms()
    raw = load_raw(path)
    settings = (raw.get("ui") or {}).get("sync") or {}
    folder = os.path.expanduser((settings.get("folder") or "").strip())
    if not folder:
        raise ValueError("no sync folder set")
    if not os.path.isdir(folder):
        raise ValueError(f"the sync folder does not exist: {folder}")
    system = system_name(raw)
    data = {k: raw.get(k) for k in ("connections", "groups", "trash", "deleted") if raw.get(k) is not None}
    purged = purge_trash(data, now)
    mine = portable(data, system, "sync", now)
    own = os.path.join(folder, system + SYNC_SUFFIX)
    try:
        with open(own, encoding="utf-8") as f:
            unchanged = _same_content(json.load(f), mine)
    except (OSError, ValueError):
        unchanged = False
    if not unchanged:
        write_json_atomic(own, mine)
    incoming, errors = [], []
    for name in sorted(os.listdir(folder)):
        if not name.endswith(SYNC_SUFFIX) or name == system + SYNC_SUFFIX or name.startswith("."):
            continue
        try:
            with open(os.path.join(folder, name), encoding="utf-8") as f:
                other = json.load(f)
            other["_path"] = name
            incoming.append(other)
        except (OSError, ValueError) as e:
            errors.append(f"{name}: {e}")
    merged, report = merge(data, incoming, now, allow_deletions)
    report["errors"] = errors + report["errors"]
    return {"data": merged, "report": report, "purged": purged, "system": system, "folder": folder}


def watch_folder(folder, out=sys.stdout, wait=30.0, stop=None):
    """Prints the name of every *.omaremote.json that arrives or changes in the sync folder, one per
    line, until stopped: what lets the window sync as soon as another system's file lands, instead
    of at the next interval. inotify through libc, no extra package. Temporary files (written, then
    renamed into place by Nextcloud and by write_json_atomic) are skipped; the final rename counts.
    A folder that is not there yet (a share not mounted) is waited for, every `wait` seconds."""
    import ctypes
    import select
    import struct
    libc = ctypes.CDLL(None, use_errno=True)
    IN_CLOSE_WRITE, IN_MOVED_TO, IN_DELETE_SELF, IN_MOVE_SELF, IN_IGNORED = 0x8, 0x80, 0x400, 0x800, 0x8000
    folder = os.path.expanduser(folder)
    while not (stop and stop()):
        if not os.path.isdir(folder):
            time.sleep(wait)
            continue
        fd = libc.inotify_init1(os.O_CLOEXEC)
        if fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        try:
            wd = libc.inotify_add_watch(fd, os.fsencode(folder),
                                        IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE_SELF | IN_MOVE_SELF)
            if wd < 0:
                raise OSError(ctypes.get_errno(), f"cannot watch {folder}")
            gone = False
            while not gone and not (stop and stop()):
                ready, _, _ = select.select([fd], [], [], 1.0)
                if not ready:
                    continue
                data = os.read(fd, 65536)
                at = 0
                while at + 16 <= len(data):
                    _wd, mask, _cookie, size = struct.unpack_from("iIII", data, at)
                    name = data[at + 16:at + 16 + size].split(b"\0", 1)[0].decode(errors="replace")
                    at += 16 + size
                    if mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED):
                        gone = True  # the folder went (unmounted, moved): wait for it again
                    elif name.endswith(SYNC_SUFFIX) and not name.startswith("."):
                        print(name, file=out, flush=True)
        finally:
            os.close(fd)


def import_file(file_path, path=CONNECTIONS, now=None):
    """A manual import: adds and updates, never removes. Returns {"data", "report"}."""
    with open(os.path.expanduser(file_path), encoding="utf-8") as f:
        incoming = json.load(f)
    if isinstance(incoming, dict):
        incoming["deleted"] = {}
    raw = load_raw(path)
    data = {k: raw.get(k) for k in ("connections", "groups", "trash", "deleted") if raw.get(k) is not None}
    merged, report = merge(data, [incoming], now)
    return {"data": merged, "report": report}


def pick(mode, title="", current="", name=""):
    """The desktop's own file chooser (xdg-desktop-portal: Flea, GTK, …). mode: folder, open or save.
    Returns the chosen path, or "" when cancelled."""
    from urllib.parse import unquote, urlparse
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    token = "omaremote" + uuid.uuid4().hex[:8]
    sender = bus.get_unique_name()[1:].replace(".", "_")
    handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    chosen = []

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        code, results = params.unpack()
        uris = (results.get("uris") or []) if code == 0 else []
        chosen.extend(unquote(urlparse(u).path) for u in uris[:1])
        loop.quit()

    # Subscribed before the call, on the handle the token makes predictable: no response is missed.
    bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
                         handle, None, Gio.DBusSignalFlags.NONE, on_response)
    options = {"handle_token": GLib.Variant("s", token), "modal": GLib.Variant("b", True)}
    if mode == "folder":
        options["directory"] = GLib.Variant("b", True)
    elif mode == "key":
        pass  # any file: keys have no common extension
    else:
        options["filters"] = GLib.Variant("a(sa(us))", [("OMARemote connections", [(0, "*.json")]),
                                                         ("All files", [(0, "*")])])
    folder = os.path.expanduser(current or "")
    if folder and not os.path.isdir(folder):
        folder = os.path.dirname(folder)
    if folder and os.path.isdir(folder):
        options["current_folder"] = GLib.Variant("ay", os.fsencode(folder) + b"\0")
    if mode == "save" and name:
        options["current_name"] = GLib.Variant("s", name)
    method = "SaveFile" if mode == "save" else "OpenFile"
    bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                  "org.freedesktop.portal.FileChooser", method,
                  GLib.Variant("(ssa{sv})", ("", title or "OMARemote", options)), GLib.VariantType("(o)"),
                  Gio.DBusCallFlags.NONE, -1, None)
    loop.run()
    return chosen[0] if chosen else ""


def export_file(file_path, path=CONNECTIONS, now=None):
    raw = load_raw(path)
    out = portable(raw, system_name(raw), "export", now)
    target = os.path.expanduser(file_path)
    if os.path.isdir(target):
        target = os.path.join(target, "omaremote-connections.json")
    write_json_atomic(target, out)
    return {"file": target, "connections": len(out["connections"]), "groups": len(out["groups"])}


# ---------------------------------------------------------------- keyring

def _secret_attrs(conn_id, kind="connection"):
    return ["application", APP, kind, conn_id]


def _secret_lookup(attrs):
    try:
        out = subprocess.run(["secret-tool", "lookup", *attrs], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 and out.stdout else None


def secret_get(conn_id, kind="connection"):
    password = _secret_lookup(_secret_attrs(conn_id, kind))
    if password is None and kind == "connection":
        # Stored before the rename: move it under the new name, then drop the old entry.
        legacy = ["application", LEGACY_APP, "connection", conn_id]
        password = _secret_lookup(legacy)
        conn = find_connection(conn_id, load_connections())
        label = f"OMARemote password for {conn['name'] if conn else conn_id}"
        if password is not None and secret_set(conn_id, password, label):
            subprocess.run(["secret-tool", "clear", *legacy], capture_output=True, timeout=10)
    return password


def secret_set(conn_id, password, label, kind="connection"):
    out = subprocess.run(["secret-tool", "store", "--label", label, *_secret_attrs(conn_id, kind)],
                         input=password, text=True, capture_output=True, timeout=30)
    return out.returncode == 0


def secret_clear(conn_id, kind="connection"):
    subprocess.run(["secret-tool", "clear", *_secret_attrs(conn_id, kind)], capture_output=True, timeout=10)


# ---------------------------------------------------------------- scaling

RELEASES_API = "https://api.github.com/repos/RFdeGroot/OMARemote/releases"


def split_version(version):
    """'0.1.4-alpha' -> ([0, 1, 4], 'alpha'); a leading v is ignored."""
    text = str(version or "").strip().lstrip("v")
    core, _, tag = text.partition("-")
    numbers = [int(n) if n.isdigit() else 0 for n in core.split(".")] if core else []
    return numbers, tag


def compare_versions(a, b):
    """-1, 0 or 1. Numbers first; at equal numbers a pre-release (alpha < beta < rc) sorts before the release."""
    (na, ta), (nb, tb) = split_version(a), split_version(b)
    width = max(len(na), len(nb))
    na, nb = na + [0] * (width - len(na)), nb + [0] * (width - len(nb))
    if na != nb:
        return -1 if na < nb else 1
    if ta == tb:
        return 0
    if not ta or not tb:
        return 1 if not ta else -1
    return -1 if ta < tb else 1


def newest_release(releases, arch):
    """(version, package url) of the newest published release with a package for arch, or (None, None).
    GitHub lists releases newest first; drafts and releases without this machine's package are skipped."""
    pattern = re.compile(r"^omaremote-\d[^/]*-%s\.pkg\.tar\.zst$" % re.escape(arch))
    for release in releases or []:
        if release.get("draft"):
            continue
        for asset in release.get("assets") or []:
            if pattern.match(asset.get("name", "")):
                return release.get("tag_name", "").lstrip("v"), asset.get("browser_download_url")
    return None, None


PLUGIN_ID = "rfdegroot.omaremote"
PLUGIN_REPO = "https://github.com/RFdeGroot/omarchy-omaremote.git"
PLUGIN_RELEASES_API = "https://api.github.com/repos/RFdeGroot/omarchy-omaremote/releases"


def newest_tag(releases):
    """The version of the newest published (not draft) release, '' when there is none."""
    for release in releases or []:
        if not release.get("draft") and release.get("tag_name"):
            return release["tag_name"].lstrip("v")
    return ""


def plugin_check(offline=False, plugins_dir=None, latest=""):
    """The bar plugin as the sidebar footer needs it. Omarchy's plugin add/update follow the plugin's
    main branch, which only moves at a release, so a newer release means an update is waiting."""
    import shutil
    plugins_dir = plugins_dir or os.path.expanduser("~/.config/omarchy/plugins")
    folder = os.path.join(plugins_dir, PLUGIN_ID)
    result = {"supported": bool(shutil.which("omarchy-plugin-add")), "installed": False,
              "version": "", "git": os.path.isdir(os.path.join(folder, ".git")), "latest": latest, "newer": False}
    try:
        with open(os.path.join(folder, "manifest.json"), encoding="utf-8") as f:
            result["version"] = str(json.load(f).get("version") or "")
        result["installed"] = True
    except (OSError, ValueError):
        pass
    if offline or not result["supported"]:
        result["newer"] = (result["installed"] and result["git"] and bool(latest)
                           and compare_versions(latest, result["version"]) > 0)
        return result
    import urllib.request
    try:
        request = urllib.request.Request(PLUGIN_RELEASES_API, headers={"Accept": "application/vnd.github+json",
                                                                       "User-Agent": "omaremote"})
        with urllib.request.urlopen(request, timeout=8) as response:
            result["latest"] = newest_tag(json.load(response))
    except (OSError, ValueError):
        return result
    result["newer"] = (result["installed"] and result["git"] and bool(result["latest"])
                       and compare_versions(result["latest"], result["version"]) > 0)
    return result


def update_check(current):
    """What the update button needs: the newest release for this machine and whether it beats current."""
    import platform
    import urllib.request
    request = urllib.request.Request(RELEASES_API, headers={"Accept": "application/vnd.github+json",
                                                            "User-Agent": "omaremote/" + current})
    with urllib.request.urlopen(request, timeout=8) as response:
        releases = json.load(response)
    latest, url = newest_release(releases, platform.machine())
    return {"current": current, "latest": latest or "", "url": url or "",
            "newer": bool(latest) and compare_versions(latest, current) > 0}


def set_view(sid, view, viewer=None):
    """Records where a session is shown; False when there is no such session."""
    try:
        with open(_session_path(sid), encoding="utf-8") as f:
            state = json.load(f)
    except (OSError, ValueError):
        return False
    state["view"] = view
    state["viewer"] = int(viewer) if view == "window" and viewer else None
    write_session(state, keep=())
    return True


def toggle_fullscreen():
    """Fullscreen on or off for the focused window (hl.dsp first, as for focus_window)."""
    new = subprocess.run(["hyprctl", "dispatch", 'hl.dsp.window.fullscreen({ mode = "fullscreen" })'],
                         capture_output=True, text=True)
    if new.returncode == 0 and "error" not in new.stdout.lower():
        return
    subprocess.run(["hyprctl", "dispatch", "fullscreen", "0"], capture_output=True)


def _hyprctl_json(*args):
    try:
        return json.loads(subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True,
                                         timeout=5).stdout or "null")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def find_window(kind, value, wait=0.0):
    """The Hyprland client whose class is exactly value (or whose pid is), waiting up to wait seconds
    for it to appear (a window just started is not mapped yet)."""
    key = "pid" if kind == "pid" else "class"
    want = int(value) if key == "pid" and str(value).isdigit() else value
    deadline = time.time() + wait
    while True:
        window = next((c for c in _hyprctl_json("clients") or [] if c.get(key) == want), None)
        if window or time.time() >= deadline:
            return window
        time.sleep(0.1)


def hypr_dispatch(lua, *old):
    """Hyprland with a Lua config takes hl.dsp.*; older ones only the classic dispatcher (old)."""
    new = subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True)
    if new.returncode == 0 and "error" not in new.stdout.lower():
        return
    if old:
        subprocess.run(["hyprctl", "dispatch", *old], capture_output=True)


def focus_window(kind, value):
    """Brings the first window whose class is exactly value (or whose pid is) forward; True if found.
    Both dispatchers switch to the window's workspace."""
    window = find_window(kind, value)
    if not window:
        return False
    target = "address:" + window["address"]
    hypr_dispatch('hl.dsp.focus({ window = "%s" })' % target, "focuswindow", target)
    return True


def float_size(monitor, percent):
    """percent of a monitor in logical pixels (what Hyprland sizes windows in), rotation included."""
    scale = float(monitor.get("scale") or 1)
    width, height = monitor.get("width", 1920) / scale, monitor.get("height", 1080) / scale
    if monitor.get("transform", 0) % 2:
        width, height = height, width
    return int(width * percent / 100), int(height * percent / 100)


def float_window(pid, percent=90):
    """Floats a just-opened window at percent of its monitor, centred; True if the window showed up."""
    window = find_window("pid", pid, wait=5)
    if not window:
        return False
    monitor = next((m for m in _hyprctl_json("monitors") or [] if m.get("id") == window.get("monitor")), {})
    width, height = float_size(monitor, percent)
    target = "address:" + window["address"]
    if not window.get("floating"):
        hypr_dispatch('hl.dsp.window.float({ action = "enable", window = "%s" })' % target, "setfloating", target)
    hypr_dispatch('hl.dsp.window.resize({ x = %d, y = %d, window = "%s" })' % (width, height, target),
                  "resizewindowpixel", "exact %d %d,%s" % (width, height, target))
    hypr_dispatch('hl.dsp.window.center({ window = "%s" })' % target, "centerwindow")
    return True


def summon_window(pid):
    """Moves a window to the current workspace and focuses it; True if found."""
    window = find_window("pid", pid)
    if not window:
        return False
    workspace = (_hyprctl_json("activeworkspace") or {}).get("id")
    target = "address:" + window["address"]
    if workspace is not None and window.get("workspace", {}).get("id") != workspace:
        hypr_dispatch('hl.dsp.window.move({ workspace = "%s", follow = false, window = "%s" })' % (workspace, target),
                      "movetoworkspacesilent", "%s,%s" % (workspace, target))
    hypr_dispatch('hl.dsp.focus({ window = "%s" })' % target, "focuswindow", target)
    return True


def spawn_window(sid):
    """Opens omaremote window <sid>: a window of its own for a running session, on this workspace."""
    subprocess.Popen(["uwsm-app", "--", os.path.join(HERE, "omaremote"), "window", sid],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def open_window(name):
    """omaremote open --window: the connection in a floating window of its own on the current workspace.
    Running in a tab: it moves out (the manager hands it over). In a window already: that window comes
    here. Not running: it connects straight into a window, without the manager."""
    conn = find_connection(name, load_connections())
    want = conn["id"] if conn else name
    running = [s for s in list_sessions() if s.get("state") in ("connecting", "connected")
               and (s.get("connection") == want or s.get("id") == want)]
    if running:
        s = running[0]
        if not s.get("tab"):
            return 0 if summon_window(s.get("pid")) else 1
        if s.get("view") == "window" and s.get("viewer"):
            return 0 if summon_window(s["viewer"]) else 1
        manager = find_window("class", APP)
        if manager:
            subprocess.run(["qs", "ipc", "--pid", str(manager["pid"]), "call", APP, "popout", s["id"]],
                           capture_output=True, timeout=10)
        else:
            spawn_window(s["id"])
        return 0
    if not conn:
        print(f"unknown connection: {name}", file=sys.stderr)
        return 2
    scale = monitor_scale()
    monitor = next((m for m in _hyprctl_json("monitors") or [] if m.get("focused")), {})
    width, height = float_size(monitor, 90)
    size = f"{round(width * scale / 100)}x{round(height * scale / 100)}@{scale}"
    before = {s["id"] for s in list_sessions()}
    subprocess.Popen([os.path.abspath(__file__), "launch", conn["id"], "--tab", size],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    deadline = time.time() + 15
    while time.time() < deadline:
        new = [s for s in list_sessions() if s["id"] not in before and s.get("connection") == conn["id"]]
        if new:
            spawn_window(new[0]["id"])
            return 0
        time.sleep(0.1)
    print("the session did not start", file=sys.stderr)
    return 1


def monitor_scale():
    """The focused monitor's scale in percent, or 100 when Hyprland cannot answer."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        for m in json.loads(out.stdout):
            if m.get("focused"):
                return int(round(float(m.get("scale", 1)) * 100))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return 100


def device_scale(desktop):
    """RDP device scale only knows 100, 140 and 180; pick the nearest step."""
    return min((100, 140, 180), key=lambda step: abs(step - desktop))


def resolve_scale(setting, auto_scale):
    if str(setting) == "auto":
        value = auto_scale
    else:
        try:
            value = int(setting)
        except (TypeError, ValueError):
            value = auto_scale
    return max(100, min(500, value))


# ---------------------------------------------------------------- arguments

def build_args(conn, password=None, auto_scale=100, tab=None):
    """FreeRDP arguments for one connection, one argument per entry (fed to /args-from:stdin).

    tab is {"width", "height", "scale"} in device pixels when the session is drawn in a tab: the
    desktop then starts at the tab's size and the window-only options are left out.
    """
    c = dict(DEFAULTS, **conn)
    host = c["host"].strip()
    if not host:
        raise ValueError("connection has no host")
    port = int(c.get("port") or 3389)
    args = [f"/v:{host}" if port == 3389 else f"/v:{host}:{port}"]

    if c["username"]:
        args.append(f"/u:{c['username']}")
    if c["domain"]:
        args.append(f"/d:{c['domain']}")
    if password:
        args.append(f"/p:{password}")

    display = c["display"]
    if tab:
        if display == "fixed":
            args.append(f"/size:{int(c['width'])}x{int(c['height'])}")
        else:
            # Even width: the display-control channel refuses odd ones.
            args.append(f"/size:{int(tab['width']) & ~1}x{int(tab['height'])}")
            args.append("+dynamic-resolution")
        auto_scale = int(tab.get("scale") or auto_scale)
    else:
        args.append(f"/t:{c['name'] or host}")

    # Display. Every mode keeps resolution in step with the window except fixed.
    if tab:
        pass
    elif display == "fixed":
        args.append(f"/size:{int(c['width'])}x{int(c['height'])}")
        args.append("+smart-sizing")
    else:
        args.append("+dynamic-resolution")
        if display == "fullscreen":
            args.append("/f")
    if c["multimon"] and not tab:
        args.append("/multimon")

    scale = resolve_scale(c["scale"], auto_scale)
    if scale != 100:
        args.append(f"/scale-desktop:{scale}")
        args.append(f"/scale-device:{device_scale(scale)}")

    # Redirection.
    args.append("+clipboard" if c["clipboard"] else "-clipboard")
    if c["audio"] == "local":
        args.append("/sound")
    elif c["audio"] == "remote":
        args.append("/audio-mode:1")
    else:
        args.append("/audio-mode:2")
    if c["microphone"]:
        args.append("/microphone")
    if c["homeDrive"]:
        args.append("+home-drive")
    if c["grabKeyboard"]:
        args.append("+grab-keyboard")

    # Transport.
    if c["security"] in ("nla", "tls", "rdp"):
        args.append(f"/sec:{c['security']}")
    if c["ignoreCert"]:
        args.append("/cert:ignore")
    args.append(f"/network:{c['network'] if c['network'] in ('lan', 'broadband', 'modem') else 'auto'}")
    args.append("/gfx")
    args.append("+auto-reconnect")

    if c["gateway"].strip():
        gw = [f"g:{c['gateway'].strip()}"]
        user = c["gatewayUser"] or c["username"]
        domain = c["gatewayDomain"] or c["domain"]
        if user:
            gw.append(f"u:{user}")
        if domain:
            gw.append(f"d:{domain}")
        if password and not c["gatewayUser"]:
            gw.append(f"p:{password}")
        args.append("/gateway:" + ",".join(gw))

    if c["extraArgs"].strip():
        args.extend(shlex.split(c["extraArgs"]))
    return args


def build_vnc_config(conn, password=None):
    """Settings for omaremote-vnc, as key=value lines (fed on stdin)."""
    c = dict(DEFAULTS, **conn)
    host = c["host"].strip()
    if not host:
        raise ValueError("connection has no host")
    port = int(conn.get("port") or DEFAULT_PORTS["vnc"])
    lines = [f"host={host}", f"port={port}",
             f"scaling={c['vncScaling'] if c['vncScaling'] in ('fit', 'native', 'resize') else 'fit'}",
             f"quality={c['vncQuality'] if c['vncQuality'] in ('auto', 'high', 'low') else 'auto'}",
             f"viewOnly={1 if c['viewOnly'] else 0}"]
    if c["username"]:
        lines.append(f"username={c['username']}")
    if password:
        lines.append(f"password={password}")
    return lines


# The terminal's look: the theme's terminal colours (Omarchy writes a foot.ini for every theme) and
# the default terminal's font size; the font is fontconfig's monospace, which Omarchy sets.
THEME_TERMINAL = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                              "omarchy", "current", "theme", "foot.ini")
FONT_SIZE_RES = {
    "foot": (os.path.join(CONFIG_HOME, "foot", "foot.ini"), r"^\s*font\s*=.*?:size=([\d.]+)"),
    "alacritty": (os.path.join(CONFIG_HOME, "alacritty", "alacritty.toml"), r"^\s*size\s*=\s*([\d.]+)"),
    "ghostty": (os.path.join(CONFIG_HOME, "ghostty", "config"), r"^\s*font-size\s*=\s*([\d.]+)"),
    "kitty": (os.path.join(CONFIG_HOME, "kitty", "kitty.conf"), r"^\s*font_size\s+([\d.]+)"),
}


def default_terminal():
    """The default terminal's name (foot, alacritty, ghostty, kitty), as xdg-terminal-exec picks it."""
    try:
        out = subprocess.run(["xdg-terminal-exec", "--print-id"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    out = out.strip().lower()
    return next((name for name in FONT_SIZE_RES if name in out), "")


def terminal_font_size(terminal=None, fallback=9.0):
    """The point size the default terminal uses, read from its config; Omarchy's 9 otherwise."""
    order = [terminal if terminal is not None else default_terminal()] + list(FONT_SIZE_RES)
    for name in order:
        if name not in FONT_SIZE_RES:
            continue
        path, pattern = FONT_SIZE_RES[name]
        try:
            with open(path, encoding="utf-8") as f:
                m = re.search(pattern, f.read(), re.M)
        except OSError:
            continue
        if m:
            return float(m.group(1))
    return fallback


def build_ssh_command(conn):
    """The ssh command line. ~/.ssh/config still applies: the port and user go along only when set."""
    host = conn["host"].strip()
    if not host or host.startswith("-") or any(ch.isspace() for ch in host):
        raise ValueError(f"not a host name: {host!r}")
    args = ["ssh"]
    port = int(conn.get("port") or 22)
    if port != 22:
        args += ["-p", str(port)]
    user = (conn.get("username") or "").strip()
    if user:
        args += ["-l", user]
    # Also in ~/.ssh/omaremote.conf; passed here as well, so it holds even without that Include.
    key = (conn.get("sshKey") or "").strip()
    if key:
        args += ["-i", os.path.expanduser(key), "-o", "IdentitiesOnly=yes"]
    args += shlex.split(conn.get("sshArgs") or "")
    return args + [host]


# ---------------------------------------------------------------- ssh keys and ~/.ssh/omaremote.conf
#
# A key chosen for an SSH connection is passed to ssh by OMARemote. Only when the user allows it
# (Settings › SSH, off by default) does it also go into ~/.ssh/omaremote.conf, a file OMARemote owns
# and rewrites whole, so a plain `ssh host` in a terminal signs in the same way. ~/.ssh/config then
# gets one line, `Include omaremote.conf`, at the very top (an Include below a Host line would belong
# to that host), after a backup; the user's own entries are never touched, and turning the setting
# off takes that line out again. Users who keep their config to themselves add the Include by hand.

SSH_DIR = os.path.expanduser("~/.ssh")
SSH_MANAGED = "omaremote.conf"
SSH_INCLUDE = "Include " + SSH_MANAGED
SSH_INCLUDE_RE = re.compile(r"^\s*include\s+(~/\.ssh/)?omaremote\.conf\s*$", re.I | re.M)


def _tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def ssh_keys(ssh_dir=SSH_DIR):
    """Keys in ~/.ssh: private key files, and public keys alone (their private half lives in an agent
    such as 1Password; IdentityFile on the .pub makes ssh use the agent's matching key)."""
    try:
        names = sorted(os.listdir(ssh_dir))
    except OSError:
        return []
    out = []
    for name in names:
        path = os.path.join(ssh_dir, name)
        if not os.path.isfile(path) or name.startswith("."):
            continue
        if name.endswith(".pub"):
            if os.path.exists(path[:-4]):
                continue  # listed with its private key
            kind = "agent"
            pub = path
        else:
            try:
                with open(path, "rb") as f:
                    head = f.read(64)
            except OSError:
                continue
            if not (head.startswith(b"-----BEGIN") and b"PRIVATE KEY" in head):
                continue
            kind = "file"
            pub = path + ".pub"
        key_type, comment = "", ""
        try:
            with open(pub, encoding="utf-8") as f:
                parts = f.read().split(None, 2)
            if len(parts) >= 2 and parts[0].startswith(("ssh-", "ecdsa-", "sk-")):
                key_type = parts[0].replace("ssh-", "").replace("sk-", "security key ")
                comment = parts[2].strip() if len(parts) > 2 else ""
            elif kind == "agent":
                continue  # a .pub that is not a public key
        except OSError:
            pass
        out.append({"path": _tilde(path), "name": name, "kind": kind, "type": key_type, "comment": comment})
    return out


def ssh_managed_text(connections):
    """~/.ssh/omaremote.conf for the SSH connections that have a key; the first per host wins."""
    lines = ["# Written by OMARemote: the keys chosen for its SSH connections. It rewrites this file",
             "# whole, so edit the connections in OMARemote, not this file.", ""]
    seen = set()
    for c in connections:
        key = (c.get("sshKey") or "").strip()
        host = (c.get("host") or "").strip()
        if c.get("protocol") != "ssh" or not key or not host or host in seen or re.search(r"[\s#]", host):
            continue
        seen.add(host)
        lines.append(f"# {c.get('name') or host} (OMARemote connection {c.get('id', '?')})")
        lines.append(f"Host {host}")
        lines.append(f"    IdentityFile {key}")
        lines.append("    IdentitiesOnly yes")
        user = (c.get("username") or "").strip()
        if user and not re.search(r"\s", user):
            lines.append(f"    User {user}")
        try:
            port = int(c.get("port") or 22)
        except (TypeError, ValueError):
            port = 22
        if port != 22:
            lines.append(f"    Port {port}")
        lines.append("")
    return "\n".join(lines), len(seen)


SSH_MARKER = "# OMARemote's SSH keys (~/.ssh/omaremote.conf); first, so it applies to every host."


def _write_private(path, text, like=None):
    """Written whole and renamed into place, readable by the user only (or as `like` was)."""
    tmp = path + ".omaremote.tmp"
    with open(os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        f.write(text)
    if like and os.path.exists(like):
        os.chmod(tmp, os.stat(like).st_mode & 0o777)
    os.replace(tmp, path)


def ssh_config_sync(path=CONNECTIONS, ssh_dir=SSH_DIR):
    """Keeps ssh's own config in step with the keys chosen in OMARemote, as far as the user allows.

    Settings › SSH › "keys in the terminal too" (ui.sshTerminalKeys, off by default):
      on   ~/.ssh/omaremote.conf is written, and ~/.ssh/config gets OMARemote's Include at the top
           (backed up first) unless it includes the file already.
      off  OMARemote's own Include, recognised by its comment, comes out again with the file. An
           Include the user added by hand stays theirs: then only omaremote.conf is kept current.
    Returns {"mode": "auto" | "manual" | "off", "keys", "changed"}."""
    raw = load_raw(path)
    enabled = bool((raw.get("ui") or {}).get("sshTerminalKeys"))
    data = load_data(path)
    text, count = ssh_managed_text([resolve(c, data) for c in data["connections"]])
    managed = os.path.join(ssh_dir, SSH_MANAGED)
    config = os.path.join(ssh_dir, "config")
    try:
        with open(config, encoding="utf-8") as f:
            user_config = f.read()
    except FileNotFoundError:
        user_config = None
    ours = user_config is not None and SSH_MARKER in user_config
    included = user_config is not None and bool(SSH_INCLUDE_RE.search(user_config))
    changed = False

    if not enabled and ours:
        # Out again: the marker, the Include under it and the blank line after, nothing else.
        lines = user_config.split("\n")
        at = lines.index(SSH_MARKER)
        cut = 1
        if at + 1 < len(lines) and SSH_INCLUDE_RE.match(lines[at + 1]):
            cut = 2
            if at + 2 < len(lines) and lines[at + 2] == "":
                cut = 3
        _write_private(config, "\n".join(lines[:at] + lines[at + cut:]), like=config)
        user_config = "\n".join(lines[:at] + lines[at + cut:])
        included = bool(SSH_INCLUDE_RE.search(user_config))
        changed = True

    mode = "auto" if enabled else "manual" if included else "off"
    if mode == "off":
        if os.path.exists(managed):
            os.remove(managed)
            changed = True
        return {"mode": mode, "keys": count, "changed": changed}

    if count == 0 and not os.path.exists(managed) and mode == "auto":
        return {"mode": mode, "keys": 0, "changed": changed}  # nothing to write yet, config untouched
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    try:
        with open(managed, encoding="utf-8") as f:
            current = f.read()
    except OSError:
        current = None
    if current != text:
        _write_private(managed, text)
        changed = True
    if mode == "auto" and count > 0 and not included:
        if user_config is not None and not os.path.exists(config + ".omaremote-backup"):
            with open(os.open(config + ".omaremote-backup", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600),
                      "w", encoding="utf-8") as f:
                f.write(user_config)
        head = SSH_MARKER + "\n" + SSH_INCLUDE + "\n"
        _write_private(config, head + ("\n" + user_config if user_config else ""), like=config)
        changed = True
    return {"mode": mode, "keys": count, "changed": changed}

def build_ssh_config(conn):
    """Settings for omaremote-ssh, as key=value lines (fed on stdin)."""
    lines = [f"arg={a}" for a in build_ssh_command(conn)]
    lines += [f"host={conn['host'].strip()}", "font=monospace", f"fontSize={terminal_font_size():g}",
              f"theme={THEME_TERMINAL}"]
    return lines


def redact(args):
    out = []
    for a in args:
        if a.startswith("/p:"):
            out.append("/p:********")
        elif a.startswith("password="):
            out.append("password=********")
        elif a.startswith("/gateway:"):
            out.append("/gateway:" + re.sub(r"(^|,)p:[^,]*", r"\1p:********", a[len("/gateway:"):]))
        else:
            out.append(a)
    return out

STAGES = (
    ("verify_cb", "Checking certificate"),
    ("tls_config_check_certificate", "Checking certificate"),
    ("credssp_auth_init", "Signing in"),
    ("Credentials required", "Waiting for credentials"),
    ("rdp_client_connect_license", "Checking license"),
)
AUTH_RE = re.compile(r"Negotiated mechanism: (Kerberos|NTLM)")


def session_stage(line):
    """(stage, auth) a FreeRDP log line announces; either may be None."""
    m = AUTH_RE.search(line)
    if m:
        return "Signing in", m.group(1)
    for marker, stage in STAGES:
        if marker in line:
            return stage, None
    return None, None


SSH_FAILED_RE = re.compile(r"^\[omaremote\] connection failed: (.+)$", re.M)


def describe_exit(code, log_tail, protocol="rdp"):
    """A sentence for the UI, or None when the session simply ended."""
    if protocol == "ssh":
        # A shell ends with its last command's status; only ssh's own 255 means it could not connect.
        if code != 255:
            return None
        said = SSH_FAILED_RE.findall(log_tail or "")
        return said[-1].strip() if said and said[-1].strip() else "Could not connect to the server"
    if code is not None and code < 0:
        return None  # killed by a signal: stopped from the UI
    if code in EXIT_MESSAGES:
        message = EXIT_MESSAGES[code]
    elif code is not None and 32 <= code < 128:
        message = f"The server ended the connection (RDP error {code - 32})"
    else:
        message = f"FreeRDP exited with code {code}"
    if message is None:
        return None
    errors = ERROR_RE.findall(log_tail or "")
    if errors and errors[-1] == "ERRCONNECT_CONNECT_CANCELLED":
        return None  # a FreeRDP dialog was dismissed
    return f"{message} ({errors[-1]})" if errors else message


# ---------------------------------------------------------------- kerberos
#
# MIT Kerberos reads every KDC the realm publishes in DNS and tries them in order, one second
# per UDP timeout before it falls back to TCP. A domain with dozens of DCs behind a VPN that
# drops UDP makes a ticket take a minute or more, and FreeRDP needs two. Windows avoids this
# with site-aware DC location; here the KDCs are probed in parallel over TCP, the fastest few
# are cached, and FreeRDP gets a private krb5.conf naming only those, TCP only.

CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), APP)
KDC_CACHE_TTL = 6 * 3600
KDC_PROBE_TIMEOUT = 1.5
KDC_KEEP = 3


def kerberos_realm(conn):
    """The realm Kerberos will use: a dotted domain, else the host's DNS suffix. None for IPs and bare names."""
    domain = (conn.get("domain") or "").strip()
    if "." in domain:
        return domain.upper()
    host = (conn.get("host") or "").strip()
    if not host or "." not in host or re.fullmatch(r"[\d.]+|\[?[0-9a-fA-F:]+\]?", host):
        return None
    return host.split(".", 1)[1].upper()


def srv_records(name):
    """[(host, port)] for an SRV name, via resolvectl, dig or host, whichever answers first."""
    commands = [
        (["resolvectl", "query", "-t", "SRV", "--legend=no", name],
         re.compile(r"IN SRV \d+ \d+ (\d+) (\S+?)\.?(?:\s|$)"), (1, 0)),
        (["dig", "+short", "SRV", name], re.compile(r"^\d+ \d+ (\d+) (\S+?)\.?$", re.M), (1, 0)),
        (["host", "-t", "SRV", name], re.compile(r"has SRV record \d+ \d+ (\d+) (\S+?)\.?$", re.M), (1, 0)),
    ]
    for cmd, pattern, _order in commands:
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            continue
        found = [(m.group(2), int(m.group(1))) for m in pattern.finditer(out.stdout)]
        if found:
            return found
    return []


def probe_kdcs(targets, timeout=KDC_PROBE_TIMEOUT):
    """[(latency, host, port)] of the targets accepting a TCP connection, fastest first."""
    import socket
    from concurrent.futures import ThreadPoolExecutor

    def probe(target):
        host, port = target
        start = time.monotonic()
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return (time.monotonic() - start, host, port)
        except OSError:
            return None

    if not targets:
        return []
    with ThreadPoolExecutor(max_workers=min(32, len(targets))) as pool:
        results = [r for r in pool.map(probe, targets) if r]
    return sorted(results)


def discover_kdcs(realm, cache_dir=CACHE_DIR):
    """The fastest reachable KDCs of a realm as "host:port", cached; [] when there is nothing to improve on."""
    path = os.path.join(cache_dir, "kdc-" + realm.lower() + ".json")
    try:
        with open(path, encoding="utf-8") as f:
            cached = json.load(f)
        if time.time() - cached.get("probed", 0) < KDC_CACHE_TTL and cached.get("kdcs"):
            host, _, port = cached["kdcs"][0].rpartition(":")
            # Still answering? A changed network (VPN off, other site) re-probes.
            if probe_kdcs([(host, int(port))], timeout=0.5):
                return cached["kdcs"]
    except (OSError, ValueError, KeyError, IndexError):
        pass
    targets = srv_records(f"_kerberos._tcp.{realm}") or srv_records(f"_kerberos._udp.{realm}")
    # Dedupe; DNS lists the same DC for both transports.
    targets = list(dict.fromkeys(targets))
    kdcs = [f"{h}:{p}" for _, h, p in probe_kdcs(targets)[:KDC_KEEP]]
    if kdcs:
        os.makedirs(cache_dir, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"realm": realm, "probed": int(time.time()), "kdcs": kdcs, "candidates": len(targets)}, f)
    return kdcs


def krb5_config(realm, kdcs, host=""):
    """A krb5.conf fragment pinning a realm to the given KDCs over TCP."""
    lines = ["[libdefaults]", "\tudp_preference_limit = 1", "", "[realms]", f"\t{realm} = {{"]
    lines += [f"\t\tkdc = {k}" for k in kdcs]
    lines += ["\t}", ""]
    if "." in host:
        lines += ["[domain_realm]", f"\t.{host.split('.', 1)[1].lower()} = {realm}", ""]
    return "\n".join(lines)


def kerberos_domain(conn):
    """The domain to sign in with: a NetBIOS name ("acme") becomes the matching DNS domain
    ("acme.lan") when the host lives there, because Kerberos needs the DNS name as its realm and
    FreeRDP takes the realm from the domain. NTLM accepts either form."""
    domain = (conn.get("domain") or "").strip()
    realm = kerberos_realm(conn)
    if domain and "." not in domain and realm and realm.split(".")[0] == domain.upper():
        return realm.lower()
    return domain


def kerberos_env(conn, runtime_dir=RUNTIME_DIR, discover=discover_kdcs):
    """Environment for FreeRDP so Kerberos goes straight to reachable KDCs; {} when not applicable."""
    realm = kerberos_realm(conn)
    if not realm:
        return {}
    manual = [k.strip() for k in (conn.get("kdc") or "").split(",") if k.strip()]
    kdcs = manual or discover(realm)
    if not kdcs:
        return {}
    os.makedirs(runtime_dir, exist_ok=True)
    path = os.path.join(runtime_dir, "krb5-" + realm.lower() + ".conf")
    with open(path, "w", encoding="utf-8") as f:
        f.write(krb5_config(realm, kdcs, conn.get("host", "")))
    base = os.environ.get("KRB5_CONFIG") or "/etc/krb5.conf"
    return {"KRB5_CONFIG": path + ":" + base}


# ---------------------------------------------------------------- session state

def _session_path(sid):
    return os.path.join(SESSIONS_DIR, sid + ".json")


# Where a session is shown belongs to whoever shows it (set_view); the supervisor rewrites the rest
# of the record on every state change and must not put an old view back.
VIEW_KEYS = ("view", "viewer")


def write_session(state, keep=VIEW_KEYS):
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    try:
        with open(_session_path(state["id"]), encoding="utf-8") as f:
            current = json.load(f)
        for key in keep:
            if key in current:
                state[key] = current[key]
    except (OSError, ValueError):
        pass
    tmp = _session_path(state["id"]) + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(state, f)
    os.replace(tmp, _session_path(state["id"]))
    touch_changes()


def touch_changes():
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    fd = os.open(CHANGES, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        os.ftruncate(fd, 0)
        os.write(fd, str(time.time_ns()).encode())
    finally:
        os.close(fd)


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, TypeError):
        return False
    except PermissionError:
        return True


def ensure_changes():
    """Create the watch target without touching it, so a watcher can attach before any session."""
    os.makedirs(RUNTIME_DIR, exist_ok=True)
    os.close(os.open(CHANGES, os.O_WRONLY | os.O_CREAT, 0o600))


def list_sessions():
    sessions = []
    try:
        names = os.listdir(SESSIONS_DIR)
    except FileNotFoundError:
        return sessions
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(SESSIONS_DIR, name), encoding="utf-8") as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        if s.get("state") in ("connecting", "connected") and not _alive(s.get("supervisor")):
            s["state"] = "failed"
            s["error"] = s.get("error") or "The session supervisor disappeared"
        s.setdefault("view", "tab" if s.get("tab") else "window")
        s.setdefault("viewer", None)
        # An own window that is gone (closed or crashed) leaves its session for the manager's tabs.
        if s["view"] == "window" and s.get("tab") and not _alive(s.get("viewer")):
            s["view"], s["viewer"] = "tab", None
        sessions.append(s)
    sessions.sort(key=lambda s: s.get("started", 0), reverse=True)
    return prune(sessions)


KEEP_FINISHED = 3


def prune(sessions):
    """Keep the newest few finished sessions per connection; their logs are what a failure is read from."""
    kept, finished = [], {}
    for s in sessions:
        if s.get("state") in ("connecting", "connected"):
            kept.append(s)
            continue
        n = finished.get(s.get("connection"), 0)
        finished[s.get("connection")] = n + 1
        if n < KEEP_FINISHED:
            kept.append(s)
        else:
            for suffix in (".json", ".log", ".stop"):
                try:
                    os.remove(os.path.join(SESSIONS_DIR, s["id"] + suffix))
                except (FileNotFoundError, KeyError):
                    pass
    return kept


# ---------------------------------------------------------------- supervisor

def session_socket(sid):
    """Where a tab session listens; Unix socket paths are capped at 107 bytes."""
    path = os.path.join(SESSIONS_DIR, sid + ".sock")
    if len(path.encode()) < 100:
        return path
    short = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"omaremote-{sid}.sock")
    return short


def supervise(conn, sid, tab=None):
    """Runs detached: starts the session's client, follows its log, records state until it exits."""
    protocol = conn.get("protocol") or "rdp"
    if protocol in ("vnc", "ssh") and not tab:
        tab = {"width": 1280, "height": 800, "scale": 100}  # VNC and SSH sessions always live in a tab
    log_path = os.path.join(SESSIONS_DIR, sid + ".log")
    socket_path = session_socket(sid) if tab else None
    state = {
        "id": sid, "connection": conn["id"], "name": conn.get("name") or conn["host"],
        "host": conn["host"], "protocol": conn.get("protocol", "rdp"), "state": "connecting",
        "stage": "Finding domain controller", "auth": None,
        "started": int(time.time()), "ended": 0, "pid": 0, "supervisor": os.getpid(),
        "exitCode": None, "error": None, "log": log_path,
        "tab": bool(tab), "socket": socket_path,
        # tab: drawn in the manager's tab; window: drawn in an own window (viewer is its process),
        # or, for a session without a tab renderer, FreeRDP's own window.
        "view": "tab" if tab else "window", "viewer": None,
    }
    if protocol in ("vnc", "ssh"):
        state["stage"] = "Connecting"
    write_session(state)
    krb_env = {}
    if protocol == "rdp":
        try:
            krb_env = kerberos_env(conn)
        except Exception:  # discovery is an optimisation; FreeRDP still works without it
            pass
        conn = dict(conn, domain=kerberos_domain(conn))
    password = None
    if conn.get("savePassword") and conn.get("secretId"):
        password = secret_get(conn["secretId"], conn.get("secretKind", "connection"))
    if protocol == "vnc":
        args = build_vnc_config(conn, password=password)
    elif protocol == "ssh":
        args = build_ssh_config(conn)
    else:
        args = build_args(conn, password=password, auto_scale=monitor_scale(), tab=tab)
    env = dict(os.environ, SDL_APP_ID=SESSION_APP_ID, WLOG_LEVEL=os.environ.get("WLOG_LEVEL", "INFO"),
               **krb_env)
    # The stage markers below are DEBUG lines; raise only their tags, not the whole log.
    env.setdefault("WLOG_FILTER", "com.freerdp.core.nego:DEBUG,com.freerdp.core.auth:DEBUG,com.winpr.negotiate:DEBUG")
    state["stage"] = "Connecting"
    if tab:
        client = tab_client(protocol)
        if not client:
            state.update(state="failed", ended=int(time.time()),
                         error=f"The {protocol.upper()} renderer is not built: run ./install.sh"
                               + (" (or open in a window)" if protocol == "rdp" else ""))
            write_session(state)
            return 1
        command = [client]  # reads its arguments from stdin
        env["OMAREMOTE_SOCKET"] = socket_path
    else:
        command = [CLIENT, "/args-from:stdin"]
    try:
        # WLog writes INFO to stdout through stdio, which a pipe would block-buffer: line mode
        # is what lets the "connected" marker arrive when it happens.
        proc = subprocess.Popen(["stdbuf", "-oL", "-eL", *command], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env, text=True,
                                errors="replace")
    except OSError as e:
        state.update(state="failed", error=f"Could not start {command[0]}: {e}", ended=int(time.time()))
        write_session(state)
        return 1
    state["pid"] = proc.pid
    write_session(state)

    def forward(signum, _frame):
        proc.send_signal(signum)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)

    proc.stdin.write("\n".join(args) + "\n")
    proc.stdin.close()
    del password, args

    tail = []
    with open(log_path, "w", encoding="utf-8") as log:
        if krb_env:
            log.write(f"[omaremote] Kerberos: {krb_env['KRB5_CONFIG'].split(':')[0]}\n")
        for line in proc.stdout:
            log.write(line)
            log.flush()
            tail.append(line)
            del tail[:-60]
            if state["state"] != "connecting":
                continue
            # gdi_init_ex runs in post-connect: the session is up and drawing.
            # gdi_init_ex is FreeRDP's post-connect; omaremote-vnc and -ssh say so themselves.
            if "gdi_init_ex" in line or line.startswith("[omaremote] connected to"):
                state.update(state="connected", stage=None)
                write_session(state)
                mark_connected(conn["id"])
                continue
            stage, auth = session_stage(line)
            if (stage and stage != state["stage"]) or (auth and auth != state["auth"]):
                state["stage"] = stage or state["stage"]
                state["auth"] = auth or state["auth"]
                write_session(state)
    code = proc.wait()
    stopped = os.path.join(SESSIONS_DIR, sid + ".stop")
    error = None if os.path.exists(stopped) else describe_exit(code, "".join(tail), protocol)
    if os.path.exists(stopped):
        os.remove(stopped)
    state.update(state="failed" if error else "ended", exitCode=code, error=error, ended=int(time.time()))
    write_session(state)
    if error and os.environ.get("OMAREMOTE_NOTIFY", "1") == "1":
        subprocess.run(["notify-send", "-a", "OMARemote", "-u", "normal",
                        f"{state['name']}: connection failed", error], capture_output=True)
    return 0


def parse_tab(spec):
    """"2560x1500@160" -> {"width": 2560, "height": 1500, "scale": 160}."""
    m = re.fullmatch(r"(\d+)x(\d+)(?:@(\d+))?", spec or "")
    if not m:
        raise ValueError(f"bad --tab size {spec!r}, expected WxH@scale")
    return {"width": int(m.group(1)), "height": int(m.group(2)), "scale": int(m.group(3) or 100)}


def launch(key, tab=None):
    conn = find_connection(key, load_connections())
    if conn is None:
        print(f"no connection named or with id {key!r}", file=sys.stderr)
        return 2
    if not conn.get("host", "").strip():
        print("connection has no host", file=sys.stderr)
        return 2
    sid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    os.makedirs(SESSIONS_DIR, exist_ok=True)
    # Double fork: the supervisor belongs to no terminal and outlives the UI.
    child = os.fork()
    if child > 0:
        os.waitpid(child, 0)
        print(sid)
        return 0
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    try:
        os._exit(supervise(conn, sid, tab))
    except Exception as e:  # never leave a session stuck in "connecting"
        write_session({"id": sid, "connection": conn["id"], "name": conn.get("name", ""),
                       "host": conn.get("host", ""), "state": "failed", "error": str(e),
                       "started": int(time.time()), "ended": int(time.time())})
        os._exit(1)


def stop(sid):
    for s in list_sessions():
        if s["id"] == sid and s.get("state") in ("connecting", "connected"):
            pid = s.get("pid")
            if not pid:
                return 1
            # Tells the supervisor the exit that follows was asked for, not a failure.
            open(os.path.join(SESSIONS_DIR, sid + ".stop"), "w").close()
            try:
                os.kill(pid, signal.SIGTERM)
                # FreeRDP ignores SIGTERM while one of its own dialogs is open.
                for _ in range(30):
                    time.sleep(0.1)
                    if not _alive(pid):
                        return 0
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            return 0
    return 1


def forget(sid):
    for suffix in (".json", ".log", ".stop", ".sock"):
        try:
            os.remove(os.path.join(SESSIONS_DIR, sid + suffix))
        except FileNotFoundError:
            pass
    touch_changes()
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    migrate_legacy()
    cmd, rest = argv[1], argv[2:]
    if cmd in ("launch", "connect") and rest:
        tab = parse_tab(rest[rest.index("--tab") + 1]) if "--tab" in rest[1:-1] else None
        return launch(rest[0], tab)
    if cmd == "list":
        ensure_changes()
        print(json.dumps(list_sessions()))
        return 0
    if cmd == "stop" and rest:
        return stop(rest[0])
    if cmd == "forget" and rest:
        return forget(rest[0])
    if cmd == "args" and rest:
        conn = find_connection(rest[0], load_connections())
        if conn is None:
            return 2
        if conn.get("protocol") == "vnc":
            print("\n".join(redact(build_vnc_config(conn, "x" if conn["savePassword"] else None))))
            return 0
        if conn.get("protocol") == "ssh":
            print(" ".join(shlex.quote(a) for a in build_ssh_command(conn)))
            return 0
        print(" ".join(shlex.quote(a) for a in redact(build_args(conn, "x" if conn["savePassword"] else None,
                                                                    monitor_scale()))))
        return 0
    if cmd == "export" and rest:
        print(json.dumps(export_file(rest[0])))
        return 0
    if cmd == "import" and rest:
        try:
            print(json.dumps(import_file(rest[0])))
        except (OSError, ValueError) as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "sync":
        allow = rest[rest.index("--allow-deletions") + 1].split(",") if "--allow-deletions" in rest[:-1] else ()
        try:
            print(json.dumps(sync_folder(allow_deletions=allow)))
        except (OSError, ValueError) as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "pick" and rest and rest[0] in ("folder", "open", "save", "key"):
        opt = lambda flag: rest[rest.index(flag) + 1] if flag in rest[1:-1] else ""
        try:
            print(json.dumps({"path": pick(rest[0], opt("--title"), opt("--current"), opt("--name"))}))
        except Exception as e:  # no portal, no D-Bus, no python-gobject: the field still takes a typed path
            print(json.dumps({"error": f"no file chooser: {e}"}))
            return 1
        return 0
    if cmd == "ssh-keys":
        print(json.dumps(ssh_keys()))
        return 0
    if cmd == "ssh-config":
        try:
            print(json.dumps(ssh_config_sync()))
        except OSError as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "watch-folder" and rest:
        try:
            watch_folder(rest[0])
        except (OSError, KeyboardInterrupt, BrokenPipeError):
            return 1
        return 0
    if cmd == "system-name":
        print(system_name(load_raw()))
        return 0
    if cmd == "paths":
        ensure_changes()
        print(json.dumps({"runtime": RUNTIME_DIR, "changes": CHANGES, "connections": CONNECTIONS}))
        return 0
    if cmd == "view" and len(rest) in (2, 3) and rest[1] in ("tab", "window"):
        return 0 if set_view(rest[0], rest[1], rest[2] if len(rest) == 3 else None) else 1
    if cmd == "float" and len(rest) in (2, 3) and rest[0] == "pid":
        return 0 if float_window(rest[1], int(rest[2]) if len(rest) == 3 else 90) else 1
    if cmd == "summon" and len(rest) == 2 and rest[0] == "pid":
        return 0 if summon_window(rest[1]) else 1
    if cmd == "open-window" and rest:
        return open_window(" ".join(rest))
    if cmd == "fullscreen":
        toggle_fullscreen()
        return 0
    if cmd == "plugin-check":
        offline, latest, args = False, "", list(rest)
        while args:
            arg = args.pop(0)
            if arg == "--offline":
                offline = True
            elif arg == "--latest" and args:
                latest = args.pop(0)
            else:
                print(__doc__.strip(), file=sys.stderr)
                return 2
        print(json.dumps(plugin_check(offline=offline, latest=latest)))
        return 0
    if cmd == "update-check" and len(rest) == 1:
        try:
            print(json.dumps(update_check(rest[0])))
        except (OSError, ValueError) as e:
            print(f"update check failed: {e}", file=sys.stderr)
            return 1
        return 0
    if cmd == "focus" and len(rest) == 2 and rest[0] in ("class", "pid"):
        return 0 if focus_window(rest[0], rest[1]) else 1
    if cmd == "monitor-scale":
        print(monitor_scale())
        return 0
    if cmd == "secret" and len(rest) in (2, 3):
        # secret <set|clear|has> <connection-id>   or   secret <set|clear|has> credential <set-id>
        action, kind, key = (rest[0], "connection", rest[1]) if len(rest) == 2 else rest
        if kind not in ("connection", "credential"):
            return 2
        if action == "set":
            data = load_data()
            if kind == "credential":
                cred = find_credential(key, data)
                who = f"{cred.get('domain')}\\{cred.get('username')}" if cred and cred.get("domain") else (cred or {}).get("username", key)
                label = f"OMARemote password for {who}"
            else:
                conn = next((c for c in data["connections"] if c.get("id") == key), None)
                label = f"OMARemote password for {conn['name'] if conn else key}"
            return 0 if secret_set(key, sys.stdin.read().rstrip("\n"), label, kind) else 1
        if action == "clear":
            secret_clear(key, kind)
            return 0
        if action == "has":
            return 0 if secret_get(key, kind) else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
