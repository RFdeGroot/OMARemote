    "gliffScreen": "mirror",   # Gliff: mirror (the main screen, as Gliff's own client does) | private (one of its own)
    "gliffOutput": "",       # Gliff, mirror: the remote screen to show (DP-1); empty: the focused one
    "gliffColour": "auto",   # Gliff: auto | low (4:2:0, --low-bandwidth) | full (4:4:4 on a CPU server, --full-chroma)
    "gliffCapture": "auto",  # Gliff: auto | shm (frames read back, --capture shm: a VM whose screen stays black)
    "gliffVideo": "auto",    # Gliff: auto (VA-API when it works) | cpu (decode on the CPU here)
    "gliffServer": "",       # Gliff: gliff-server's path on the remote; empty: gliff-server on its PATH
    "favourite": False,
    "lastConnected": 0,
}

