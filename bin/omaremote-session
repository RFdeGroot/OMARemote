#!/usr/bin/env python3
"""omaremote session backend.

Owns everything the UI should not: the FreeRDP command line, the keyring, and
the lifetime of each session. A session is supervised by a detached process,
so closing the window never closes a remote desktop.

  omaremote-session launch <id|name> [--tab WxH@scale]
                                          start a session (returns at once); --tab runs it for a
                                          tab in the UI, sized in device pixels
  omaremote-session list                 running and recent sessions, JSON
  omaremote-session paths                runtime paths the UI watches, JSON
  omaremote-session stop <session-id>    disconnect a session
  omaremote-session forget <session-id>  drop a finished session from the list
  omaremote-session args <id|name>       the FreeRDP arguments, password redacted
  omaremote-session secret set|clear|has [credential] <id>   keyring password (set reads stdin)
  omaremote-session monitor-scale        the focused Hyprland monitor scale, in percent
  omaremote-session focus class|pid <v>  bring a window forward, switching workspace if needed
  omaremote-session update-check <ver>   the newest release on GitHub for this machine, JSON
  omaremote-session plugin-check [--offline] [--latest <ver>]   the Omarchy bar plugin: installed,
                                         newer release (--latest: compare with a release already known)
  omaremote-session view <id> tab|window [pid]   where a session is shown (window: its process)
  omaremote-session fullscreen           toggle fullscreen for the focused window
  omaremote-session float pid <pid> [%]  float a window at % (90) of its monitor, centred
  omaremote-session summon pid <pid>     move a window to the current workspace and focus it
  omaremote-session open-window <name>   a connection in a floating window of its own, here
  omaremote-session export <file|folder> connections and groups to a file (no user names or passwords)
  omaremote-session import <file>        merge an export: prints the result for the UI, JSON
  omaremote-session sync [--allow-deletions <system,…>]   one round of folder sync, JSON for the UI
  omaremote-session system-name          this system's name in the sync folder
  omaremote-session watch-folder <dir>   print each *.omaremote.json that arrives or changes there
  omaremote-session ssh-keys             keys in ~/.ssh (files, and agent keys by their .pub), JSON
  omaremote-session ssh-config           write ~/.ssh/omaremote.conf for SSH connections with a key
  omaremote-session pick folder|open|save [--title T] [--current PATH] [--name NAME]
                                         the desktop's file chooser (portal); prints {"path"}, "" if cancelled
"""

import json
import os
import re
import shlex
import signal
import subprocess
import sys
import time
import uuid

APP = "omaremote"
CLIENT = os.environ.get("OMAREMOTE_FREERDP", "sdl-freerdp3")
HERE = os.path.dirname(os.path.realpath(__file__))


def tab_client(protocol="rdp"):
    """The session process for tabs (omaremote-rdp, -vnc, -ssh): a checkout's build, else the installed one."""
    name = f"omaremote-{protocol}"
    for path in (os.environ.get("OMAREMOTE_" + protocol.upper()),
                 os.path.join(HERE, "..", "native", "build", name),
                 f"/usr/lib/omaremote/{name}"):
        if path and os.access(path, os.X_OK):
            return os.path.realpath(path)
    return None
SESSION_APP_ID = "omaremote-session"
CONFIG_HOME = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
CONFIG_DIR = os.path.join(CONFIG_HOME, APP)
CONNECTIONS = os.path.join(CONFIG_DIR, "connections.json")
RUNTIME_DIR = os.environ.get("OMAREMOTE_RUNTIME_DIR") or os.path.join(
    os.environ.get("XDG_RUNTIME_DIR") or f"/tmp/{APP}-{os.getuid()}", APP)
SESSIONS_DIR = os.path.join(RUNTIME_DIR, "sessions")
# Rewritten in place (never replaced) on every state change, so the UI's inotify watch survives.
CHANGES = os.path.join(RUNTIME_DIR, "changes")

DEFAULTS = {
    "protocol": "rdp",
    "name": "",
    "group": "",
    "host": "",
    "port": 3389,
    "username": "",
    "domain": "",
    "savePassword": False,
    "display": "fit",        # fit | fixed | fullscreen
    "width": 1920,
    "height": 1080,
    "scale": "auto",         # auto | 100..500
    "multimon": False,
    "clipboard": True,
    "audio": "local",        # local | remote | off
    "microphone": False,
    "homeDrive": False,
    "grabKeyboard": False,
    "security": "auto",      # auto | nla | tls | rdp
    "ignoreCert": False,
    "network": "auto",       # auto | lan | broadband | modem
    "gateway": "",
    "gatewayUser": "",
    "gatewayDomain": "",
    "kdc": "",               # Kerberos KDCs, comma separated; empty discovers them
    "extraArgs": "",
    "openIn": "tab",         # tab | window (OMARemote's own window; RDP with all monitors: FreeRDP's)
    "vncScaling": "fit",     # fit | native | resize
    "vncQuality": "auto",    # auto | high | low
    "viewOnly": False,
    "sshArgs": "",           # SSH: extra ssh options, the connection's own (never a group's)
    "sshKey": "",            # SSH: the key to sign in with (~/.ssh/…); also written to ~/.ssh/omaremote.conf
    "favourite": False,
    "lastConnected": 0,
}

# sdl-freerdp3 exit codes (client/SDL/SDL3/sdl_utils.hpp) worth a sentence of their own.
