ERROR_RE = re.compile(r"\b(ERRCONNECT_[A-Z_]+|ERRINFO_[A-Z_]+)\b")


# ---------------------------------------------------------------- store

LEGACY_APP = "oma-remote"  # the name before OMARemote


def migrate_legacy():
    """Move config and cache from the old name once; the keyring moves per entry in secret_get."""
    for base in (os.path.dirname(CONFIG_DIR), os.path.dirname(CACHE_DIR)):
        old, new = os.path.join(base, LEGACY_APP), os.path.join(base, APP)
        if os.path.isdir(old) and not os.path.exists(new):
            try:
                os.rename(old, new)
            except OSError:
                pass


# Settings a group can set for its connections. A connection stores only what differs from what
# it inherits, so changing the group changes every connection that did not override it.
SETTING_KEYS = ("display", "width", "height", "scale", "multimon", "clipboard", "audio", "microphone",
                "homeDrive", "grabKeyboard", "security", "ignoreCert", "network", "gateway",
                "gatewayUser", "gatewayDomain", "kdc", "extraArgs", "openIn",
                "vncScaling", "vncQuality", "viewOnly")

DEFAULT_PORTS = {"rdp": 3389, "vnc": 5900, "ssh": 22, "gliff": 22}


def load_data(path=CONNECTIONS):
    """The saved file: {"connections": [...], "credentials": [...], "groups": {name: {...}}}."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    if isinstance(data, list):  # the very first format
        data = {"connections": data}
    return {
        "connections": [c for c in data.get("connections", []) if isinstance(c, dict)],
        "credentials": [c for c in data.get("credentials", []) if isinstance(c, dict) and c.get("id")],
        "groups": {k: v for k, v in (data.get("groups") or {}).items() if isinstance(v, dict)},
        # Quick connections (a host typed in the search field): this system's only, never synced
        # or exported, kept until saved as a connection or pushed out by newer ones.
        "quick": [c for c in data.get("quick", []) if isinstance(c, dict) and c.get("id")],
    }


def find_credential(cred_id, data):
    return next((c for c in data["credentials"] if c.get("id") == cred_id), None)


def resolve(conn, data):
    """The connection as it will be used: defaults, then its group's settings, then its own.

    Credentials come from one of three places, recorded in credentialSource:
      "custom"  the connection's own username/domain, password under the connection's id;
      "set"     a shared credential set (credential = its id), password under the set's id;
      "group"   credential = "inherit": the group's credential set, if it has one.
    secretKind/secretId say where the password lives in the keyring.
    """
    group = data["groups"].get(conn.get("group") or "", {})
    out = dict(DEFAULTS)
    out.update({k: v for k, v in (group.get("settings") or {}).items() if k in SETTING_KEYS})
    out.update(conn)
    if not conn.get("port"):
        out["port"] = DEFAULT_PORTS.get(out.get("protocol") or "rdp", 3389)

    mode = conn.get("credential") or "custom"
    cred_id = group.get("credential") if mode == "inherit" else (None if mode == "custom" else mode)
    if mode == "custom":
        out.update(credentialSource="custom", secretKind="connection", secretId=conn.get("id"))
    else:
        cred = find_credential(cred_id, data) if cred_id else None
        out.update(username=(cred or {}).get("username", ""), domain=(cred or {}).get("domain", ""),
                   savePassword=bool((cred or {}).get("savePassword")),
                   credentialSource="group" if mode == "inherit" else "set",
                   secretKind="credential", secretId=cred_id)
    return out


def load_connections(path=CONNECTIONS):
    """Every connection a session can be started for: the saved ones, then the quick ones."""
    data = load_data(path)
    return [resolve(c, data) for c in data["connections"] + data["quick"]]


def find_connection(key, connections):
    for c in connections:
        if c.get("id") == key:
            return c
    lowered = key.lower()
    for c in connections:
        if c.get("name", "").lower() == lowered:
            return c
    # By host last, as the window's open() does.
    for c in connections:
        if c.get("host", "").lower() == lowered:
            return c
    return None


LAST_CONNECTED_KEPT = 500


def mark_connected(conn_id, path=LAST_CONNECTED):
    """Stamp when a connection was last up, in a file of its own (the UI shows the newer of this and
    its own lastConnected). Rewritten in place under a lock, so the UI's watch on it keeps firing and
    two sessions coming up at once do not lose a stamp."""
    try:
        fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except OSError:
        return
    with os.fdopen(fd, "r+", encoding="utf-8") as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX)
            try:
                data = json.loads(f.read(1 << 20) or "{}")
            except ValueError:
                data = {}
            if not isinstance(data, dict):
                data = {}
            data = {k: v for k, v in data.items() if isinstance(k, str) and ID_RE.match(k) and type(v) is int}
            data[conn_id] = int(time.time())
            newest = sorted(data.items(), key=lambda kv: kv[1], reverse=True)[:LAST_CONNECTED_KEPT]
            f.seek(0)
            f.write(json.dumps(dict(newest)))
            f.truncate()
        except OSError:
            pass


# ---------------------------------------------------------------- export, import and sync
#
# Connections and groups travel between systems; who signs in does not. A manual export is one
# file; folder sync is one file per system in a folder something else keeps in step (Nextcloud,
# Syncthing, …): each system writes only its own file, so none overwrites another, and merges the
# rest. Per connection and group the newest change wins (`modified`, ms). Deletions travel as
# tombstones and land in the trash, never straight out; a file that would trash many at once is
# held back for the UI to confirm. The UI stays the only writer of connections.json: the commands
# below print what to apply.

# Never leaves this machine (keep in step with localKeys in ui/Store.qml).
# "Ignore certificate" and the security level are local too: a sync file must never be able to turn
# off the server checks of a connection that signs in here.
LOCAL_KEYS = ("username", "domain", "credential", "savePassword", "gatewayUser", "gatewayDomain",
              "gatewaySavePassword", "extraArgs", "sshArgs", "sshKey", "lastConnected", "hotkey", "ignoreCert",
              "security", "gliffServer")
GROUP_LOCAL_SETTINGS = ("gatewayUser", "gatewayDomain", "extraArgs", "ignoreCert", "security")
# Where a connection signs in. A synced change to these, on a connection or group that signs in here
# with a saved password or a credential set, waits for the user: it would send those credentials to
# another server.
ADDRESS_KEYS = ("host", "port", "gateway", "kdc")
# What a connection hands the server it signs in to. A synced change that switches one on waits the
# same way: the next session would share the home folder (or the microphone) with that server.
SHARING_KEYS = (("homeDrive", "shares the home folder"), ("microphone", "with the microphone"),
                ("clipboard", "with the clipboard"))
# A change dated further ahead than this is not taken in: it would win over every edit made here.
SYNC_SKEW_MS = 24 * 3600 * 1000
SYNC_SUFFIX = ".omaremote.json"
TRASH_DAYS = 30
DAY_MS = 24 * 3600 * 1000


def now_ms():
    return int(time.time() * 1000)


def load_raw(path=CONNECTIONS):
    """connections.json as stored, every key kept."""
    try:
        with open(path, encoding="utf-8") as f:
            data = json.load(f)
    except FileNotFoundError:
        data = {}
    if isinstance(data, list):
        data = {"connections": data}
    return data


def portable_connection(conn):
    return {k: v for k, v in conn.items() if k not in LOCAL_KEYS}


def portable_group(group):
    settings = {k: v for k, v in (group.get("settings") or {}).items() if k not in GROUP_LOCAL_SETTINGS}
    return {"settings": settings, "modified": group.get("modified", 0)}


def portable(data, system, kind="sync", now=None):
    """What other systems read. A manual export carries no deletions: importing one never removes."""
    return {
        "format": "omaremote-" + kind, "version": 1, "system": system,
        "written": now if now is not None else now_ms(),
        "connections": [portable_connection(c) for c in data.get("connections", [])
                        if isinstance(c, dict) and c.get("id")],
        "groups": {name: portable_group(g) for name, g in (data.get("groups") or {}).items() if isinstance(g, dict)},
        "deleted": dict(data.get("deleted") or {}) if kind == "sync" else {},
        "deletedGroups": dict(data.get("deletedGroups") or {}) if kind == "sync" else {},
    }


def connection_key(conn):
    """The same server, whatever id each system gave it."""
    protocol = conn.get("protocol") or "rdp"
    try:
        port = int(conn.get("port") or DEFAULT_PORTS.get(protocol, 0))
    except (TypeError, ValueError):
        port = DEFAULT_PORTS.get(protocol, 0)
    return (protocol, (conn.get("host") or "").strip().lower(), port)


def _local_part(conn):
    return {k: v for k, v in conn.items() if k in LOCAL_KEYS}


def ids_of(conn):
    """A connection's id plus the ids other systems know it by (matched by host, see merge)."""
    return {conn.get("id")} | set(conn.get("aliases") or [])


def _with_aliases(new, *others):
    """new keeps its own id; every other id the same server goes by becomes an alias."""
    aliases = set()
    for c in others:
        aliases |= ids_of(c)
    aliases.discard(new.get("id"))
    aliases.discard(None)
    if aliases:
        new["aliases"] = sorted(aliases)
    return new


# Connection ids as OMARemote makes them (Store.newId: "c-" and base 36); others' ids look the same.
# Never a leading "-": ids go on command lines (omaremote open <id>, qs ipc … open <id>), where one
# would read as an option.
ID_RE = re.compile(r"^(?!-)[A-Za-z0-9_-]{1,64}$")

# The most characters a field takes: the same numbers as the UI's (ui/js/Limits.js; the test keeps
# them equal), for what arrives by import and sync rather than through a field. Where they come
# from: docs/limits.md.
LIMITS = {"name": 256, "host": 253, "address": 1024, "hostList": 2048, "user": 1024, "domain": 512,
          "password": 2048, "port": 5, "size": 5, "args": 4096, "path": 4096, "shortcut": 128,
          "standard": 256}
FIELD_LIMITS = {"name": "name", "group": "name", "host": "host", "gateway": "host", "port": "port",
                "username": "user", "gatewayUser": "user", "domain": "domain",
                "gatewayDomain": "domain", "kdc": "hostList", "sshArgs": "args", "extraArgs": "args",
                "sshKey": "path", "hotkey": "shortcut", "width": "size", "height": "size",
                "gliffOutput": "standard", "gliffServer": "path"}


def too_long(fields):
    """(key, limit) for the first field of a connection or group settings over its limit, else None.
    Counted as Qt counts maximumLength: in UTF-16 units."""
    for key, kind in FIELD_LIMITS.items():
        value = fields.get(key)
        if isinstance(value, (str, int, float)) and not isinstance(value, bool):
            if len(str(value).encode("utf-16-le")) // 2 > LIMITS[kind]:
                return key, LIMITS[kind]
    return None


_NUMBER = (int, float)


def odd_types(fields, connection=True):
    """The first key of a connection (or a group's settings) whose value is not of the kind
    OMARemote writes, else None: such a value would stop the merge or a session halfway."""
    if connection:
        if not isinstance(fields.get("id"), str) or not isinstance(fields.get("host"), str):
            return "id" if not isinstance(fields.get("id"), str) else "host"
        if not isinstance(fields.get("modified", 0), _NUMBER) or isinstance(fields.get("modified"), bool):
            return "modified"
        aliases = fields.get("aliases", [])
        if not isinstance(aliases, list) or any(not isinstance(a, str) for a in aliases):
            return "aliases"
    for key, value in fields.items():
        if key not in DEFAULTS or key == "scale":  # scale: "auto" or a number
            continue
        kind = DEFAULTS[key]
        if isinstance(kind, bool):
            ok = isinstance(value, bool) or value in (0, 1)
        elif isinstance(kind, int):
            # A port left empty is None or "": the protocol's own.
            ok = value is None or value == "" or (isinstance(value, int) and not isinstance(value, bool)) \
                or (isinstance(value, str) and value.isdigit())
        else:
            ok = isinstance(value, str)
        if not ok:
            return key
    return None


def _future(when, now):
    return isinstance(when, _NUMBER) and when > now + SYNC_SKEW_MS


def _drop_aliases(conn, ids):
    """conn without the aliases in ids (ids that belong to connections of their own)."""
    left = set(conn.get("aliases") or []) - set(ids)
    if left == set(conn.get("aliases") or []):
        return conn
    conn = dict(conn)
    if left:
        conn["aliases"] = sorted(left)
    else:
        conn.pop("aliases", None)
    return conn


def _address(conn, settings=None):
    """Where a connection (or a group's settings) points: host, port, gateway and KDC. The port as a
    session would use it: a new protocol without a port of its own moves to that protocol's port."""
    c = settings if settings is not None else conn
    out = [str(c.get(k) or "").strip().lower() for k in ADDRESS_KEYS]
    if out[0]:
        out[1] = str(connection_key(c)[2])
    return tuple(out)


def _shares(c, key):
    """Whether a connection (or a group's settings) shares this with the server; the clipboard is
    shared unless switched off."""
    return bool(c.get(key, DEFAULTS.get(key)))


def _describe_address(c, other=None):
    host = (c.get("host") or "").strip()
    port = c.get("port")
    out = host + (f":{port}" if host and port and int(port or 0) not in DEFAULT_PORTS.values() else "")
    for k, label in (("gateway", "gateway"), ("kdc", "KDC")):
        if (c.get(k) or "").strip():
            out += f" via {label} {c[k].strip()}" if out else f"{label} {c[k].strip()}"
    out = out or "(none)"
    # What is shared: the clipboard (on unless switched off) only where it differs from other.
    for k, label in SHARING_KEYS:
        if _shares(c, k) and (not DEFAULTS.get(k) or (other is not None and not _shares(other, k))):
            out += ", " + label
    return out


def _widens(theirs, mine):
    """Whether a synced change points elsewhere, or switches on sharing with the server."""
    return _address({}, theirs) != _address({}, mine) or any(_shares(theirs, k) and not _shares(mine, k)
                                                            for k, _ in SHARING_KEYS)


def _effective(conn, groups):
    """A connection's address and sharing as a session would use them: its group's settings, then
    its own (as resolve() does). A synced move into another group changes them without changing a
    field of the connection's own."""
    settings = (groups.get(conn.get("group") or "") or {}).get("settings") or {}
    return dict({k: v for k, v in settings.items() if k in SETTING_KEYS}, **conn)


def _signs_in_here(conn, groups):
    """Whether this system would send credentials to wherever the connection points: a saved
    password (the connection's or its gateway's), a credential set, its group's set, or a chosen
    SSH key (also written into ~/.ssh/omaremote.conf for that host)."""
    if conn.get("savePassword") or conn.get("gatewaySavePassword") or (conn.get("sshKey") or "").strip():
        return True
    mode = conn.get("credential") or "custom"
    if mode == "inherit":
        return bool((groups.get(conn.get("group") or "") or {}).get("credential"))
    return mode not in ("custom", "new")


def merge(local, incoming, now=None, allow_deletions=(), allow_address=()):
    """Merges other systems' files into connections.json's data. Returns (data, report).

    allow_deletions names systems whose mass deletion the user confirmed; allow_address the
    connection ids (and "group:<name>"s) whose new address the user accepted, or "*" for all (a
    file the user imported by hand)."""
    now = now if now is not None else now_ms()
    data = json.loads(json.dumps(local))
    conns = data.setdefault("connections", [])
    trash = data.setdefault("trash", [])
    deleted = data.setdefault("deleted", {})
    groups = data.setdefault("groups", {})
    gone_groups = data.setdefault("deletedGroups", {})
    report = {"added": [], "updated": [], "restored": [], "trashed": [], "pendingDeletions": [],
              "pendingAddress": [], "errors": []}
    address_ok = lambda key: allow_address == "*" or key in allow_address

    def held(old, ic, new):
        """Whether ic's change to old (here, or in the trash) waits for the user: it points elsewhere
        or shares more, compared as a session would use them (a move into another group, new here
        or with a gateway or sharing of its own, counts), and this system signs in there, before or
        after it (new: old's sign-in with ic's fields)."""
        was, will = _effective(old, groups_before), _effective(ic, groups)
        if not _widens(will, was) or address_ok(old["id"]) \
                or not (_signs_in_here(old, groups_before) or _signs_in_here(new, groups)):
            return False
        report["pendingAddress"].append({
            "system": system, "id": old["id"], "name": old.get("name") or old.get("host"),
            "from": _describe_address(was, will), "to": _describe_address(will, was)})
        return True

    def members(name):
        """A group's connections here, those in the trash too: a restore brings one back as the group
        has become by then (#11837 waited for the restore, not for the group's change before it)."""
        return [c for c in conns + [t.get("connection") or {} for t in trash] if (c.get("group") or "") == name]

    # An alias is another system's id for the same server; it can never be the id of a connection
    # of its own here. (Before 0.4.4 a duplicate, which keeps its original's host, was taken for the
    # original on other systems and recorded as its alias.)
    own = {c.get("id") for c in conns}
    conns[:] = [_drop_aliases(c, own - {c.get("id")}) for c in conns]

    for inc in incoming:
        if not isinstance(inc, dict) or inc.get("format") not in ("omaremote-sync", "omaremote-export"):
            report["errors"].append("not an OMARemote file: " + str((inc or {}).get("_path", "?")))
            continue
        system = plain(str(inc.get("system") or "another system"))[:64]
        version = inc.get("version") or 0
        if not isinstance(version, int) or isinstance(version, bool) or not all(
                isinstance(inc.get(k) or {}, dict) for k in ("groups", "deleted", "deletedGroups")) \
                or not isinstance(inc.get("connections") or [], list):
            report["errors"].append(f"{system}: not an OMARemote file of a kind this one reads")
            continue
        if version > 1:
            report["errors"].append(f"{system}: written by a newer OMARemote")
            continue
        # The groups as they were before this file: what a connection moved by it inherited until now.
        groups_before = json.loads(json.dumps(groups))

        for name, g in (inc.get("groups") or {}).items():
            if not isinstance(g, dict):
                continue
            if not isinstance(g.get("settings") or {}, dict) or not isinstance(g.get("modified", 0), _NUMBER) \
                    or isinstance(g.get("modified"), bool) or odd_types(g.get("settings") or {}, connection=False):
                report["errors"].append(f"{system}: skipped group {plain(str(name))[:40]!r}: a value of the wrong kind")
                continue
            if _future(g.get("modified", 0), now):
                report["errors"].append(f"{system}: skipped group {plain(str(name))[:40]!r}: dated in the future")
                continue
            over = too_long({"name": name, **(g.get("settings") or {})})
            if over:
                report["errors"].append(f"{system}: skipped group {plain(str(name))[:40]!r}: its {over[0]} is "
                                        f"longer than {over[1]} characters")
                continue
            mine = groups.get(name)
            if mine is not None and g.get("modified", 0) <= mine.get("modified", 0):
                continue
            if g.get("modified", 0) <= gone_groups.get(name, -1):
                continue  # deleted or renamed here after that change
            theirs_settings = {k: v for k, v in (g.get("settings") or {}).items() if k not in GROUP_LOCAL_SETTINGS}
            # The group's own set signs in through it, and so does every member that signs in here
            # (its gateway takes the member's saved password, or a saved gateway password).
            # A group new here is checked too: a connection here may already name it.
            signs_in = (mine or {}).get("credential") or any(_signs_in_here(c, groups) for c in members(name))
            if signs_in and not address_ok("group:" + name) \
                    and _widens(theirs_settings, (mine or {}).get("settings") or {}):
                report["pendingAddress"].append({
                    "system": system, "id": "group:" + name, "name": "group " + name,
                    "from": _describe_address((mine or {}).get("settings") or {}),
                    "to": _describe_address(theirs_settings)})
                continue
            mine = dict(mine or {})
            kept = {k: v for k, v in (mine.get("settings") or {}).items() if k in GROUP_LOCAL_SETTINGS}
            mine["settings"] = dict({k: v for k, v in (g.get("settings") or {}).items()
                                     if k not in GROUP_LOCAL_SETTINGS}, **kept)
            mine["modified"] = g.get("modified", 0)
            mine.setdefault("credential", "")
            groups[name] = mine

        # A group deleted or renamed there. Its connections moved out with newer changes of their
        # own, which travel like any other edit; only the group's settings go here. That waits like a
        # change when this system signs in through the group and its members would lose its gateway,
        # KDC or certificate checks (its local security level): they would then sign in another way.
        for name, when in (inc.get("deletedGroups") or {}).items():
            if not isinstance(when, _NUMBER) or _future(when, now):
                continue
            mine = groups.get(name)
            if mine is not None and when > mine.get("modified", 0):
                settings = mine.get("settings") or {}
                loosens = any(_address({}, settings)) or settings.get("security") in ("nla", "tls")
                signs_in = mine.get("credential") or any(_signs_in_here(c, groups) for c in members(name))
                if loosens and signs_in and not address_ok("group:" + name):
                    report["pendingAddress"].append({
                        "system": system, "id": "group:" + name, "name": "group " + name,
                        "from": _describe_address(settings), "to": "(group deleted)"})
                    continue
                del groups[name]
            gone_groups[name] = max(gone_groups.get(name, 0), when)

        listed = [ic for ic in inc.get("connections") or [] if isinstance(ic, dict) and ic.get("id")]
        # A value of another kind would stop this merge or a session; a change dated well ahead of
        # this system's clock would win over every edit made here.
        for ic in [ic for ic in listed if odd_types(ic)]:
            report["errors"].append(f"{system}: skipped connection {plain(str(ic.get('name') or ic.get('host')))[:40]!r}: "
                                    f"its {odd_types(ic)} is a value of the wrong kind")
            listed.remove(ic)
        listed = [ic for ic in listed if ic["host"].strip()]
        for ic in [ic for ic in listed if _future(ic.get("modified", 0), now)]:
            report["errors"].append(f"{system}: skipped connection {plain(str(ic.get('name') or ic['host']))[:40]!r}: "
                                    "dated in the future")
            listed.remove(ic)
        # Ids and hosts end up in commands and settings: a file that bends them is not taken in.
        odd = [ic for ic in listed if not ID_RE.match(str(ic["id"])) or not HOST_RE.match(ic["host"].strip())
               or any(not ID_RE.match(str(a)) for a in ic.get("aliases") or [])]
        if odd:
            report["errors"].append(f"{system}: skipped {len(odd)} connection(s) with an invalid id or host")
            listed = [ic for ic in listed if ic not in odd]
        # A field longer than the UI takes would be cut short when edited: not taken in either.
        for ic in [ic for ic in listed if too_long(ic)]:
            key, limit = too_long(ic)
            report["errors"].append(f"{system}: skipped connection {plain(str(ic.get('name') or ic['host']))[:40]!r}: "
                                    f"its {key} is longer than {limit} characters")
            listed.remove(ic)
        # Ids that are connections of their own in that file: never the same connection as another
        # one there, whatever host they share (a duplicate keeps its original's host).
        separate = {ic["id"] for ic in listed}
        conns[:] = [_drop_aliases(c, separate - {c.get("id")}) if c.get("id") in separate else c for c in conns]
        matched = set()
        for ic in listed:
            own = {c.get("id") for c in conns}
            # Its aliases, without ids that are separate connections there or here.
            ic = _drop_aliases(ic, (separate - {ic["id"]}) | ((own - {ic["id"]}) if ic["id"] in own else set()))
            changed = ic.get("modified", 0)
            theirs = ids_of(ic)
            if any(deleted.get(i, -1) >= changed for i in theirs):
                continue  # deleted here after that change
            key = connection_key(ic)
            # Its own id first, then an alias, then (only when exactly one connection here could be
            # it, and that one is not listed there itself) the same server under another id.
            by_host = [c for c in conns if connection_key(c) == key and c.get("id") not in separate
                       and c.get("id") not in matched]
            match = next((c for c in conns if c.get("id") == ic["id"]), None) \
                or next((c for c in conns if ids_of(c) & theirs), None) \
                or (by_host[0] if len(by_host) == 1 else None)
            if match is not None:
                matched.add(match.get("id"))
                # Compared as a session would use them: a move into another group (new here, or with
                # a gateway or sharing of its own) widens it as much as a change of its own fields.
                new = _with_aliases(dict(portable_connection(ic), **_local_part(match), id=match["id"]), match, ic)
                if changed > match.get("modified", 0) and held(match, ic, new):
                    continue
                if changed > match.get("modified", 0):
                    conns[conns.index(match)] = new
                    report["updated"].append(new.get("name") or new.get("host"))
                elif not theirs <= ids_of(match):
                    # The same server under another id: remember it, so its deletion finds this one.
                    conns[conns.index(match)] = _with_aliases(dict(match), match, ic)
                continue
            binned_by_host = [t for t in trash if connection_key(t.get("connection") or {}) == key
                              and (t.get("connection") or {}).get("id") not in separate]
            binned = next((t for t in trash if ids_of(t.get("connection") or {}) & theirs), None) \
                or (binned_by_host[0] if len(binned_by_host) == 1 else None)
            if binned is not None:
                if changed > binned.get("deleted", 0):
                    old = binned["connection"]
                    new = _with_aliases(dict(portable_connection(ic), **_local_part(old), id=old["id"]), old, ic)
                    # A restore keeps this system's sign-in: it waits like a change (#11837).
                    if held(old, ic, new):
                        continue
                    trash.remove(binned)
                    deleted.pop(old["id"], None)
                    conns.append(new)
                    report["restored"].append(new.get("name") or new.get("host"))
                continue
            new = portable_connection(ic)
            # Nothing of this system's signs a connection from elsewhere in: not its group's credential
            # set either, until the user picks it here (#11837; imports do the same).
            new["credential"] = "custom"
            conns.append(new)
            report["added"].append(new.get("name") or new.get("host"))

        doomed = []
        for cid, when in (inc.get("deleted") or {}).items():
            if not isinstance(when, _NUMBER) or _future(when, now):
                continue
            c = next((c for c in conns if c.get("id") == cid), None) \
                or next((c for c in conns if cid in ids_of(c)), None)
            if c is not None and when > c.get("modified", 0):
                doomed.append((c, when))
            elif c is None:
                deleted[cid] = max(deleted.get(cid, 0), when)  # passes the deletion on to others
        if doomed and len(doomed) > max(3, len(conns) // 4) and system not in allow_deletions:
            report["pendingDeletions"].append({"system": system, "ids": [c["id"] for c, _ in doomed],
                                               "names": [c.get("name") or c.get("host") for c, _ in doomed]})
            continue
        for c, when in doomed:
            conns.remove(c)
            trash.append({"connection": c, "deleted": when, "from": system})
            deleted[c["id"]] = max(deleted.get(c["id"], 0), when)
            report["trashed"].append(c.get("name") or c.get("host"))
    return data, report


def purge_trash(data, now=None):
    """Drops what was deleted more than TRASH_DAYS ago. Returns the ids whose keyring passwords go too."""
    now = now if now is not None else now_ms()
    cutoff = now - TRASH_DAYS * DAY_MS
    gone = [t["connection"]["id"] for t in data.get("trash", [])
            if t.get("deleted", 0) < cutoff and (t.get("connection") or {}).get("id")]
    data["trash"] = [t for t in data.get("trash", []) if t.get("deleted", 0) >= cutoff]
    data["deleted"] = {k: v for k, v in (data.get("deleted") or {}).items() if v >= cutoff}
    data["deletedGroups"] = {k: v for k, v in (data.get("deletedGroups") or {}).items() if v >= cutoff}
    return gone


def system_name(raw=None):
    """This system's name in the sync folder: the one set, else the host name."""
    name = ((raw or {}).get("ui") or {}).get("sync", {}).get("system") or ""
    if not name:
        try:
            with open("/etc/hostname", encoding="utf-8") as f:
                name = f.read().strip()
        except OSError:
            name = os.uname().nodename
    return re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.") or "omarchy"


def write_json_atomic(path, data):
    """Written whole, then renamed into place: a syncing client never picks up half a file. The
    temporary file gets a new random name (O_EXCL): others write the sync folder, and a fixed name
    planted there as a symlink would have this write any file of the user's."""
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".", prefix="." + os.path.basename(path) + ".",
                               suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
            f.write("\n")
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


# The largest sync or export file read: far above any real library, below running out of memory.
SYNC_MAX_BYTES = 16 << 20


def read_json_file(path, follow=True):
    """A JSON file others may have put there: only an ordinary file (a FIFO would never end, a
    device never stop), at most SYNC_MAX_BYTES; follow=False refuses a symlink too."""
    flags = os.O_RDONLY | os.O_NONBLOCK | os.O_CLOEXEC | (0 if follow else os.O_NOFOLLOW)
    try:
        fd = os.open(path, flags)
    except OSError as e:
        if e.errno == errno.ELOOP:
            raise ValueError("a symlink, not a file") from None
        raise
    with os.fdopen(fd, "rb") as f:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise ValueError("not an ordinary file")
        raw = f.read(SYNC_MAX_BYTES + 1)
    if len(raw) > SYNC_MAX_BYTES:
        raise ValueError("larger than 16 MiB")
    try:
        return json.loads(raw.decode("utf-8"))
    except UnicodeDecodeError as e:
        raise ValueError(str(e)) from None


def _same_content(a, b):
    strip = lambda d: {k: v for k, v in d.items() if k != "written"}
    return strip(a) == strip(b)


def sync_folder(path=CONNECTIONS, now=None, allow_deletions=(), allow_address=()):
    """One sync round: refreshes this system's file in the folder, merges everyone else's.
    Returns {"data", "report", "purged", "system", "folder"} for the UI to apply."""
    now = now if now is not None else now_ms()
    raw = load_raw(path)
    settings = (raw.get("ui") or {}).get("sync") or {}
    folder = os.path.expanduser((settings.get("folder") or "").strip())
    if not folder:
        raise ValueError("no sync folder set")
    if not os.path.isdir(folder):
        raise ValueError(f"the sync folder does not exist: {folder}")
    system = system_name(raw)
    data = {k: raw.get(k) for k in ("connections", "groups", "trash", "deleted", "deletedGroups") if raw.get(k) is not None}
    purged = purge_trash(data, now)
    mine = portable(data, system, "sync", now)
    own = os.path.join(folder, system + SYNC_SUFFIX)
    try:
        theirs = read_json_file(own, follow=False)
        unchanged = isinstance(theirs, dict) and _same_content(theirs, mine)
    except (OSError, ValueError):
        unchanged = False
    if not unchanged:
        write_json_atomic(own, mine)
    incoming, errors = [], []
    for name in sorted(os.listdir(folder)):
        if not name.endswith(SYNC_SUFFIX) or name == system + SYNC_SUFFIX or name.startswith("."):
            continue
        try:
            other = read_json_file(os.path.join(folder, name), follow=False)
            if not isinstance(other, dict):
                raise ValueError("not an OMARemote file")
            other["_path"] = name
            incoming.append(other)
        except (OSError, ValueError) as e:
            errors.append(f"{name}: {e}")
    merged, report = merge(data, incoming, now, allow_deletions, allow_address)
    report["errors"] = errors + report["errors"]
    return {"data": merged, "report": report, "purged": purged, "system": system, "folder": folder}


def watch_folder(folder, out=sys.stdout, wait=30.0, stop=None):
    """Prints the name of every *.omaremote.json that arrives or changes in the sync folder, one per
    line, until stopped: what lets the window sync as soon as another system's file lands, instead
    of at the next interval. inotify through libc, no extra package. Temporary files (written, then
    renamed into place by Nextcloud and by write_json_atomic) are skipped; the final rename counts.
    A folder that is not there yet (a share not mounted) is waited for, every `wait` seconds."""
    import ctypes
    import select
    import struct
    libc = ctypes.CDLL(None, use_errno=True)
    IN_CLOSE_WRITE, IN_MOVED_TO, IN_DELETE_SELF, IN_MOVE_SELF, IN_IGNORED = 0x8, 0x80, 0x400, 0x800, 0x8000
    folder = os.path.expanduser(folder)
    while not (stop and stop()):
        if not os.path.isdir(folder):
            time.sleep(wait)
            continue
        fd = libc.inotify_init1(os.O_CLOEXEC)
        if fd < 0:
            raise OSError(ctypes.get_errno(), "inotify_init1 failed")
        try:
            wd = libc.inotify_add_watch(fd, os.fsencode(folder),
                                        IN_CLOSE_WRITE | IN_MOVED_TO | IN_DELETE_SELF | IN_MOVE_SELF)
            if wd < 0:
                raise OSError(ctypes.get_errno(), f"cannot watch {folder}")
            gone = False
            while not gone and not (stop and stop()):
                ready, _, _ = select.select([fd], [], [], 1.0)
                if not ready:
                    continue
                data = os.read(fd, 65536)
                at = 0
                while at + 16 <= len(data):
                    _wd, mask, _cookie, size = struct.unpack_from("iIII", data, at)
                    name = data[at + 16:at + 16 + size].split(b"\0", 1)[0].decode(errors="replace")
                    at += 16 + size
                    if mask & (IN_DELETE_SELF | IN_MOVE_SELF | IN_IGNORED):
                        gone = True  # the folder went (unmounted, moved): wait for it again
                    elif name.endswith(SYNC_SUFFIX) and not name.startswith("."):
                        print(name, file=out, flush=True)
        finally:
            os.close(fd)


def import_file(file_path, path=CONNECTIONS, now=None):
    """A manual import: adds and updates, never removes. Returns {"data", "report"}."""
    incoming = read_json_file(os.path.expanduser(file_path))
    if isinstance(incoming, dict):
        incoming["deleted"] = {}
        incoming["deletedGroups"] = {}
    raw = load_raw(path)
    data = {k: raw.get(k) for k in ("connections", "groups", "trash", "deleted", "deletedGroups") if raw.get(k) is not None}
    # A file the user picked by hand: its addresses are what they asked for.
    merged, report = merge(data, [incoming], now, allow_address="*")
    return {"data": merged, "report": report}


def pick(mode, title="", current="", name=""):
    """The desktop's own file chooser (xdg-desktop-portal: Flea, GTK, …). mode: folder, open, save,
    key, import (several files: OMARemote's own and other clients') or 1remote (its database: any *.db, as 1Remote lets it be renamed).
    Returns the chosen paths, [] when cancelled."""
    from urllib.parse import unquote, urlparse
    from gi.repository import Gio, GLib
    bus = Gio.bus_get_sync(Gio.BusType.SESSION)
    token = "omaremote" + uuid.uuid4().hex[:8]
    sender = bus.get_unique_name()[1:].replace(".", "_")
    handle = f"/org/freedesktop/portal/desktop/request/{sender}/{token}"
    loop = GLib.MainLoop()
    chosen = []

    def on_response(_conn, _sender, _path, _iface, _signal, params):
        code, results = params.unpack()
        uris = (results.get("uris") or []) if code == 0 else []
        chosen.extend(unquote(urlparse(u).path) for u in (uris if mode == "import" else uris[:1]))
        loop.quit()

    # Subscribed before the call, on the handle the token makes predictable: no response is missed.
    bus.signal_subscribe("org.freedesktop.portal.Desktop", "org.freedesktop.portal.Request", "Response",
                         handle, None, Gio.DBusSignalFlags.NONE, on_response)
    options = {"handle_token": GLib.Variant("s", token), "modal": GLib.Variant("b", True)}
    if mode == "folder":
        options["directory"] = GLib.Variant("b", True)
    elif mode == "key":
        pass  # any file: keys have no common extension
    elif mode == "import":
        options["multiple"] = GLib.Variant("b", True)
        options["filters"] = GLib.Variant("a(sa(us))", [
            ("Connections (OMARemote, .rdp, Remmina, 1Remote)",
             [(0, "*.json"), (0, "*.rdp"), (0, "*.remmina"), (0, "*.db")]),
            ("All files", [(0, "*")])])
    elif mode == "1remote":
        options["filters"] = GLib.Variant("a(sa(us))", [("1Remote database (*.db)", [(0, "*.db")])])
    else:
        options["filters"] = GLib.Variant("a(sa(us))", [("OMARemote connections", [(0, "*.json")]),
                                                         ("All files", [(0, "*")])])
    folder = os.path.expanduser(current or "")
    if folder and not os.path.isdir(folder):
        folder = os.path.dirname(folder)
    if folder and os.path.isdir(folder):
        options["current_folder"] = GLib.Variant("ay", os.fsencode(folder) + b"\0")
    if mode == "save" and name:
        options["current_name"] = GLib.Variant("s", name)
    method = "SaveFile" if mode == "save" else "OpenFile"
    bus.call_sync("org.freedesktop.portal.Desktop", "/org/freedesktop/portal/desktop",
                  "org.freedesktop.portal.FileChooser", method,
                  GLib.Variant("(ssa{sv})", ("", title or "OMARemote", options)), GLib.VariantType("(o)"),
                  Gio.DBusCallFlags.NONE, -1, None)
    loop.run()
    return chosen


def export_file(file_path, path=CONNECTIONS, now=None):
    raw = load_raw(path)
    out = portable(raw, system_name(raw), "export", now)
    target = os.path.expanduser(file_path)
    if os.path.isdir(target):
        target = os.path.join(target, "omaremote-connections.json")
    write_json_atomic(target, out)
    return {"file": target, "connections": len(out["connections"]), "groups": len(out["groups"])}


# ---------------------------------------------------------------- keyring

def _secret_attrs(conn_id, kind="connection"):
    return ["application", APP, kind, conn_id]


def _secret_lookup(attrs):
    try:
        out = subprocess.run(["secret-tool", "lookup", *attrs], capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return out.stdout if out.returncode == 0 and out.stdout else None


def secret_get(conn_id, kind="connection"):
    password = _secret_lookup(_secret_attrs(conn_id, kind))
    if password is None and kind == "connection":
        # Stored before the rename: move it under the new name, then drop the old entry.
        legacy = ["application", LEGACY_APP, "connection", conn_id]
        password = _secret_lookup(legacy)
        if password is not None and secret_set(conn_id, password, secret_label(conn_id)):
            subprocess.run(["secret-tool", "clear", *legacy], capture_output=True, timeout=10)
    return password


def secret_label(conn_id, kind="connection"):
    """The keyring entry's label: OMARemote's opaque id, never a name, host or user (secret-tool
    takes the label on its command line, which other accounts can read)."""
    what = {"credential": "credential set", "gateway": "gateway of connection"}.get(kind, "connection")
    return f"OMARemote password ({what} {conn_id})"


def secret_set(conn_id, password, label, kind="connection"):
    out = subprocess.run(["secret-tool", "store", "--label", label, *_secret_attrs(conn_id, kind)],
                         input=password, text=True, capture_output=True, timeout=30)
    return out.returncode == 0


def secret_clear(conn_id, kind="connection"):
    subprocess.run(["secret-tool", "clear", *_secret_attrs(conn_id, kind)], capture_output=True, timeout=10)


# ---------------------------------------------------------------- scaling

RELEASES_API = "https://api.github.com/repos/RFdeGroot/OMARemote/releases"


def split_version(version):
    """'0.1.4-alpha' -> ([0, 1, 4], 'alpha'); a leading v is ignored."""
    text = str(version or "").strip().lstrip("v")
    core, _, tag = text.partition("-")
    numbers = [int(n) if n.isdigit() else 0 for n in core.split(".")] if core else []
    return numbers, tag


def compare_versions(a, b):
    """-1, 0 or 1. Numbers first; at equal numbers a pre-release (alpha < beta < rc) sorts before the release."""
    (na, ta), (nb, tb) = split_version(a), split_version(b)
    width = max(len(na), len(nb))
    na, nb = na + [0] * (width - len(na)), nb + [0] * (width - len(nb))
    if na != nb:
        return -1 if na < nb else 1
    if ta == tb:
        return 0
    if not ta or not tb:
        return 1 if not ta else -1
    return -1 if ta < tb else 1


def newest_release(releases, arch):
    """(version, package url) of the newest published release with a package for arch, or (None, None).
    GitHub lists releases newest first; drafts and releases without this machine's package are skipped."""
    pattern = re.compile(r"^omaremote-\d[^/]*-%s\.pkg\.tar\.zst$" % re.escape(arch))
    for release in releases or []:
        if release.get("draft"):
            continue
        for asset in release.get("assets") or []:
            if pattern.match(asset.get("name", "")):
                return release.get("tag_name", "").lstrip("v"), asset.get("browser_download_url")
    return None, None


PLUGIN_ID = "rfdegroot.omaremote"
PLUGIN_REPO = "https://github.com/RFdeGroot/omarchy-omaremote.git"
PLUGIN_RELEASES_API = "https://api.github.com/repos/RFdeGroot/omarchy-omaremote/releases"


def newest_tag(releases):
    """The version of the newest published (not draft) release, '' when there is none."""
    for release in releases or []:
        if not release.get("draft") and release.get("tag_name"):
            return release["tag_name"].lstrip("v")
    return ""


def plugin_check(offline=False, plugins_dir=None, latest=""):
    """The bar plugin as the sidebar footer needs it. Omarchy's plugin add/update follow the plugin's
    main branch, which only moves at a release, so a newer release means an update is waiting."""
    import shutil
    plugins_dir = plugins_dir or os.path.expanduser("~/.config/omarchy/plugins")
    folder = os.path.join(plugins_dir, PLUGIN_ID)
    result = {"supported": bool(shutil.which("omarchy-plugin-add")), "installed": False,
              "version": "", "git": os.path.isdir(os.path.join(folder, ".git")), "latest": latest, "newer": False}
    try:
        with open(os.path.join(folder, "manifest.json"), encoding="utf-8") as f:
            result["version"] = str(json.load(f).get("version") or "")
        result["installed"] = True
    except (OSError, ValueError):
        pass
    if offline or not result["supported"]:
        result["newer"] = (result["installed"] and result["git"] and bool(latest)
                           and compare_versions(latest, result["version"]) > 0)
        return result
    import urllib.request
    try:
        request = urllib.request.Request(PLUGIN_RELEASES_API, headers={"Accept": "application/vnd.github+json",
                                                                       "User-Agent": "omaremote"})
        with urllib.request.urlopen(request, timeout=8) as response:
            result["latest"] = newest_tag(json.load(response))
    except (OSError, ValueError):
        return result
    result["newer"] = (result["installed"] and result["git"] and bool(result["latest"])
                       and compare_versions(result["latest"], result["version"]) > 0)
    return result


def update_check(current):
    """What the update button needs: the newest release for this machine and whether it beats current."""
    import platform
    import urllib.request
    request = urllib.request.Request(RELEASES_API, headers={"Accept": "application/vnd.github+json",
                                                            "User-Agent": "omaremote/" + current})
    with urllib.request.urlopen(request, timeout=8) as response:
        releases = json.load(response)
    latest, url = newest_release(releases, platform.machine())
    return {"current": current, "latest": latest or "", "url": url or "",
            "newer": bool(latest) and compare_versions(latest, current) > 0}


def set_view(sid, view, viewer=None):
    """Records where a session is shown; False when there is no such session."""
    with _sessions_lock():
        try:
            with open(_session_path(sid), encoding="utf-8") as f:
                state = json.load(f)
        except (OSError, ValueError):
            return False
        if not isinstance(state, dict) or state.get("id") != sid:
            return False
        state["view"] = view
        state["viewer"] = int(viewer) if view == "window" and viewer else None
        _write_session_locked(state, keep=())
    touch_changes()
    return True


def toggle_fullscreen():
    """Fullscreen on or off for the focused window (hl.dsp first, as for focus_window)."""
    new = subprocess.run(["hyprctl", "dispatch", 'hl.dsp.window.fullscreen({ mode = "fullscreen" })'],
                         capture_output=True, text=True)
    if new.returncode == 0 and "error" not in new.stdout.lower():
        return
    subprocess.run(["hyprctl", "dispatch", "fullscreen", "0"], capture_output=True)


def _hyprctl_json(*args):
    try:
        return json.loads(subprocess.run(["hyprctl", *args, "-j"], capture_output=True, text=True,
                                         timeout=5).stdout or "null")
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None


def find_window(kind, value, wait=0.0):
    """The Hyprland client whose class is exactly value (or whose pid is), waiting up to wait seconds
    for it to appear (a window just started is not mapped yet)."""
    key = "pid" if kind == "pid" else "class"
    want = int(value) if key == "pid" and str(value).isdigit() else value
    deadline = time.time() + wait
    while True:
        window = next((c for c in _hyprctl_json("clients") or [] if c.get(key) == want), None)
        if window or time.time() >= deadline:
            return window
        time.sleep(0.1)


def hypr_dispatch(lua, *old):
    """Hyprland with a Lua config takes hl.dsp.*; older ones only the classic dispatcher (old)."""
    new = subprocess.run(["hyprctl", "dispatch", lua], capture_output=True, text=True)
    if new.returncode == 0 and "error" not in new.stdout.lower():
        return
    if old:
        subprocess.run(["hyprctl", "dispatch", *old], capture_output=True)


def focus_window(kind, value):
    """Brings the first window whose class is exactly value (or whose pid is) forward; True if found.
    Both dispatchers switch to the window's workspace."""
    window = find_window(kind, value)
    if not window:
        return False
    target = "address:" + window["address"]
    hypr_dispatch('hl.dsp.focus({ window = "%s" })' % target, "focuswindow", target)
    return True


def float_size(monitor, percent):
    """percent of a monitor in logical pixels (what Hyprland sizes windows in), rotation included."""
    scale = float(monitor.get("scale") or 1)
    width, height = monitor.get("width", 1920) / scale, monitor.get("height", 1080) / scale
    if monitor.get("transform", 0) % 2:
        width, height = height, width
    return int(width * percent / 100), int(height * percent / 100)


def float_window(pid, percent=90):
    """Floats a just-opened window at percent of its monitor, centred; True if the window showed up."""
    window = find_window("pid", pid, wait=5)
    if not window:
        return False
    monitor = next((m for m in _hyprctl_json("monitors") or [] if m.get("id") == window.get("monitor")), {})
    width, height = float_size(monitor, percent)
    target = "address:" + window["address"]
    if not window.get("floating"):
        hypr_dispatch('hl.dsp.window.float({ action = "enable", window = "%s" })' % target, "setfloating", target)
    hypr_dispatch('hl.dsp.window.resize({ x = %d, y = %d, window = "%s" })' % (width, height, target),
                  "resizewindowpixel", "exact %d %d,%s" % (width, height, target))
    hypr_dispatch('hl.dsp.window.center({ window = "%s" })' % target, "centerwindow")
    return True


def summon_window(pid):
    """Moves a window to the current workspace and focuses it; True if found."""
    window = find_window("pid", pid)
    if not window:
        return False
    workspace = (_hyprctl_json("activeworkspace") or {}).get("id")
    target = "address:" + window["address"]
    if workspace is not None and window.get("workspace", {}).get("id") != workspace:
        hypr_dispatch('hl.dsp.window.move({ workspace = "%s", follow = false, window = "%s" })' % (workspace, target),
                      "movetoworkspacesilent", "%s,%s" % (workspace, target))
    hypr_dispatch('hl.dsp.focus({ window = "%s" })' % target, "focuswindow", target)
    return True


def terminal_tag(pid, on):
    """Tags a window as a terminal for Hyprland while it shows an SSH session, and untags it after.
    Omarchy's universal clipboard keys read that tag (default/hypr/bindings/clipboard.lua): in a
    terminal Super+V sends Shift+Insert and Super+C Ctrl+Insert, elsewhere Ctrl+V and Ctrl+C, which a
    terminal reads as a literal character and an interrupt."""
    window = find_window("pid", pid, wait=5)  # a window just opened is not mapped yet
    if not window:
        return False
    target = "address:" + window["address"]
    tag = ("+" if on else "-") + "terminal"
    hypr_dispatch('hl.dsp.window.tag({ tag = "%s", window = "%s" })' % (tag, target), "tagwindow", f"{tag} {target}")
    return True


def spawn_window(sid):
    """Opens omaremote window <sid>: a window of its own for a running session, on this workspace."""
    subprocess.Popen(["uwsm-app", "--", os.path.join(HERE, "omaremote"), "window", sid],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)


def open_window(name):
    """omaremote open --window: the connection in a floating window of its own on the current workspace.
    Running in a tab: it moves out (the manager hands it over). In a window already: that window comes
    here. Not running: it connects straight into a window, without the manager."""
    conn = find_connection(name, load_connections())
    want = conn["id"] if conn else name
    running = [s for s in list_sessions() if s.get("state") in ("connecting", "connected")
               and (s.get("connection") == want or s.get("id") == want)]
    if running:
        s = running[0]
        # A hotkey window stays on its special workspace: shown there, not moved here.
        if is_hotkey(conn) and _session_window(s) is not None:
            return toggle(conn["id"], show_only=True)
        if not s.get("tab"):
            return 0 if summon_window(s.get("pid")) else 1
        if s.get("view") == "window" and s.get("viewer"):
            return 0 if summon_window(s["viewer"]) else 1
        manager = find_window("class", APP)
        if manager:
            subprocess.run(["qs", "ipc", "--pid", str(manager["pid"]), "call", APP, "popout", s["id"]],
                           capture_output=True, timeout=10)
        else:
            spawn_window(s["id"])
        return 0
    if not conn:
        print(f"unknown connection: {name}", file=sys.stderr)
        return 2
    scale = monitor_scale()
    monitor = next((m for m in _hyprctl_json("monitors") or [] if m.get("focused")), {})
    width, height = float_size(monitor, 90)
    size = f"{round(width * scale / 100)}x{round(height * scale / 100)}@{scale}"
    before = {s["id"] for s in list_sessions()}
    subprocess.Popen([os.path.abspath(__file__), "launch", conn["id"], "--tab", size],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    deadline = time.time() + 15
    while time.time() < deadline:
        new = [s for s in list_sessions() if s["id"] not in before and s.get("connection") == conn["id"]]
        if new:
            spawn_window(new[0]["id"])
            return 0
        time.sleep(0.1)
    print("the session did not start", file=sys.stderr)
    return 1


# ---------------------------------------------------------------- hotkey windows
#
# A hotkey window is an own window kept on a special workspace of its own (special:omaremote-<id>):
# one key slides it in on the monitor in use, focused; the same key, or ctrl+alt+h in it, hides it
# again, the session staying connected. Hyprland does the showing and hiding; the window floats at
# 90% of the monitor it shows on.

HOTKEY_LIMIT = 5


def special_name(conn_id):
    return "omaremote-" + re.sub(r"[^A-Za-z0-9_-]+", "-", conn_id or "")


def is_hotkey(conn):
    """Shown as a hotkey window: RDP and SSH (VNC opens in tabs, RDP on all monitors in FreeRDP's)."""
    return bool(conn) and conn.get("openIn") == "hotkey" and conn.get("protocol") != "vnc" \
        and not (conn.get("multimon") and (conn.get("protocol") or "rdp") == "rdp")


def special_shown(name, monitors=None):
    """(on the focused monitor, on any monitor) for special:name."""
    monitors = _hyprctl_json("monitors") if monitors is None else monitors
    full = "special:" + name
    shown = [m for m in monitors or [] if (m.get("specialWorkspace") or {}).get("name") == full]
    return any(m.get("focused") for m in shown), bool(shown)


def hotkey_action(window, name, active, monitors, show_only=False):
    """What a toggle does with a running hotkey window: "move" (not on its workspace yet, then
    shown), "hide" (shown and focused) or "show"."""
    if (window.get("workspace") or {}).get("name") != "special:" + name:
        return "move"
    here, _ = special_shown(name, monitors)
    focused = here and (active or {}).get("address") == window.get("address")
    return "hide" if focused and not show_only else "show"


def _toggle_special(name):
    hypr_dispatch('hl.dsp.workspace.toggle_special("%s")' % name, "togglespecialworkspace", name)


def show_hotkey(window, name):
    """Brings the special workspace up on the focused monitor and the window to the front, sized
    for that monitor."""
    here, _ = special_shown(name)
    if not here:
        _toggle_special(name)
    float_window(window["pid"])
    target = "address:" + window["address"]
    hypr_dispatch('hl.dsp.focus({ window = "%s" })' % target, "focuswindow", target)


def move_to_special(window, name):
    target = "address:" + window["address"]
    hypr_dispatch('hl.dsp.window.move({ workspace = "special:%s", follow = false, window = "%s" })' % (name, target),
                  "movetoworkspacesilent", "special:%s,%s" % (name, target))


def _session_window(s):
    """The Hyprland window a running session is shown in, or None (in a tab, or not mapped)."""
    if s.get("tab"):
        return find_window("pid", s["viewer"]) if s.get("view") == "window" and s.get("viewer") else None
    return find_window("pid", s.get("pid"))


def toggle(name, show_only=False):
    """omaremote toggle: a hotkey window shown (connecting first if it is not running) or hidden.
    A connection that is not a hotkey window opens as `open --window` would."""
    conn = find_connection(name, load_connections())
    if not conn or not is_hotkey(conn):
        return open_window(name)
    special = special_name(conn["id"])
    running = [s for s in list_sessions() if s.get("state") in ("connecting", "connected")
               and s.get("connection") == conn["id"]]
    if not running:
        return open_window(conn["id"])  # its window places itself (place), shown
    window = _session_window(running[0])
    if window is None:
        return open_window(conn["id"])  # in a tab: out into its window, which places itself
    action = hotkey_action(window, special, _hyprctl_json("activewindow"), _hyprctl_json("monitors"), show_only)
    if action == "hide":
        _toggle_special(special)
        return 0
    if action == "move":
        move_to_special(window, special)
    show_hotkey(window, special)
    return 0


def place_window(sid, pid):
    """A new own window (SessionWindow calls this): floats at 90%, centred; a hotkey window goes to
    its special workspace and shows there."""
    if not float_window(pid):
        return False
    try:
        with open(_session_path(sid), encoding="utf-8") as f:
            conn_id = json.load(f).get("connection")
    except (OSError, ValueError):
        return True
    conn = find_connection(conn_id or "", load_connections())
    if is_hotkey(conn):
        window = find_window("pid", pid)
        if window:
            move_to_special(window, special_name(conn["id"]))
            show_hotkey(window, special_name(conn["id"]))
    return True


def hide_window(sid):
    """ctrl+alt+h in a hotkey window: its special workspace closes."""
    try:
        with open(_session_path(sid), encoding="utf-8") as f:
            conn_id = json.load(f).get("connection")
    except (OSError, ValueError):
        return False
    conn = find_connection(conn_id or "", load_connections())
    if not is_hotkey(conn):
        return False
    here, _ = special_shown(special_name(conn["id"]))
    if here:
        _toggle_special(special_name(conn["id"]))
    return True


# Hyprland's modifier bits, as `hyprctl binds -j` reports them.
HYPR_MODS = {"SHIFT": 1, "CAPS": 2, "CTRL": 4, "CONTROL": 4, "ALT": 8, "MOD2": 16, "MOD3": 32,
             "SUPER": 64, "WIN": 64, "LOGO": 64, "MOD4": 64, "MOD5": 128}


def parse_hotkey(text):
    """"SUPER + ALT + W" -> (72, "W"); None when it is not a shortcut (no key, or an unknown modifier)."""
    parts = [p.strip() for p in (text or "").replace(",", "+").split("+") if p.strip()]
    if not parts:
        return None
    mask = 0
    for mod in parts[:-1]:
        if mod.upper() not in HYPR_MODS:
            return None
        mask |= HYPR_MODS[mod.upper()]
    key = parts[-1]
    if key.upper() in HYPR_MODS:
        return None
    return mask, key.upper()


def hypr_hotkeys(binds=None):
    """The shortcuts Hyprland binds now, but OMARemote's own: [{mask, key, description}]."""
    binds = _hyprctl_json("binds") if binds is None else binds
    out = []
    for b in binds or []:
        description = b.get("description") or b.get("arg") or b.get("dispatcher") or ""
        if description.startswith("OMARemote: ") or b.get("mouse") or b.get("submap"):
            continue
        out.append({"mask": b.get("modmask", 0), "key": str(b.get("key", "")).upper(), "description": description})
    return out


# The key that closes a window, as Omarchy binds it (o.bind("SUPER + W", "Close window", …)) or as
# a classic config does (killactive). Shown in OMARemote's hints; Hyprland does the closing itself.
CLOSE_DESCRIPTIONS = ("close window", "close active window", "killactive", "closewindow")


def close_key(binds=None):
    """"super+w", or whatever the user bound to closing a window instead; super+w when unsure."""
    binds = _hyprctl_json("binds") if binds is None else binds
    names = [(64, "super"), (4, "ctrl"), (8, "alt"), (1, "shift")]
    for b in binds or []:
        what = (b.get("description") or b.get("dispatcher") or "").strip().lower()
        if b.get("submap") or b.get("mouse") or what not in CLOSE_DESCRIPTIONS:
            continue
        mods = [n for bit, n in names if (b.get("modmask") or 0) & bit]
        return "+".join(mods + [str(b.get("key", "")).lower()])
    return "super+w"


HYPR_MARKER_BEGIN = "-- >>> omaremote >>>"
HYPR_MARKER_END = "-- <<< omaremote <<<"
HYPR_MANAGED = "omaremote.lua"


def hypr_managed_text(connections, launcher):
    """~/.config/hypr/omaremote.lua: one binding per hotkey window with a shortcut."""
    lines = ["-- Written by OMARemote: the shortcuts of its hotkey windows. It rewrites this file whole,",
             "-- so set them in OMARemote (a connection's Shortcut), not here.", ""]
    count = 0
    for c in connections:
        key = parse_hotkey(c.get("hotkey"))
        if not key or not is_hotkey(c):
            continue
        shortcut = " + ".join(p.strip().upper() for p in c["hotkey"].replace(",", "+").split("+") if p.strip())
        # No name: Hyprland's descriptions reach Omarchy's menus, and from there who knows where.
        label = "OMARemote: hotkey window"
        command = "%s toggle %s" % (shlex.quote(launcher), shlex.quote(c["id"]))
        lines.append("o.bind(%s, %s, %s)" % (json.dumps(shortcut), json.dumps(label, ensure_ascii=False),
                                             json.dumps(command)))
        count += 1
    return "\n".join(lines) + "\n", count


def hypr_hotkeys_sync(path=CONNECTIONS, hypr_dir=None, launcher=None, reload=True):
    """Keeps Hyprland's config in step with the shortcuts set in OMARemote, as far as the user allows.

    Settings › Hotkeys › "Write the shortcuts into Hyprland's config" (ui.hyprHotkeys, off by default):
      on   ~/.config/hypr/omaremote.lua holds the bindings, and hyprland.lua loads it through a block
           between OMARemote's markers at its end (backed up once first);
      off  the block and the file go again.
    Only a Lua config (Hyprland 0.56, Omarchy 4). Returns {"mode": "on" | "off" | "unsupported",
    "shortcuts", "changed"}."""
    hypr_dir = hypr_dir or os.path.join(CONFIG_HOME, "hypr")
    launcher = launcher or os.path.join(HERE, APP)
    enabled = bool((load_raw(path).get("ui") or {}).get("hyprHotkeys"))
    data = load_data(path)
    text, count = hypr_managed_text([resolve(c, data) for c in data["connections"]], launcher)
    main_config = os.path.join(hypr_dir, "hyprland.lua")
    managed = os.path.join(hypr_dir, HYPR_MANAGED)
    try:
        with open(main_config, encoding="utf-8") as f:
            config = f.read()
    except FileNotFoundError:
        return {"mode": "unsupported", "shortcuts": count, "changed": False}
    changed = False
    block = HYPR_MARKER_BEGIN + "\n" + hypr_loader_line() + "\n" + HYPR_MARKER_END
    try:
        managed_before = open(managed, encoding="utf-8").read()
    except OSError:
        managed_before = None
    try:
        span = hypr_block_span(config)
    except ValueError as e:
        # Half a block (the user edited it): leave hyprland.lua alone rather than guess.
        return {"mode": "on" if enabled else "off", "shortcuts": count, "changed": False, "error": str(e)}
    adding = enabled and (span is None or managed_before != text)
    if adding and reload:
        # As Flea does: a config that already reports errors is fixed first, or a new error could
        # not be told apart from it.
        errors = hypr_config_errors()
        if errors:
            return {"mode": "on", "shortcuts": count, "changed": False,
                    "error": "Hyprland already reports a config error, fix that first: " + "; ".join(errors)}
    if not user_file_writable(main_config) and (enabled != (span is not None)):
        # Generated or managed elsewhere (read-only): its owner adds or removes the loader. The
        # bindings file itself is still kept current when the folder allows it.
        if enabled and user_file_writable(managed):
            try:
                with open(managed, encoding="utf-8") as f:
                    current = f.read()
            except OSError:
                current = None
            if current != text:
                write_json_text(managed, text)
                changed = True
        if changed and reload:
            hypr_reload()
        return {"mode": "readonly", "shortcuts": count, "changed": changed, "line": hypr_loader_line()}
    if enabled:
        try:
            with open(managed, encoding="utf-8") as f:
                current = f.read()
        except OSError:
            current = None
        if current != text:
            write_json_text(managed, text)
            changed = True
        if span is None:
            if not os.path.exists(main_config + ".omaremote-backup"):
                with open(main_config + ".omaremote-backup", "w", encoding="utf-8") as f:
                    f.write(config)
            write_json_text(main_config, hypr_add_block(config, block))
            changed = True
    else:
        if span is not None:
            write_json_text(main_config, hypr_remove_block(config, span))
            changed = True
        if os.path.exists(managed):
            os.remove(managed)
            changed = True
    if changed and reload:
        if not hypr_reload():
            return {"mode": "on" if enabled else "off", "shortcuts": count, "changed": changed,
                    "error": "Hyprland could not be reached: run hyprctl reload inside the session"}
        errors = hypr_config_errors() if adding else None
        if errors:
            # Never leave a config that does not load: both files back as they were, then reload.
            write_json_text(main_config, config)
            if managed_before is None:
                if os.path.exists(managed):
                    os.remove(managed)
            else:
                write_json_text(managed, managed_before)
            hypr_reload()
            return {"mode": "off", "shortcuts": count, "changed": False, "revert": True,
                    "error": "the shortcuts broke Hyprland's config and were taken out again: " + "; ".join(errors)}
    return {"mode": "on" if enabled else "off", "shortcuts": count, "changed": changed}


def hypr_config_errors():
    """What `hyprctl configerrors` reports, as a list (empty when the config loads cleanly), or None
    when hyprctl cannot be reached (outside the session)."""
    out = _hyprctl_json("configerrors")
    if out is None:
        return None
    return [e for e in (out if isinstance(out, list) else [out]) if str(e).strip()]


def hypr_reload():
    try:
        return subprocess.run(["hyprctl", "reload"], capture_output=True, timeout=10).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def hypr_loader_line():
    """The line in hyprland.lua that loads omaremote.lua, the path worked out when Hyprland loads it
    (another user or home, a dotfile repo shared between machines), XDG_CONFIG_HOME included when
    it is set; skipped quietly while the file is not there."""
    if os.environ.get("XDG_CONFIG_HOME"):
        where = '(os.getenv("XDG_CONFIG_HOME") or os.getenv("HOME") .. "/.config") .. "/hypr/%s"' % HYPR_MANAGED
    else:
        where = 'os.getenv("HOME") .. "/.config/hypr/%s"' % HYPR_MANAGED
    return 'do local path = %s; local file = io.open(path, "r"); if file then file:close(); dofile(path) end end' % where


def hypr_block_span(config):
    """(first, last) line numbers of OMARemote's block in hyprland.lua, or None when there is none.
    Only whole lines count as markers, so a comment that mentions one is never taken for it. A
    start without its end raises ValueError: the block was edited, and nothing is guessed."""
    lines = config.split("\n")
    starts = [i for i, line in enumerate(lines) if line.strip() == HYPR_MARKER_BEGIN]
    if not starts:
        return None
    first = starts[0]
    last = next((i for i in range(first + 1, len(lines)) if lines[i].strip() == HYPR_MARKER_END), None)
    if last is None:
        raise ValueError("hyprland.lua has OMARemote's start marker (%s) but not its end marker (%s): "
                         "remove what is left of the block by hand" % (HYPR_MARKER_BEGIN, HYPR_MARKER_END))
    return first, last


def hypr_add_block(config, block):
    """config with the block at its end, after one blank line; the user's text stays as it was."""
    return config + ("" if config.endswith("\n") or not config else "\n") + ("\n" if config else "") + block + "\n"


def hypr_remove_block(config, span):
    """config without the block and the one blank line hypr_add_block put before it; every other
    line, blank or not, stays."""
    lines = config.split("\n")
    first, last = span
    if first > 0 and lines[first - 1].strip() == "":
        first -= 1
    return "\n".join(lines[:first] + lines[last + 1:])


def write_user_file(path, text, mode=0o644):
    """A config file written whole, then renamed into place, so nothing ever reads half of it.

    Through a symlink, never over it: dotfile managers (stow, chezmoi, home-manager) link
    ~/.config/hypr/hyprland.lua or ~/.ssh/config to a file they own, and renaming onto the link
    would quietly replace it with a plain file. An existing file keeps its permissions; a new one
    gets `mode`. The temporary file has a name of its own and goes again if anything fails.
    (After hyprmoncfg's WriteFileAtomic, internal/config/hyprland.go.)"""
    real = os.path.realpath(path)
    folder = os.path.dirname(real) or "."
    keep = os.stat(real).st_mode & 0o777 if os.path.exists(real) else mode
    fd, tmp = tempfile.mkstemp(dir=folder, prefix="." + os.path.basename(real) + ".omaremote-")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            f.write(text)
            f.flush()
            os.fsync(f.fileno())
        os.chmod(tmp, keep)
        os.replace(tmp, real)
    except BaseException:
        try:
            os.remove(tmp)
        except OSError:
            pass
        raise


def user_file_writable(path):
    """Whether OMARemote may rewrite this config file. A file without any write permission belongs to
    whatever generates it (a Nix store link, home-manager), even where this process could write it."""
    real = os.path.realpath(path)
    folder = os.path.dirname(real) or "."
    if os.path.exists(real):
        if os.stat(real).st_mode & 0o222 == 0:
            return False
        return os.access(real, os.W_OK) and os.access(folder, os.W_OK)
    return os.access(folder, os.W_OK)


def write_json_text(path, text):
    write_user_file(path, text)


# ---------------------------------------------------------------- files over SFTP
#
# An SSH connection's files as an ordinary folder: GVFS mounts sftp:// (with the system ssh, so
# ~/.ssh/config, keys, the agent and known_hosts all apply) and its FUSE layer shows the mount under
# $XDG_RUNTIME_DIR/gvfs, which the user's own file manager opens (xdg-open). OMARemote moves no
# files itself: uploading and downloading is dragging in that file manager.

# Where distributions put GVFS's sftp backend (Arch, Debian/Fedora, older layouts).
GVFSD_SFTP = ("/usr/lib/gvfsd-sftp", "/usr/libexec/gvfsd-sftp", "/usr/lib/gvfs/gvfsd-sftp", "/usr/lib*/gvfs/gvfsd-sftp")
GVFS_FUSE = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}", "gvfs")


def sftp_uri(conn):
    """sftp://[user@]host[:port]/ for an SSH connection; ValueError for anything else."""
    if conn.get("protocol") != "ssh":
        raise ValueError("files are for SSH connections")
    host = check_host(conn.get("host"))
    user = (conn.get("username") or "").strip()
    if "@" in host:
        user, host = host.rsplit("@", 1)
    if ":" in host and not host.startswith("["):
        host = f"[{host}]"  # an IPv6 address
    try:
        port = int(conn.get("port") or 22)
    except (TypeError, ValueError):
        port = 22
    from urllib.parse import quote
    who = quote(user, safe="") + "@" if user else ""
    return f"sftp://{who}{host}" + (f":{port}" if port != 22 else "") + "/"


def gvfs_fuse_ready(mounts_text=None):
    """Whether GVFS's FUSE layer is up, so a mount has a local folder (Omarchy's suspend hook can
    leave it down: omacom/omarchy#5214)."""
    if mounts_text is None:
        try:
            with open("/proc/mounts", encoding="utf-8") as f:
                mounts_text = f.read()
        except OSError:
            return False
    return any(len(parts) > 2 and parts[1] == GVFS_FUSE and parts[2] == "fuse.gvfsd-fuse"
               for parts in (line.split() for line in mounts_text.splitlines()))


def _gio_mount(uri):
    """The GMount holding uri, or None."""
    from gi.repository import Gio
    try:
        return Gio.File.new_for_uri(uri).find_enclosing_mount(None)
    except Exception:
        return None


def files_mounted(conn):
    try:
        return _gio_mount(sftp_uri(conn)) is not None
    except (ValueError, ImportError):
        return False


def browse(name):
    """omaremote-session browse: an SSH connection's files in the default file manager. Prints JSON:
    {"state": "opened" | "terminal" | "needs-fuse"} or {"error"}."""
    conn = find_connection(name, load_connections())
    if not conn:
        return {"error": "no such connection"}
    try:
        uri = sftp_uri(conn)
        from gi.repository import Gio  # noqa: F401  (python-gobject)
    except ValueError as e:
        return {"error": str(e)}
    except ImportError:
        return {"error": "browsing files needs python-gobject"}
    if not shutil.which("gio") or not any(glob.glob(p) for p in GVFSD_SFTP):
        return {"error": "browsing files needs gvfs (the gvfs package)"}
    if not gvfs_fuse_ready():
        return {"state": "needs-fuse"}
    if _gio_mount(uri) is None:
        # Keys and the agent sign in without a word; anything that asks (a password, a new host
        # key) gets a terminal, where gio mount asks and OMARemote never sees the answer.
        try:
            done = subprocess.run(["gio", "mount", uri], stdin=subprocess.DEVNULL, capture_output=True,
                                  timeout=30).returncode == 0
        except subprocess.TimeoutExpired:
            done = False
        if not done or _gio_mount(uri) is None:
            again = "gio mount %s && %s browse %s" % (shlex.quote(uri), shlex.quote(os.path.abspath(__file__)),
                                                       shlex.quote(conn["id"]))
            subprocess.Popen(["omarchy", "launch", "floating", "terminal", "with", "presentation", again],
                             stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                             start_new_session=True)
            return {"state": "terminal"}
    mount = _gio_mount(uri)
    folder = mount.get_default_location().get_path() if mount else None  # the remote home
    if not folder:
        return {"state": "needs-fuse"}
    # Only ever a folder: the default file manager, never whatever app a file would open in.
    if not os.path.isdir(folder):
        return {"error": "the remote home is not a folder"}
    subprocess.Popen(["xdg-open", folder], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)
    return {"state": "opened"}


def unmount_files(name):
    conn = find_connection(name, load_connections())
    if not conn:
        return {"error": "no such connection"}
    try:
        uri = sftp_uri(conn)
    except ValueError as e:
        return {"error": str(e)}
    out = subprocess.run(["gio", "mount", "-u", uri], stdin=subprocess.DEVNULL, capture_output=True, text=True)
    return {"unmounted": out.returncode == 0} if out.returncode == 0 else {"error": (out.stderr or "").strip()[:200]}


def mounted_files():
    """The SSH connections whose files are mounted now: their ids, and per id how many of its
    sessions are running (the UI asks about unmounting only when the last one ends)."""
    out = []
    try:
        from gi.repository import Gio  # noqa: F401
    except ImportError:
        return out
    for c in load_connections():
        if c.get("protocol") == "ssh" and files_mounted(c):
            out.append(c["id"])
    return out


def restart_gvfs():
    """The fix Omarchy's own PR #14496 applies after a resume: restart gvfs-daemon, which brings its
    FUSE layer back. Only on the user's say-so (other network locations disconnect)."""
    subprocess.run(["systemctl", "--user", "restart", "gvfs-daemon.service"], capture_output=True, timeout=30)
    for _ in range(50):
        if gvfs_fuse_ready():
            return {"ok": True}
        time.sleep(0.2)
    return {"error": "GVFS came back without its folder layer"}


def monitor_scale():
    """The focused monitor's scale in percent, or 100 when Hyprland cannot answer."""
    try:
        out = subprocess.run(["hyprctl", "monitors", "-j"], capture_output=True, text=True, timeout=3)
        for m in json.loads(out.stdout):
            if m.get("focused"):
                return int(round(float(m.get("scale", 1)) * 100))
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return 100


def device_scale(desktop):
    """RDP device scale only knows 100, 140 and 180; pick the nearest step."""
    return min((100, 140, 180), key=lambda step: abs(step - desktop))


def resolve_scale(setting, auto_scale):
    if str(setting) == "auto":
        value = auto_scale
    else:
        try:
            value = int(setting)
        except (TypeError, ValueError):
            value = auto_scale
    return max(100, min(500, value))


# ---------------------------------------------------------------- arguments

# A host as a session may use it: a DNS name, an IPv4 or [IPv6] address (with a zone), an ssh Host
# alias. Nothing else: the clients read their settings one per line, and a host or gateway arrives
# from other systems through sync, so a line break or a comma in one would be read as settings of
# its own (FreeRDP's /drive: sharing the whole disk, for one).
HOST_RE = re.compile(r"^(?!-)[A-Za-z0-9._%:@\[\]-]{1,253}$")
CONTROL_RE = re.compile(r"[\x00-\x1f\x7f]")


def check_host(value, what="host"):
    value = (value or "").strip()
    if not HOST_RE.match(value):
        raise ValueError(f"not a valid {what} name: letters, digits, dots, dashes and a :port only")
    return value


def plain(value):
    """Text with its control characters (line breaks included) turned into spaces."""
    return CONTROL_RE.sub(" ", value or "")


def check_lines(args):
    """The last guard before settings go to a client one per line: none may hold a line break."""
    for a in args:
        if CONTROL_RE.search(a):
            raise ValueError("a setting of this connection contains a line break or another control "
                             "character, so it was not passed on")
    return args


def _unpassable(what):
    raise ValueError(f"the {what} cannot hold a quote or end in a backslash (FreeRDP cannot take it)")


def gateway_element(key, value):
    """One element of FreeRDP's /gateway: list ("p:secret"), or None when FreeRDP cannot take it.

    FreeRDP splits that list on commas, takes an element wrapped whole in double quotes as it is
    (a comma or backslash inside is fine), but counts every quote character, ' and " alike, as an
    opening or closing quote, and lets a trailing backslash escape the end of the text
    (winpr/libwinpr/utils/cmdline.c; tried against FreeRDP 3.31). So a value with a quote, or one
    ending in a backslash, cannot be passed: for the password the caller leaves it out and FreeRDP
    asks for it at connect, in OMARemote's own sign-in prompt."""
    element = f"{key}:{value}"
    if "'" in value or '"' in value or value.endswith("\\"):
        return None
    if "," in value:
        return f'"{element}"'
    return element


def build_args(conn, password=None, auto_scale=100, tab=None, gateway_password=None):
    """FreeRDP arguments for one connection, one argument per entry (fed to /args-from:stdin).

    tab is {"width", "height", "scale"} in device pixels when the session is drawn in a tab: the
    desktop then starts at the tab's size and the window-only options are left out.
    gateway_password is the gateway's own; without one, a gateway that signs in as the connection's
    user gets the connection's password.
    """
    c = dict(DEFAULTS, **conn)
    if not c["host"].strip():
        raise ValueError("connection has no host")
    host = check_host(c["host"])
    port = int(c.get("port") or 3389)
    args = [f"/v:{host}" if port == 3389 else f"/v:{host}:{port}"]

    if c["username"]:
        args.append(f"/u:{c['username']}")
    if c["domain"]:
        args.append(f"/d:{c['domain']}")
    if password:
        args.append(f"/p:{password}")

    display = c["display"]
    if tab:
        if display == "fixed":
            args.append(f"/size:{int(c['width'])}x{int(c['height'])}")
        else:
            # Even width: the display-control channel refuses odd ones.
            args.append(f"/size:{int(tab['width']) & ~1}x{int(tab['height'])}")
            args.append("+dynamic-resolution")
        auto_scale = int(tab.get("scale") or auto_scale)
    else:
        args.append(f"/t:{plain(c['name']) or host}")

    # Display. Every mode keeps resolution in step with the window except fixed.
    if tab:
        pass
    elif display == "fixed":
        args.append(f"/size:{int(c['width'])}x{int(c['height'])}")
        args.append("+smart-sizing")
    else:
        args.append("+dynamic-resolution")
        if display == "fullscreen":
            args.append("/f")
    if c["multimon"] and not tab:
        args.append("/multimon")

    scale = resolve_scale(c["scale"], auto_scale)
    if scale != 100:
        args.append(f"/scale-desktop:{scale}")
        args.append(f"/scale-device:{device_scale(scale)}")

    # Redirection.
    args.append("+clipboard" if c["clipboard"] else "-clipboard")
    if c["audio"] == "local":
        args.append("/sound")
    elif c["audio"] == "remote":
        args.append("/audio-mode:1")
    else:
        args.append("/audio-mode:2")
    if c["microphone"]:
        args.append("/microphone")
    if c["homeDrive"]:
        args.append("+home-drive")
    if c["grabKeyboard"]:
        args.append("+grab-keyboard")

    # Transport.
    if c["security"] in ("nla", "tls", "rdp"):
        args.append(f"/sec:{c['security']}")
    if c["ignoreCert"]:
        args.append("/cert:ignore")
    args.append(f"/network:{c['network'] if c['network'] in ('lan', 'broadband', 'modem') else 'auto'}")
    args.append("/gfx")
    args.append("+auto-reconnect")

    if c["gateway"].strip():
        gw = [f"g:{check_host(c['gateway'], 'gateway')}"]
        user = c["gatewayUser"] or c["username"]
        domain = c["gatewayDomain"] or c["domain"]
        if user:
            gw.append(gateway_element("u", user) or _unpassable("gateway user name"))
        if domain:
            gw.append(gateway_element("d", domain) or _unpassable("gateway domain"))
        # A password FreeRDP's list cannot hold (a quote in it) is left out: FreeRDP then asks.
        secret = gateway_password or (password if not c["gatewayUser"] else None)
        if secret and gateway_element("p", secret):
            gw.append(gateway_element("p", secret))
        args.append("/gateway:" + ",".join(gw))

    if c["extraArgs"].strip():
        args.extend(shlex.split(c["extraArgs"]))
    return check_lines(args)


def build_vnc_config(conn, password=None):
    """Settings for omaremote-vnc, as key=value lines (fed on stdin)."""
    c = dict(DEFAULTS, **conn)
    if not c["host"].strip():
        raise ValueError("connection has no host")
    host = check_host(c["host"])
    port = int(conn.get("port") or DEFAULT_PORTS["vnc"])
    lines = [f"host={host}", f"port={port}",
             f"scaling={c['vncScaling'] if c['vncScaling'] in ('fit', 'native', 'resize') else 'fit'}",
             f"quality={c['vncQuality'] if c['vncQuality'] in ('auto', 'high', 'low') else 'auto'}",
             f"viewOnly={1 if c['viewOnly'] else 0}",
             f"clipboard={0 if c['clipboard'] is False else 1}"]
    if c["username"]:
        lines.append(f"username={c['username']}")
    if password:
        lines.append(f"password={password}")
    return check_lines(lines)


# The terminal's look: the theme's terminal colours (Omarchy writes a foot.ini for every theme) and
# the default terminal's font size; the font is fontconfig's monospace, which Omarchy sets.
THEME_TERMINAL = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"),
                              "omarchy", "current", "theme", "foot.ini")
FONT_SIZE_RES = {
    "foot": (os.path.join(CONFIG_HOME, "foot", "foot.ini"), r"^\s*font\s*=.*?:size=([\d.]+)"),
    "alacritty": (os.path.join(CONFIG_HOME, "alacritty", "alacritty.toml"), r"^\s*size\s*=\s*([\d.]+)"),
    "ghostty": (os.path.join(CONFIG_HOME, "ghostty", "config"), r"^\s*font-size\s*=\s*([\d.]+)"),
    "kitty": (os.path.join(CONFIG_HOME, "kitty", "kitty.conf"), r"^\s*font_size\s+([\d.]+)"),
}


def default_terminal():
    """The default terminal's name (foot, alacritty, ghostty, kitty), as xdg-terminal-exec picks it."""
    try:
        out = subprocess.run(["xdg-terminal-exec", "--print-id"], capture_output=True, text=True, timeout=2).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    out = out.strip().lower()
    return next((name for name in FONT_SIZE_RES if name in out), "")


def terminal_font_size(terminal=None, fallback=9.0):
    """The point size the default terminal uses, read from its config; Omarchy's 9 otherwise."""
    order = [terminal if terminal is not None else default_terminal()] + list(FONT_SIZE_RES)
    for name in order:
        if name not in FONT_SIZE_RES:
            continue
        path, pattern = FONT_SIZE_RES[name]
        try:
            with open(path, encoding="utf-8") as f:
                m = re.search(pattern, f.read(), re.M)
        except OSError:
            continue
        if m:
            return float(m.group(1))
    return fallback


def build_ssh_command(conn):
    """The ssh command line. ~/.ssh/config still applies: the port and user go along only when set."""
    host = check_host(conn["host"])
    args = ["ssh"]
    port = int(conn.get("port") or 22)
    if port != 22:
        args += ["-p", str(port)]
    user = (conn.get("username") or "").strip()
    if user:
        args += ["-l", user]
    # Also in ~/.ssh/omaremote.conf; passed here as well, so it holds even without that Include.
    key = (conn.get("sshKey") or "").strip()
    if key:
        args += ["-i", os.path.expanduser(key), "-o", "IdentitiesOnly=yes"]
    args += shlex.split(conn.get("sshArgs") or "")
    return args + [host]


# ---------------------------------------------------------------- ssh keys and ~/.ssh/omaremote.conf
#
# A key chosen for an SSH connection is passed to ssh by OMARemote. Only when the user allows it
# (Settings › SSH, off by default) does it also go into ~/.ssh/omaremote.conf, a file OMARemote owns
# and rewrites whole, so a plain `ssh host` in a terminal signs in the same way. ~/.ssh/config then
# gets one line, `Include omaremote.conf`, at the very top (an Include below a Host line would belong
# to that host), after a backup; the user's own entries are never touched, and turning the setting
# off takes that line out again. Users who keep their config to themselves add the Include by hand.

SSH_DIR = os.path.expanduser("~/.ssh")
SSH_MANAGED = "omaremote.conf"
SSH_INCLUDE = "Include " + SSH_MANAGED
SSH_INCLUDE_RE = re.compile(r"^\s*include\s+(~/\.ssh/)?omaremote\.conf\s*$", re.I | re.M)


def _tilde(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def ssh_keys(ssh_dir=SSH_DIR):
    """Keys in ~/.ssh: private key files, and public keys alone (their private half lives in an agent
    such as 1Password; IdentityFile on the .pub makes ssh use the agent's matching key)."""
    try:
        names = sorted(os.listdir(ssh_dir))
    except OSError:
        return []
    out = []
    for name in names:
        path = os.path.join(ssh_dir, name)
        if not os.path.isfile(path) or name.startswith("."):
            continue
        if name.endswith(".pub"):
            if os.path.exists(path[:-4]):
                continue  # listed with its private key
            kind = "agent"
            pub = path
        else:
            try:
                with open(path, "rb") as f:
                    head = f.read(64)
            except OSError:
                continue
            if not (head.startswith(b"-----BEGIN") and b"PRIVATE KEY" in head):
                continue
            kind = "file"
            pub = path + ".pub"
        key_type, comment = "", ""
        try:
            with open(pub, encoding="utf-8") as f:
                parts = f.read().split(None, 2)
            if len(parts) >= 2 and parts[0].startswith(("ssh-", "ecdsa-", "sk-")):
                key_type = parts[0].replace("ssh-", "").replace("sk-", "security key ")
                comment = parts[2].strip() if len(parts) > 2 else ""
            elif kind == "agent":
                continue  # a .pub that is not a public key
        except OSError:
            pass
        out.append({"path": _tilde(path), "name": name, "kind": kind, "type": key_type, "comment": comment})
    return out


def ssh_managed_text(connections):
    """~/.ssh/omaremote.conf for the SSH connections that have a key; the first per host wins."""
    lines = ["# Written by OMARemote: the keys chosen for its SSH connections. It rewrites this file",
             "# whole, so edit the connections in OMARemote, not this file.", ""]
    seen = set()
    for c in connections:
        key = (c.get("sshKey") or "").strip()
        host = (c.get("host") or "").strip()
        # One line each: a value with a line break or a space would add or bend ssh options (a
        # ProxyCommand runs commands). Names arrive by sync and import, so they lose control chars.
        # The host is a plain name: a pattern ("*", "!x", "a,b") would hand the key to other hosts.
        if c.get("protocol") != "ssh" or not key or not host or host in seen or not HOST_RE.match(host) \
                or re.search(r'[\s#"]', key) or CONTROL_RE.search(key):
            continue
        seen.add(host)
        lines.append(f"# {plain(str(c.get('name') or host))} (OMARemote connection {plain(str(c.get('id', '?')))})")
        lines.append(f"Host {host}")
        lines.append(f"    IdentityFile {key}")
        lines.append("    IdentitiesOnly yes")
        user = (c.get("username") or "").strip()
        if user and not re.search(r"\s", user):
            lines.append(f"    User {user}")
        try:
            port = int(c.get("port") or 22)
        except (TypeError, ValueError):
            port = 22
        if port != 22:
            lines.append(f"    Port {port}")
        lines.append("")
    return "\n".join(lines), len(seen)


SSH_MARKER = "# OMARemote's SSH keys (~/.ssh/omaremote.conf); first, so it applies to every host."


def _write_private(path, text, like=None):
    """Written whole through write_user_file: a new file readable by the user only, an existing one
    (or a symlink's target) keeping its permissions."""
    write_user_file(path, text, mode=0o600)


def ssh_config_sync(path=CONNECTIONS, ssh_dir=SSH_DIR):
    """Keeps ssh's own config in step with the keys chosen in OMARemote, as far as the user allows.

    Settings › SSH › "keys in the terminal too" (ui.sshTerminalKeys, off by default):
      on   ~/.ssh/omaremote.conf is written, and ~/.ssh/config gets OMARemote's Include at the top
           (backed up first) unless it includes the file already.
      off  OMARemote's own Include, recognised by its comment, comes out again with the file. An
           Include the user added by hand stays theirs: then only omaremote.conf is kept current.
    A read-only ~/.config (generated elsewhere) is never edited: mode "readonly", the Include is the
    user's to add. Returns {"mode": "auto" | "manual" | "off" | "readonly", "keys", "changed"}."""
    raw = load_raw(path)
    enabled = bool((raw.get("ui") or {}).get("sshTerminalKeys"))
    data = load_data(path)
    text, count = ssh_managed_text([resolve(c, data) for c in data["connections"]])
    managed = os.path.join(ssh_dir, SSH_MANAGED)
    config = os.path.join(ssh_dir, "config")
    try:
        with open(config, encoding="utf-8") as f:
            user_config = f.read()
    except FileNotFoundError:
        user_config = None
    ours = user_config is not None and SSH_MARKER in user_config
    included = user_config is not None and bool(SSH_INCLUDE_RE.search(user_config))
    changed = False
    # A config generated or managed elsewhere (read-only) is its owner's to change.
    config_writable = user_config is None or user_file_writable(config)

    if not enabled and ours and config_writable:
        # Out again: the marker, the Include under it and the blank line after, nothing else.
        lines = user_config.split("\n")
        at = lines.index(SSH_MARKER)
        cut = 1
        if at + 1 < len(lines) and SSH_INCLUDE_RE.match(lines[at + 1]):
            cut = 2
            if at + 2 < len(lines) and lines[at + 2] == "":
                cut = 3
        _write_private(config, "\n".join(lines[:at] + lines[at + cut:]), like=config)
        user_config = "\n".join(lines[:at] + lines[at + cut:])
        included = bool(SSH_INCLUDE_RE.search(user_config))
        changed = True

    mode = "auto" if enabled else "manual" if included else "off"
    if mode == "off":
        if os.path.exists(managed):
            os.remove(managed)
            changed = True
        return {"mode": mode, "keys": count, "changed": changed}

    if count == 0 and not os.path.exists(managed) and mode == "auto":
        return {"mode": mode, "keys": 0, "changed": changed}  # nothing to write yet, config untouched
    os.makedirs(ssh_dir, mode=0o700, exist_ok=True)
    try:
        with open(managed, encoding="utf-8") as f:
            current = f.read()
    except OSError:
        current = None
    if current != text:
        _write_private(managed, text)
        changed = True
    if mode == "auto" and count > 0 and not included and not config_writable:
        return {"mode": "readonly", "keys": count, "changed": changed}
    if mode == "auto" and count > 0 and not included:
        if user_config is not None and not os.path.exists(config + ".omaremote-backup"):
            with open(os.open(config + ".omaremote-backup", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600),
                      "w", encoding="utf-8") as f:
                f.write(user_config)
        head = SSH_MARKER + "\n" + SSH_INCLUDE + "\n"
        _write_private(config, head + ("\n" + user_config if user_config else ""), like=config)
        changed = True
    return {"mode": mode, "keys": count, "changed": changed}

GLIFF_SSH_OPTIONS = ["-T", "-o", "Compression=no", "-o", "IPQoS=lowdelay"]
# What may reach the remote command line. ssh hands that line to the remote shell, so these are the
# only words from a connection that go into it, and none of them can hold a shell character.
GLIFF_OUTPUT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,63}")          # DP-1, HDMI-A-1, eDP-1
GLIFF_SERVER_RE = re.compile(r"[A-Za-z0-9_.~/][A-Za-z0-9_.~/+-]{0,255}")  # ~/bin/gliff-server


def gliff_server_args(conn):
    """gliff-server's own arguments for a connection: the screen, colour and capture choices, each a
    fixed word or a checked screen name. ValueError for a screen name that is not one."""
    if conn.get("gliffScreen") == "private":
        args = ["--headless"]
    else:
        output = (conn.get("gliffOutput") or "").strip()
        if output and not GLIFF_OUTPUT_RE.fullmatch(output):
            raise ValueError(f"not a screen name: {output!r}")
        args = ["--output", output or "auto"]
    colour = conn.get("gliffColour")
    if colour == "low":
        args.append("--low-bandwidth")
    elif colour == "full":
        args.append("--full-chroma")
    if conn.get("gliffCapture") == "shm":
        args += ["--capture", "shm"]
    return args


def build_gliff_command(conn):
    """ssh to the host running gliff-server --stdio, as Gliff's own client does
    (crates/gliff-transport/src/ssh.rs). The remote command is checked words only (gliff_server_args,
    GLIFF_SERVER_RE): ssh hands it to the remote shell."""
    args = build_ssh_command(conn)
    host = args.pop()
    server = (conn.get("gliffServer") or "").strip() or "gliff-server"
    if not GLIFF_SERVER_RE.fullmatch(server):
        raise ValueError(f"not a gliff-server path: {server!r}")
    return [args[0], *GLIFF_SSH_OPTIONS, *args[1:], "--", host, server, "--stdio", *gliff_server_args(conn)]


def build_gliff_config(conn):
    """Settings for omaremote-gliff, as key=value lines (fed on stdin)."""
    lines = [f"arg={a}" for a in build_gliff_command(conn)]
    lines += [f"host={check_host(conn['host'])}",
              f"headless={1 if conn.get('gliffScreen') == 'private' else 0}",
              f"video={'cpu' if conn.get('gliffVideo') == 'cpu' else 'auto'}",
              f"clipboard={0 if conn.get('clipboard') is False else 1}"]
    return check_lines(lines)


def build_ssh_config(conn):
    """Settings for omaremote-ssh, as key=value lines (fed on stdin)."""
    lines = [f"arg={a}" for a in build_ssh_command(conn)]
    lines += [f"host={check_host(conn['host'])}", "font=monospace", f"fontSize={terminal_font_size():g}",
              f"theme={THEME_TERMINAL}", f"clipboard={0 if conn.get('clipboard') is False else 1}"]
    return check_lines(lines)


def redact(args):
    out = []
    for a in args:
        if a.startswith("/p:"):
            out.append("/p:********")
        elif a.startswith("password="):
            out.append("password=********")
        elif a.startswith("/gateway:"):
            # The password element, quoted (gateway_element) or not.
            out.append("/gateway:" + re.sub(r"""(^|,)(?:"p:[^"]*"|'p:[^']*'|p:[^,]*)""", r"\1p:********",
                                            a[len("/gateway:"):]))
        else:
            out.append(a)
    return out

STAGES = (
    ("verify_cb", "Checking certificate"),
    ("tls_config_check_certificate", "Checking certificate"),
    ("credssp_auth_init", "Signing in"),
    ("Credentials required", "Waiting for credentials"),
    ("rdp_client_connect_license", "Checking license"),
)
AUTH_RE = re.compile(r"Negotiated mechanism: (Kerberos|NTLM)")


def session_stage(line):
    """(stage, auth) a FreeRDP log line announces; either may be None."""
    m = AUTH_RE.search(line)
    if m:
        return "Signing in", m.group(1)
    for marker, stage in STAGES:
        if marker in line:
            return stage, None
    return None, None


SSH_FAILED_RE = re.compile(r"^\[omaremote\] connection failed: (.+)$", re.M)


def describe_exit(code, log_tail, protocol="rdp"):
    """A sentence for the UI, or None when the session simply ended."""
    if protocol == "gliff":
        # omaremote-gliff says why it failed (ssh's or the server's words); 11 is a disconnect.
        if code is None or code < 0 or code in (0, 11, 145):
            return None
        said = SSH_FAILED_RE.findall(log_tail or "")
        if said and said[-1].strip():
            return said[-1].strip()
        return EXIT_MESSAGES.get(code) or f"The session ended with code {code}"
    if protocol == "ssh":
        # A shell ends with its last command's status; only ssh's own 255 means it could not connect.
        if code != 255:
            return None
        said = SSH_FAILED_RE.findall(log_tail or "")
        return said[-1].strip() if said and said[-1].strip() else "Could not connect to the server"
    if code is not None and code < 0:
        return None  # killed by a signal: stopped from the UI
    if code in EXIT_MESSAGES:
        message = EXIT_MESSAGES[code]
    elif code is not None and 32 <= code < 128:
        message = f"The server ended the connection (RDP error {code - 32})"
    else:
        message = f"FreeRDP exited with code {code}"
    if message is None:
        return None
    errors = ERROR_RE.findall(log_tail or "")
    if errors and errors[-1] == "ERRCONNECT_CONNECT_CANCELLED":
        return None  # a FreeRDP dialog was dismissed
    return f"{message} ({errors[-1]})" if errors else message


# ---------------------------------------------------------------- import from other clients
#
# .rdp files, Remmina, 1Remote and ~/.ssh/config. A scan lists what a source holds and whether it is here
# already; the UI shows that list, and an apply adds the ones picked. Foreign files only ever add:
# a connection that is here already (the same protocol, host and port, whatever its name) is left
# exactly as it is, so importing a file twice, or two files that overlap, changes nothing the
# second time, and a downloaded .rdp can never redirect a saved connection. Who signs in comes
# along (user name, domain, SSH key: the user's own files), passwords never do, and nothing turns
# a check off or shares a folder: those stay the user's to switch on.

IMPORT_GROUP = "Imported"   # where connections go whose source names no group
IMPORT_MAX_BYTES = 1 << 20
IMPORT_MAX_FILES = 500
IMPORT_MAX_ENTRIES = 2000
IMPORT_SUFFIXES = (".rdp", ".remmina")
REMMINA_DIRS = ("~/.local/share/remmina", "~/.var/app/org.remmina.Remmina/data/remmina")
ONEREMOTE_MAX_BYTES = 64 << 20
ONEREMOTE_SECONDS = 5
ONEREMOTE_PROTOCOLS = {"RDP": "rdp", "VNC": "vnc", "SSH": "ssh"}
SSH_WILDCARD_RE = re.compile(r"[*?!]")


def _read_foreign(path):
    """A small text file in whatever encoding Windows or Linux wrote it: .rdp files are often
    UTF-16 with a byte order mark."""
    with open(path, "rb", opener=lambda p, flags: os.open(p, flags | os.O_NONBLOCK)) as f:
        # A FIFO or a device named .rdp would never end: only ordinary files.
        if not stat.S_ISREG(os.fstat(f.fileno()).st_mode):
            raise ValueError("not an ordinary file")
        raw = f.read(IMPORT_MAX_BYTES + 1)
    if len(raw) > IMPORT_MAX_BYTES:
        raise ValueError("larger than 1 MiB")
    if raw.startswith((b"\xff\xfe", b"\xfe\xff")):
        return raw.decode("utf-16")
    if raw.startswith(b"\xef\xbb\xbf"):
        return raw[3:].decode("utf-8", "replace")
    if raw[1:2] == b"\0":
        return raw.decode("utf-16-le", "replace")
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("latin-1")


def _clean(value):
    return plain(str(value or "")).strip()


def _split_address(value, protocol):
    """host and port from host, host:port or [v6]:port; port None when not given."""
    value = _clean(value)
    m = re.match(r"^\[([^\]]+)\](?::(\d+))?$", value) or re.match(r"^([^:]*)(?::(\d+))?$", value)
    if not m:
        return value, None  # a bare IPv6 address
    host, port = m.group(1), m.group(2)
    port = int(port) if port else None
    if protocol == "vnc" and port is not None and port < 100:
        port += 5900  # host:1 is VNC display 1
    return host, port


def parse_rdp(text, name=""):
    """A Windows .rdp file (key:type:value lines) as a connection."""
    v = {}
    for line in text.splitlines():
        parts = line.strip().split(":", 2)
        if len(parts) == 3:
            v[parts[0].strip().lower()] = parts[2].strip()
    host, port = _split_address(v.get("full address", ""), "rdp")
    conn = {"protocol": "rdp", "name": _clean(name) or host, "host": host}
    if port is None and v.get("server port", "").isdigit():
        port = int(v["server port"])
    if port:
        conn["port"] = port
    user = _clean(v.get("username"))
    if "\\" in user:
        conn["domain"], user = user.split("\\", 1)
    if user:
        conn["username"] = user
    if _clean(v.get("domain")):
        conn["domain"] = _clean(v["domain"])
    # 1: always through the gateway, 2: when a direct connection fails (FreeRDP: always).
    if _clean(v.get("gatewayhostname")) and v.get("gatewayusagemethod") in ("1", "2"):
        conn["gateway"] = _clean(v["gatewayhostname"])
    if v.get("redirectclipboard") == "0":
        conn["clipboard"] = False
    audio = {"0": "local", "1": "remote", "2": "off"}.get(v.get("audiomode", ""))
    if audio:
        conn["audio"] = audio
    if v.get("audiocapturemode") == "1":
        conn["microphone"] = True
    notes = []
    if v.get("remoteapplicationmode") == "1":
        notes.append("a RemoteApp: imported as the whole desktop")
    if v.get("drivestoredirect") or v.get("redirectdrives") == "1":
        notes.append("asks to share drives: not taken over")
    return conn, notes


def parse_remmina(text, name=""):
    """A Remmina profile ([remmina] section) as a connection; passwords stay behind (Remmina
    encrypts them with a key of its own)."""
    parser = configparser.RawConfigParser(strict=False, interpolation=None)
    parser.read_string(text)
    if not parser.has_section("remmina"):
        raise ValueError("not a Remmina profile")
    v = {k.lower(): val for k, val in parser.items("remmina")}
    remote = (v.get("protocol") or "").strip()
    protocol = remote.lower()
    if protocol not in DEFAULT_PORTS:
        raise ValueError(f"Remmina {remote or 'unknown'} connections are not supported")
    host, port = _split_address(v.get("server", ""), protocol)
    conn = {"protocol": protocol, "name": _clean(v.get("name")) or _clean(name) or host, "host": host}
    if port:
        conn["port"] = port
    if _clean(v.get("group")):
        conn["group"] = _clean(v["group"])
    user = _clean(v.get("username"))
    if protocol == "rdp" and "\\" in user:
        conn["domain"], user = user.split("\\", 1)
    if user:
        conn["username"] = user
    if protocol == "rdp":
        if _clean(v.get("domain")):
            conn["domain"] = _clean(v["domain"])
        if _clean(v.get("gateway_server")) and v.get("gateway_usage", "1") != "0":
            conn["gateway"] = _clean(v["gateway_server"])
        if v.get("disableclipboard") == "1":
            conn["clipboard"] = False
        if v.get("sound") in ("local", "remote", "off"):
            conn["audio"] = v["sound"]
        if v.get("microphone") not in (None, "", "0"):
            conn["microphone"] = True
    elif protocol == "vnc":
        if v.get("viewonly") == "1":
            conn["viewOnly"] = True
        if v.get("disableclipboard") == "1":
            conn["clipboard"] = False
    elif protocol == "ssh" and _clean(v.get("ssh_privatekey")):
        conn["sshKey"] = _tilde(os.path.expanduser(_clean(v["ssh_privatekey"])))
    notes = ["asks to share a folder: not taken over"] if _clean(v.get("sharefolder")) else []
    return conn, notes


def _oneremote_mode(value):
    """One of 1Remote's numbered choices, None when the value is anything else (a bool, a list, …)."""
    return value if isinstance(value, int) and not isinstance(value, bool) else None


def _oneremote_list(value):
    return value if isinstance(value, list) else []


def parse_1remote(path):
    """A 1Remote database (SQLite, %APPDATA%\\1Remote\\1Remote.db on Windows): one connection per
    server it holds. Returns ([(conn, notes)], errors). Passwords stay behind (1Remote encrypts
    them), and so do the commands it runs around a connection."""
    import sqlite3
    with open(path, "rb", opener=lambda p, flags: os.open(p, flags | os.O_NONBLOCK)) as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise ValueError("not an ordinary file")
        if st.st_size > ONEREMOTE_MAX_BYTES:
            raise ValueError("larger than 64 MiB")
        data = f.read(ONEREMOTE_MAX_BYTES + 1)
    if len(data) > ONEREMOTE_MAX_BYTES:
        raise ValueError("larger than 64 MiB")
    if not data.startswith(b"SQLite format 3\0"):
        raise ValueError("not a 1Remote database")
    try:
        # From memory: SQLite never opens the file, so the database is never changed, nor a journal
        # touched, and a file swapped in after the checks above is never read.
        db = sqlite3.connect(":memory:")
        try:
            db.deserialize(data)
            # The file is someone else's: Servers must be a plain table (a view could run any query
            # the file holds), nothing in its schema runs functions, and a read stops after a few seconds.
            db.execute("PRAGMA trusted_schema = OFF")
            deadline = time.monotonic() + ONEREMOTE_SECONDS
            db.set_progress_handler(lambda: time.monotonic() > deadline, 10000)
            if not db.execute("SELECT 1 FROM sqlite_master WHERE type = 'table' AND name = 'Servers'").fetchone():
                raise sqlite3.DatabaseError("no Servers table")
            rows = db.execute("SELECT Protocol, Json FROM Servers LIMIT ?", (IMPORT_MAX_ENTRIES,)).fetchall()
        finally:
            db.close()
    except sqlite3.Error:
        raise ValueError("not a 1Remote database") from None
    out, errors = [], []
    for remote, text in rows:
        try:
            v = json.loads(text) if isinstance(text, str) else None
        except ValueError:
            v = None
        if not isinstance(v, dict):
            errors.append("a server 1Remote's database cannot be read")
            continue
        label = _clean(v.get("DisplayName"))[:60] or _clean(v.get("Address"))[:60]
        protocol = ONEREMOTE_PROTOCOLS.get(_clean(remote).upper())
        if not protocol:
            errors.append(f"{label}: 1Remote {_clean(remote)[:20] or 'unknown'} connections are not supported")
            continue
        host, port = _split_address(v.get("Address"), protocol)
        conn = {"protocol": protocol, "name": _clean(v.get("DisplayName")) or host, "host": host}
        if port is None and str(v.get("Port") or "").strip().isdigit():
            port = int(str(v["Port"]).strip())
        if port:
            conn["port"] = port
        # Tags are 1Remote's groups; a connection here has one.
        tags = [_clean(t) for t in _oneremote_list(v.get("Tags")) if isinstance(t, str) and _clean(t)]
        if tags:
            conn["group"] = tags[0]
        user = _clean(v.get("UserName"))
        if protocol == "rdp" and "\\" in user:
            conn["domain"], user = user.split("\\", 1)
        if user and protocol != "vnc":
            conn["username"] = user
        notes = []
        if protocol == "rdp":
            if _clean(v.get("Domain")):
                conn["domain"] = _clean(v["Domain"])
            # GatewayMode 0: detect automatically, 1: these settings, 2: no gateway (FreeRDP: always).
            if _clean(v.get("GatewayHostName")) and _oneremote_mode(v.get("GatewayMode")) in (0, 1):
                conn["gateway"] = _clean(v["GatewayHostName"])
                gateway_user = _clean(v.get("GatewayUserName"))
                if "\\" in gateway_user:
                    conn["gatewayDomain"], gateway_user = gateway_user.split("\\", 1)
                if gateway_user:
                    conn["gatewayUser"] = gateway_user
            if v.get("EnableClipboard") is False:
                conn["clipboard"] = False
            audio = {0: "local", 1: "remote", 2: "off"}.get(_oneremote_mode(v.get("AudioRedirectionMode")))
            if audio:
                conn["audio"] = audio
            if v.get("EnableAudioCapture") is True:
                conn["microphone"] = True
            if v.get("EnableDiskDrives") is True:
                notes.append("asks to share drives: not taken over")
        elif protocol == "ssh" and _clean(v.get("PrivateKey")):
            notes.append("its key is a file on Windows: not taken over")
        if _clean(v.get("CommandBeforeConnected")) or _clean(v.get("CommandAfterDisconnected")):
            notes.append("runs commands around connecting: not taken over")
        out.append((conn, notes))
    return out, errors


def parse_ssh_config(path, ssh_dir=SSH_DIR):
    """Every Host alias without wildcards in an ssh config, Included files too. Returns
    [(conn, notes, also)]: the alias is the host, so ssh's config keeps applying (HostName, port,
    user, keys, ProxyJump); also is the key of the server it names, to find it here under its
    real name. OMARemote's own omaremote.conf is never read: those are connections here already."""
    result = []
    for conn, notes, extra in _ssh_hosts(path, ssh_dir, set()):
        also = None
        hostname = _clean(extra.get("hostname"))
        if hostname and "%" not in hostname:
            port = int(extra["port"]) if str(extra.get("port") or "").isdigit() else 22
            also = connection_key({"protocol": "ssh", "host": hostname, "port": port})
            notes = notes + [f"{hostname}" + (f":{port}" if port != 22 else "")]
        result.append((conn, notes, also))
    return result


def _ssh_hosts(path, ssh_dir, seen):
    """(conn, notes, {hostname, port}) per Host alias in path and what it Includes."""
    real = os.path.realpath(path)
    if real in seen or len(seen) > 64 or os.path.basename(real) == SSH_MANAGED:
        return []
    seen.add(real)
    out, block = [], []
    for line in _read_foreign(path).splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^(\S+?)\s*(?:=\s*|\s+)(.*)$", line)
        if not m:
            continue
        key, rest = m.group(1).lower(), m.group(2)
        try:
            args = shlex.split(rest, comments=True)
        except ValueError:
            args = rest.split()
        if key == "host":
            block = []
            for alias in args:
                if SSH_WILDCARD_RE.search(alias):
                    continue
                entry = ({"protocol": "ssh", "name": _clean(alias), "host": _clean(alias)}, [], {})
                out.append(entry)
                block.append(entry)
        elif key == "match":
            block = []
        elif key in ("hostname", "port"):
            for entry in block:
                entry[2].setdefault(key, args[0] if args else "")
        elif key == "include":
            for pattern in args:
                pattern = os.path.expanduser(pattern)
                if not os.path.isabs(pattern):
                    pattern = os.path.join(ssh_dir, pattern)
                for name in sorted(glob.glob(pattern)):
                    if os.path.isfile(name):
                        out += _ssh_hosts(name, ssh_dir, seen)
    return out


def import_sources():
    """What the Import buttons can offer here."""
    remmina = [os.path.expanduser(d) for d in REMMINA_DIRS if os.path.isdir(os.path.expanduser(d))]
    return {"remmina": remmina, "sshConfig": os.path.isfile(os.path.join(SSH_DIR, "config"))}


def _foreign_entries(sources, ssh_dir=SSH_DIR):
    """(conn, notes, also, source) per connection the sources hold, in their order, and the errors
    on the way. A source is a file, a folder (its .rdp and .remmina files), "remmina" or
    "ssh-config"."""
    entries, errors, files = [], [], 0
    for source in sources:
        if source == "ssh-config":
            try:
                entries += [(c, n, a, "~/.ssh/config")
                            for c, n, a in parse_ssh_config(os.path.join(ssh_dir, "config"), ssh_dir)]
            except (OSError, ValueError) as e:
                errors.append(f"~/.ssh/config: {e}")
            continue
        if source == "remmina":
            paths = [os.path.join(d, n) for d in import_sources()["remmina"] for n in sorted(os.listdir(d))
                     if n.endswith(".remmina")]
        elif os.path.isdir(os.path.expanduser(source)):
            folder = os.path.expanduser(source)
            paths = [os.path.join(folder, n) for n in sorted(os.listdir(folder))
                     if n.lower().endswith(IMPORT_SUFFIXES)]
        else:
            paths = [os.path.expanduser(source)]
        for path in paths:
            files += 1
            if files > IMPORT_MAX_FILES:
                errors.append(f"only the first {IMPORT_MAX_FILES} files")
                return entries[:IMPORT_MAX_ENTRIES], errors
            base = os.path.basename(path)
            stem, ext = os.path.splitext(base)
            try:
                if ext.lower() == ".db":
                    found, problems = parse_1remote(path)
                    entries += [(conn, notes, None, base) for conn, notes in found]
                    errors += [f"{plain(base)[:60]}: {p}" for p in problems]
                    continue
                if ext.lower() == ".rdp":
                    conn, notes = parse_rdp(_read_foreign(path), stem)
                elif ext.lower() == ".remmina":
                    conn, notes = parse_remmina(_read_foreign(path), stem)
                else:
                    raise ValueError("not an .rdp, .remmina or 1Remote file")
            except (OSError, ValueError, configparser.Error, UnicodeError) as e:
                errors.append(f"{plain(base)[:60]}: {e}")
                continue
            entries.append((conn, notes, None, base))
    return entries[:IMPORT_MAX_ENTRIES], errors


def _foreign_problem(conn):
    """Why a parsed connection cannot be taken in, or ""."""
    if not conn.get("host"):
        return "no address"
    if not HOST_RE.match(conn["host"]):
        return "not a valid host"
    if conn.get("gateway") and not HOST_RE.match(conn["gateway"]):
        return "not a valid gateway"
    if "port" in conn and not 0 < conn["port"] < 65536:
        return "not a valid port"
    over = too_long(conn)
    if over:
        return f"its {over[0]} is longer than {over[1]} characters"
    return ""


def scan_foreign(sources, path=CONNECTIONS, ssh_dir=SSH_DIR):
    """What the sources hold, each with a status against what is here:
    new        not here yet (picked by default)
    here       the same server is here already (never changed)
    trashed    the same server is in Recently deleted (imported anew only when picked)
    twice      listed earlier in this import already
    invalid    cannot be taken in (reason says why)
    Returns {"entries": [...], "errors": [...]}; an entry's ref picks it for apply."""
    raw = load_raw(path)
    # An SSH connection here whose host is an alias in ~/.ssh/config is also the server it names.
    try:
        aliases = {c["host"].lower(): also for c, _n, also in parse_ssh_config(os.path.join(ssh_dir, "config"), ssh_dir)
                   if also}
    except (OSError, ValueError):
        aliases = {}

    def keys_of(conns):
        out = set()
        for c in conns:
            if isinstance(c, dict):
                key = connection_key(c)
                out.add(key)
                if key[0] == "ssh" and key[2] == 22 and key[1] in aliases:
                    out.add(aliases[key[1]])
        return out
    here = keys_of(raw.get("connections") or [])
    binned = keys_of(t.get("connection") for t in raw.get("trash") or [] if isinstance(t, dict))
    found, errors = _foreign_entries(sources, ssh_dir)
    entries, listed = [], set()
    for conn, notes, also, source in found:
        conn["group"] = conn.get("group") or IMPORT_GROUP
        key = connection_key(conn)
        keys = {key} | ({also} if also else set())
        problem = _foreign_problem(conn)
        status = "invalid" if problem else "here" if keys & here else "twice" if keys & listed \
            else "trashed" if keys & binned else "new"
        if not problem:
            listed |= keys
        entries.append({"ref": "%s|%s|%d" % key, "status": status, "reason": problem,
                        "protocol": conn["protocol"], "name": conn.get("name") or conn.get("host", ""),
                        "host": conn.get("host", ""), "port": key[2], "group": conn["group"],
                        "username": conn.get("username", ""), "gateway": conn.get("gateway", ""),
                        "notes": notes, "source": source,
                        "_conn": conn})
    return {"entries": entries, "errors": errors}


def import_foreign(sources, picked=None, path=CONNECTIONS, ssh_dir=SSH_DIR, now=None):
    """Adds the scanned connections whose ref is in picked (None: every new one), checked again
    against what is here now. Returns {"data", "report"} like import_file."""
    now = now if now is not None else now_ms()
    scan = scan_foreign(sources, path, ssh_dir)
    raw = load_raw(path)
    data = {k: raw.get(k) for k in ("connections", "groups", "trash", "deleted", "deletedGroups") if raw.get(k) is not None}
    conns = data.setdefault("connections", [])
    report = {"added": [], "updated": [], "restored": [], "trashed": [], "pendingDeletions": [],
              "pendingAddress": [], "errors": scan["errors"]}
    wanted = set(picked) if picked is not None else None
    for e in scan["entries"]:
        ok = e["status"] == "new" or (e["status"] == "trashed" and wanted is not None)
        if not ok or (wanted is not None and e["ref"] not in wanted):
            continue
        # Never a group's credential set, even in a group that has one: a file from elsewhere could
        # name your group and its own host, and the set's password would go there. It asks instead.
        new = dict(e["_conn"], id="c-" + uuid.uuid4().hex[:12], modified=now, credential="custom")
        conns.append(new)
        report["added"].append(new["name"])
    return {"data": data, "report": report}


# ---------------------------------------------------------------- kerberos
#
# MIT Kerberos reads every KDC the realm publishes in DNS and tries them in order, one second
# per UDP timeout before it falls back to TCP. A domain with dozens of DCs behind a VPN that
# drops UDP makes a ticket take a minute or more, and FreeRDP needs two. Windows avoids this
# with site-aware DC location; here the KDCs are probed in parallel over TCP, the fastest few
# are cached, and FreeRDP gets a private krb5.conf naming only those, TCP only.

CACHE_DIR = os.path.join(os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), APP)
KDC_CACHE_TTL = 6 * 3600
KDC_PROBE_TIMEOUT = 1.5
KDC_KEEP = 3


def kerberos_realm(conn):
    """The realm Kerberos will use: a dotted domain, else the host's DNS suffix. None for IPs and bare names."""
    domain = (conn.get("domain") or "").strip()
    if "." in domain:
        return domain.upper()
    host = (conn.get("host") or "").strip()
    if not host or "." not in host or re.fullmatch(r"[\d.]+|\[?[0-9a-fA-F:]+\]?", host):
        return None
    return host.split(".", 1)[1].upper()


def srv_records(name):
    """[(host, port)] for an SRV name ("_kerberos._tcp.ACME.LAN"), resolved in this process (GLib's
    resolver), so the realm never shows up in another program's command line. Only without
    python-gobject does it fall back to resolvectl, dig or host."""
    m = re.fullmatch(r"_([^.]+)\._([^.]+)\.(.+)", name)
    try:
        from gi.repository import Gio
    except ImportError:
        Gio = None
    if m and Gio is not None:
        try:
            targets = Gio.Resolver.get_default().lookup_service(m.group(1), m.group(2), m.group(3), None)
        except Exception:
            return []
        return [(t.get_hostname().rstrip("."), t.get_port()) for t in targets]
    return _srv_records_by_command(name)


def _srv_records_by_command(name):
    commands = [
        (["resolvectl", "query", "-t", "SRV", "--legend=no", name],
         re.compile(r"IN SRV \d+ \d+ (\d+) (\S+?)\.?(?:\s|$)"), (1, 0)),
        (["dig", "+short", "SRV", name], re.compile(r"^\d+ \d+ (\d+) (\S+?)\.?$", re.M), (1, 0)),
        (["host", "-t", "SRV", name], re.compile(r"has SRV record \d+ \d+ (\d+) (\S+?)\.?$", re.M), (1, 0)),
    ]
    for cmd, pattern, _order in commands:
        try:
            out = subprocess.run(cmd, capture_output=True, text=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            continue
        found = [(m.group(2), int(m.group(1))) for m in pattern.finditer(out.stdout)]
        if found:
            return found
    return []


def probe_kdcs(targets, timeout=KDC_PROBE_TIMEOUT):
    """[(latency, host, port)] of the targets accepting a TCP connection, fastest first."""
    import socket
    from concurrent.futures import ThreadPoolExecutor

    def probe(target):
        host, port = target
        start = time.monotonic()
        try:
            with socket.create_connection((host, port), timeout=timeout):
                return (time.monotonic() - start, host, port)
        except OSError:
            return None

    if not targets:
        return []
    with ThreadPoolExecutor(max_workers=min(32, len(targets))) as pool:
        results = [r for r in pool.map(probe, targets) if r]
    return sorted(results)


def discover_kdcs(realm, cache_dir=CACHE_DIR):
    """The fastest reachable KDCs of a realm as "host:port", cached; [] when there is nothing to improve on."""
    path = os.path.join(cache_dir, "kdc-" + realm.lower() + ".json")
    try:
        with open(path, encoding="utf-8") as f:
            cached = json.load(f)
        if time.time() - cached.get("probed", 0) < KDC_CACHE_TTL and cached.get("kdcs"):
            host, _, port = cached["kdcs"][0].rpartition(":")
            # Still answering? A changed network (VPN off, other site) re-probes.
            if probe_kdcs([(host, int(port))], timeout=0.5):
                return cached["kdcs"]
    except (OSError, ValueError, KeyError, IndexError):
        pass
    targets = srv_records(f"_kerberos._tcp.{realm}") or srv_records(f"_kerberos._udp.{realm}")
    # Dedupe; DNS lists the same DC for both transports.
    targets = list(dict.fromkeys(targets))
    kdcs = [f"{h}:{p}" for _, h, p in probe_kdcs(targets)[:KDC_KEEP]]
    if kdcs:
        os.makedirs(cache_dir, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump({"realm": realm, "probed": int(time.time()), "kdcs": kdcs, "candidates": len(targets)}, f)
    return kdcs


def krb5_config(realm, kdcs, host=""):
    """A krb5.conf fragment pinning a realm to the given KDCs over TCP. The realm comes from the
    domain or the host and the KDCs from DNS: anything that is not a plain name stays out."""
    if not HOST_RE.match(realm or ""):
        raise ValueError("not a realm name")
    kdcs = [k for k in kdcs if HOST_RE.match(k)]
    host = host if HOST_RE.match(host or "") else ""
    lines = ["[libdefaults]", "\tudp_preference_limit = 1", "", "[realms]", f"\t{realm} = {{"]
    lines += [f"\t\tkdc = {k}" for k in kdcs]
    lines += ["\t}", ""]
    if "." in host:
        lines += ["[domain_realm]", f"\t.{host.split('.', 1)[1].lower()} = {realm}", ""]
    return "\n".join(lines)


def kerberos_domain(conn):
    """The domain to sign in with: a NetBIOS name ("acme") becomes the matching DNS domain
    ("acme.lan") when the host lives there, because Kerberos needs the DNS name as its realm and
    FreeRDP takes the realm from the domain. NTLM accepts either form."""
    domain = (conn.get("domain") or "").strip()
    realm = kerberos_realm(conn)
    if domain and "." not in domain and realm and realm.split(".")[0] == domain.upper():
        return realm.lower()
    return domain


def kerberos_env(conn, runtime_dir=RUNTIME_DIR, discover=discover_kdcs):
    """Environment for FreeRDP so Kerberos goes straight to reachable KDCs; {} when not applicable."""
    realm = kerberos_realm(conn)
    if not realm or not HOST_RE.match(realm):
        return {}  # the realm names the cache and config files: a plain name only
    manual = [k.strip() for k in (conn.get("kdc") or "").split(",") if k.strip()]
    kdcs = manual or discover(realm)
    if not kdcs:
        return {}
    os.makedirs(runtime_dir, exist_ok=True)
    text = krb5_config(realm, kdcs, conn.get("host", ""))  # refuses a realm that is not a plain name
    path = os.path.join(runtime_dir, "krb5-" + realm.lower() + ".conf")
    with open(path, "w", encoding="utf-8") as f:
        f.write(text)
    base = os.environ.get("KRB5_CONFIG") or "/etc/krb5.conf"
    return {"KRB5_CONFIG": path + ":" + base}


# ---------------------------------------------------------------- session state

def _session_path(sid):
    return os.path.join(SESSIONS_DIR, sid + ".json")


# Where a session is shown belongs to whoever shows it (set_view); the supervisor rewrites the rest
# of the record on every state change and must not put an old view back.
VIEW_KEYS = ("view", "viewer")


@contextlib.contextmanager
def _sessions_lock():
    """Held around every read-modify-write of a session record: the supervisor and set_view (the
    window showing it) both rewrite the same file, and one must not undo the other."""
    os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)
    fd = os.open(os.path.join(SESSIONS_DIR, ".lock"), os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def _write_session_locked(state, keep):
    try:
        with open(_session_path(state["id"]), encoding="utf-8") as f:
            current = json.load(f)
        for key in keep:
            if key in current:
                state[key] = current[key]
    except (OSError, ValueError, TypeError):
        pass
    fd, tmp = tempfile.mkstemp(dir=SESSIONS_DIR, prefix="." + state["id"] + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(state, f)
        os.replace(tmp, _session_path(state["id"]))
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def write_session(state, keep=VIEW_KEYS):
    with _sessions_lock():
        _write_session_locked(state, keep)
    touch_changes()


def touch_changes():
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    fd = os.open(CHANGES, os.O_WRONLY | os.O_CREAT, 0o600)
    try:
        os.ftruncate(fd, 0)
        os.write(fd, str(time.time_ns()).encode())
    finally:
        os.close(fd)


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, TypeError):
        return False
    except PermissionError:
        return True


def ensure_changes():
    """Create the watch target without touching it, so a watcher can attach before any session."""
    os.makedirs(RUNTIME_DIR, mode=0o700, exist_ok=True)
    os.close(os.open(CHANGES, os.O_WRONLY | os.O_CREAT, 0o600))


def list_sessions():
    sessions = []
    try:
        names = os.listdir(SESSIONS_DIR)
    except FileNotFoundError:
        return sessions
    try:
        hotkeys = {c.get("id") for c in load_connections() if is_hotkey(c)}
    except (OSError, ValueError):
        hotkeys = set()
    for name in names:
        if not name.endswith(".json"):
            continue
        try:
            with open(os.path.join(SESSIONS_DIR, name), encoding="utf-8") as f:
                s = json.load(f)
        except (OSError, ValueError):
            continue
        if s.get("state") in ("connecting", "connected") and not _alive(s.get("supervisor")):
            s["state"] = "failed"
            s["error"] = s.get("error") or "The session supervisor disappeared"
        s.setdefault("view", "tab" if s.get("tab") else "window")
        s.setdefault("viewer", None)
        # An own window that is gone (closed or crashed) leaves its session for the manager's tabs.
        if s["view"] == "window" and s.get("tab") and not _alive(s.get("viewer")):
            s["view"], s["viewer"] = "tab", None
        # Its connection opens as a hotkey window (is_hotkey: openIn hotkey, not VNC, not RDP on
        # all monitors), so `omaremote toggle` shows or hides it.
        s["hotkey"] = s.get("connection") in hotkeys
        sessions.append(s)
    sessions.sort(key=lambda s: s.get("started", 0), reverse=True)
    return prune(sessions)


KEEP_FINISHED = 3


def prune(sessions):
    """Keep the newest few finished sessions per connection; their logs are what a failure is read from."""
    kept, finished = [], {}
    for s in sessions:
        if s.get("state") in ("connecting", "connected"):
            kept.append(s)
            continue
        n = finished.get(s.get("connection"), 0)
        finished[s.get("connection")] = n + 1
        if n < KEEP_FINISHED:
            kept.append(s)
        else:
            for suffix in (".json", ".log", ".stop"):
                try:
                    os.remove(os.path.join(SESSIONS_DIR, s["id"] + suffix))
                except (FileNotFoundError, KeyError):
                    pass
    return kept


# ---------------------------------------------------------------- supervisor

def session_socket(sid):
    """Where a tab session listens; Unix socket paths are capped at 107 bytes."""
    path = os.path.join(SESSIONS_DIR, sid + ".sock")
    if len(path.encode()) < 100:
        return path
    short = os.path.join(os.environ.get("XDG_RUNTIME_DIR") or "/tmp", f"omaremote-{sid}.sock")
    return short


def supervise(conn, sid, tab=None):
    """Runs detached: starts the session's client, follows its log, records state until it exits."""
    protocol = conn.get("protocol") or "rdp"
    if protocol in ("vnc", "ssh", "gliff") and not tab:
        tab = {"width": 1280, "height": 800, "scale": 100}  # VNC, SSH and Gliff sessions always live in a tab
    log_path = os.path.join(SESSIONS_DIR, sid + ".log")
    socket_path = session_socket(sid) if tab else None
    state = {
        "id": sid, "connection": conn["id"], "name": conn.get("name") or conn["host"],
        "host": conn["host"], "protocol": conn.get("protocol", "rdp"), "state": "connecting",
        "stage": "Finding domain controller", "auth": None,
        "started": int(time.time()), "ended": 0, "pid": 0, "supervisor": os.getpid(),
        "exitCode": None, "error": None, "log": log_path,
        "tab": bool(tab), "socket": socket_path,
        # tab: drawn in the manager's tab; window: drawn in an own window (viewer is its process),
        # or, for a session without a tab renderer, FreeRDP's own window.
        "view": "tab" if tab else "window", "viewer": None,
    }
    if protocol in ("vnc", "ssh", "gliff"):
        state["stage"] = "Connecting"
    write_session(state)
    krb_env = {}
    if protocol == "rdp":
        try:
            krb_env = kerberos_env(conn)
        except Exception:  # discovery is an optimisation; FreeRDP still works without it
            pass
        conn = dict(conn, domain=kerberos_domain(conn))
    password = None
    if conn.get("savePassword") and conn.get("secretId"):
        password = secret_get(conn["secretId"], conn.get("secretKind", "connection"))
    try:
        if protocol == "vnc":
            args = build_vnc_config(conn, password=password)
        elif protocol == "ssh":
            args = build_ssh_config(conn)
        elif protocol == "gliff":
            args = build_gliff_config(conn)
        else:
            gateway_password = None
            if conn.get("gatewaySavePassword") and conn.get("gateway", "").strip() and conn.get("id"):
                gateway_password = secret_get(conn["id"], "gateway")
            args = build_args(conn, password=password, auto_scale=monitor_scale(), tab=tab,
                              gateway_password=gateway_password)
    except ValueError as e:
        state.update(state="failed", error=f"Not connected: {e}", ended=int(time.time()))
        write_session(state)
        return 1
    env = dict(os.environ, SDL_APP_ID=SESSION_APP_ID, WLOG_LEVEL=os.environ.get("WLOG_LEVEL", "INFO"),
               **krb_env)
    # The stage markers below are DEBUG lines; raise only their tags, not the whole log.
    env.setdefault("WLOG_FILTER", "com.freerdp.core.nego:DEBUG,com.freerdp.core.auth:DEBUG,com.winpr.negotiate:DEBUG")
    state["stage"] = "Connecting"
    if tab:
        client = tab_client(protocol)
        if not client:
            state.update(state="failed", ended=int(time.time()),
                         error=f"The {protocol.upper()} renderer is not built: run ./install.sh"
                               + (" (or open in a window)" if protocol == "rdp" else ""))
            write_session(state)
            return 1
        command = [client]  # reads its arguments from stdin
        env["OMAREMOTE_SOCKET"] = socket_path
    else:
        command = [CLIENT, "/args-from:stdin"]
    try:
        # WLog writes INFO to stdout through stdio, which a pipe would block-buffer: line mode
        # is what lets the "connected" marker arrive when it happens.
        proc = subprocess.Popen(["stdbuf", "-oL", "-eL", *command], stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env, text=True,
                                errors="replace")
    except OSError as e:
        state.update(state="failed", error=f"Could not start {command[0]}: {e}", ended=int(time.time()))
        write_session(state)
        return 1
    state["pid"] = proc.pid
    write_session(state)

    def forward(signum, _frame):
        proc.send_signal(signum)
    signal.signal(signal.SIGTERM, forward)
    signal.signal(signal.SIGINT, forward)

    proc.stdin.write("\n".join(args) + "\n")
    proc.stdin.close()
    del password, args

    tail = []
    with open(log_path, "w", encoding="utf-8") as log:
        if krb_env:
            log.write(f"[omaremote] Kerberos: {krb_env['KRB5_CONFIG'].split(':')[0]}\n")
        for line in proc.stdout:
            log.write(line)
            log.flush()
            tail.append(line)
            del tail[:-60]
            if state["state"] != "connecting":
                continue
            # gdi_init_ex runs in post-connect: the session is up and drawing.
            # gdi_init_ex is FreeRDP's post-connect; omaremote-vnc, -ssh and -gliff say so themselves.
            if "gdi_init_ex" in line or line.startswith("[omaremote] connected to"):
                state.update(state="connected", stage=None)
                write_session(state)
                mark_connected(conn["id"])
                continue
            stage, auth = session_stage(line)
            if (stage and stage != state["stage"]) or (auth and auth != state["auth"]):
                state["stage"] = stage or state["stage"]
                state["auth"] = auth or state["auth"]
                write_session(state)
    code = proc.wait()
    stopped = os.path.join(SESSIONS_DIR, sid + ".stop")
    error = None if os.path.exists(stopped) else describe_exit(code, "".join(tail), protocol)
    if os.path.exists(stopped):
        os.remove(stopped)
    state.update(state="failed" if error else "ended", exitCode=code, error=error, ended=int(time.time()))
    write_session(state)
    if error and os.environ.get("OMAREMOTE_NOTIFY", "1") == "1":
        notify()
    if protocol == "ssh":
        files_after_session(conn)
    return 0


def files_after_session(conn):
    """Settings › SSH › After a session = Unmount: the files go once the last session to the
    connection has ended, however it ended (exit, a closed tab or window, OMARemote closed). Ask and
    Keep are the UI's: it asks where the user is, or leaves them."""
    try:
        if ((load_raw().get("ui") or {}).get("sftpOnEnd") or "ask") != "unmount":
            return
        if any(s.get("connection") == conn.get("id") and s.get("state") in ("connecting", "connected")
               for s in list_sessions()):
            return
        if files_mounted(conn):
            subprocess.run(["gio", "mount", "-u", sftp_uri(conn)], stdin=subprocess.DEVNULL,
                           capture_output=True, timeout=30)
            touch_changes()
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass


# The same words for every failure: a notification's text is not private once it leaves (Omarchy's
# notification service, for one, hands it to a shell on the command line). Which connection failed
# and why stay in OMARemote: the session's state, its tab and the Active list.
NOTIFY_SUMMARY = "OMARemote"
NOTIFY_BODY = "A connection failed: open OMARemote for details"


def notify():
    """The desktop notification for a failed session, sent over D-Bus from this process (notify-send
    without python-gobject). It names no connection, host or user, and carries no error text."""
    try:
        from gi.repository import Gio, GLib
        bus = Gio.bus_get_sync(Gio.BusType.SESSION)
        bus.call_sync("org.freedesktop.Notifications", "/org/freedesktop/Notifications",
                      "org.freedesktop.Notifications", "Notify",
                      GLib.Variant("(susssasa{sv}i)", ("OMARemote", 0, "omaremote", NOTIFY_SUMMARY, NOTIFY_BODY,
                                                       [], {"urgency": GLib.Variant("y", 1)}, -1)),
                      None, Gio.DBusCallFlags.NONE, 5000, None)
    except Exception:
        try:
            subprocess.run(["notify-send", "-a", "OMARemote", "-u", "normal", NOTIFY_SUMMARY, NOTIFY_BODY],
                           capture_output=True, timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            pass


def parse_tab(spec):
    """"2560x1500@160" -> {"width": 2560, "height": 1500, "scale": 160}."""
    m = re.fullmatch(r"(\d+)x(\d+)(?:@(\d+))?", spec or "")
    if not m:
        raise ValueError(f"bad --tab size {spec!r}, expected WxH@scale")
    return {"width": int(m.group(1)), "height": int(m.group(2)), "scale": int(m.group(3) or 100)}


def launch(key, tab=None):
    conn = find_connection(key, load_connections())
    if conn is None:
        print(f"no connection named or with id {key!r}", file=sys.stderr)
        return 2
    if not conn.get("host", "").strip():
        print("connection has no host", file=sys.stderr)
        return 2
    sid = time.strftime("%Y%m%d-%H%M%S-") + uuid.uuid4().hex[:6]
    os.makedirs(SESSIONS_DIR, mode=0o700, exist_ok=True)
    # Double fork: the supervisor belongs to no terminal and outlives the UI.
    child = os.fork()
    if child > 0:
        os.waitpid(child, 0)
        print(sid)
        return 0
    os.setsid()
    if os.fork() > 0:
        os._exit(0)
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    try:
        os._exit(supervise(conn, sid, tab))
    except Exception as e:  # never leave a session stuck in "connecting"
        write_session({"id": sid, "connection": conn["id"], "name": conn.get("name", ""),
                       "host": conn.get("host", ""), "state": "failed", "error": str(e),
                       "started": int(time.time()), "ended": int(time.time())})
        os._exit(1)


def stop(sid):
    for s in list_sessions():
        if s["id"] == sid and s.get("state") in ("connecting", "connected"):
            pid = s.get("pid")
            if not pid:
                return 1
            # Tells the supervisor the exit that follows was asked for, not a failure.
            open(os.path.join(SESSIONS_DIR, sid + ".stop"), "w").close()
            try:
                os.kill(pid, signal.SIGTERM)
                # FreeRDP ignores SIGTERM while one of its own dialogs is open.
                for _ in range(30):
                    time.sleep(0.1)
                    if not _alive(pid):
                        return 0
                os.kill(pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            return 0
    return 1


def forget(sid):
    for suffix in (".json", ".log", ".stop", ".sock"):
        try:
            os.remove(os.path.join(SESSIONS_DIR, sid + suffix))
        except FileNotFoundError:
            pass
    touch_changes()
    return 0


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return 0
    migrate_legacy()
    cmd, rest = argv[1], argv[2:]
    if cmd in ("launch", "connect") and rest:
        tab = parse_tab(rest[rest.index("--tab") + 1]) if "--tab" in rest[1:-1] else None
        return launch(rest[0], tab)
    if cmd == "list":
        ensure_changes()
        print(json.dumps(list_sessions()))
        return 0
    if cmd == "stop" and rest:
        return stop(rest[0])
    if cmd == "forget" and rest:
        return forget(rest[0])
    if cmd == "args" and rest:
        conn = find_connection(rest[0], load_connections())
        if conn is None:
            return 2
        if conn.get("protocol") == "vnc":
            print("\n".join(redact(build_vnc_config(conn, "x" if conn["savePassword"] else None))))
            return 0
        if conn.get("protocol") == "ssh":
            print(" ".join(shlex.quote(a) for a in build_ssh_command(conn)))
            return 0
        if conn.get("protocol") == "gliff":
            print(" ".join(shlex.quote(a) for a in build_gliff_command(conn)))
            return 0
        print(" ".join(shlex.quote(a) for a in redact(build_args(
            conn, "x" if conn["savePassword"] else None, monitor_scale(),
            gateway_password="x" if conn.get("gatewaySavePassword") else None))))
        return 0
    if cmd == "export" and rest:
        print(json.dumps(export_file(rest[0])))
        return 0
    if cmd == "import" and rest:
        try:
            print(json.dumps(import_file(rest[0])))
        except (OSError, ValueError) as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "import-sources":
        print(json.dumps(import_sources()))
        return 0
    # Sources: files, folders, "remmina", "ssh-config". The UI passes them, and the refs picked, in
    # the environment (JSON lists): file names are often server names, and host names never go on a
    # command line. Without picked refs every new one is added.
    if cmd in ("import-scan", "import-foreign"):
        try:
            sources = rest or json.loads(os.environ.get("OMAREMOTE_IMPORT_SOURCES") or "[]")
            if not sources:
                raise ValueError("nothing to import")
            if cmd == "import-scan":
                scan = scan_foreign(sources)
                for e in scan["entries"]:
                    del e["_conn"]
                print(json.dumps(scan))
            else:
                picked = os.environ.get("OMAREMOTE_IMPORT_PICK")
                print(json.dumps(import_foreign(sources, json.loads(picked) if picked else None)))
        except (OSError, ValueError) as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "sync":
        allow =rest[rest.index("--allow-deletions") + 1].split(",") if "--allow-deletions" in rest[:-1] else ()
        address = rest[rest.index("--allow-address") + 1].split(",") if "--allow-address" in rest[:-1] else ()
        # The UI passes them in the environment (JSON lists): system and group names never go on a
        # command line, which other accounts can read.
        try:
            allow = tuple(allow) + tuple(json.loads(os.environ.get("OMAREMOTE_ALLOW_DELETIONS") or "[]"))
            address = tuple(address) + tuple(json.loads(os.environ.get("OMAREMOTE_ALLOW_ADDRESS") or "[]"))
        except ValueError:
            pass
        try:
            print(json.dumps(sync_folder(allow_deletions=allow, allow_address=address)))
        except (OSError, ValueError) as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "pick" and rest and rest[0] in ("folder", "open", "save", "key", "import", "1remote"):
        opt = lambda flag: rest[rest.index(flag) + 1] if flag in rest[1:-1] else ""
        try:
            paths = pick(rest[0], opt("--title"), opt("--current"), opt("--name"))
            print(json.dumps({"path": paths[0] if paths else "", "paths": paths}))
        except Exception as e:  # no portal, no D-Bus, no python-gobject: the field still takes a typed path
            print(json.dumps({"error": f"no file chooser: {e}"}))
            return 1
        return 0
    if cmd == "ssh-keys":
        print(json.dumps(ssh_keys()))
        return 0
    if cmd == "ssh-config":
        try:
            print(json.dumps(ssh_config_sync()))
        except OSError as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "watch-folder" and rest:
        try:
            watch_folder(rest[0])
        except (OSError, KeyboardInterrupt, BrokenPipeError):
            return 1
        return 0
    if cmd == "system-name":
        print(system_name(load_raw()))
        return 0
    if cmd == "paths":
        ensure_changes()
        print(json.dumps({"runtime": RUNTIME_DIR, "changes": CHANGES, "connections": CONNECTIONS}))
        return 0
    if cmd == "view" and len(rest) in (2, 3) and rest[1] in ("tab", "window"):
        return 0 if set_view(rest[0], rest[1], rest[2] if len(rest) == 3 else None) else 1
    if cmd == "float" and len(rest) in (2, 3) and rest[0] == "pid":
        return 0 if float_window(rest[1], int(rest[2]) if len(rest) == 3 else 90) else 1
    if cmd == "terminal-tag" and len(rest) == 2 and rest[1] in ("on", "off"):
        return 0 if terminal_tag(rest[0], rest[1] == "on") else 1
    if cmd == "summon" and len(rest) == 2 and rest[0] == "pid":
        return 0 if summon_window(rest[1]) else 1
    if cmd == "open-window" and rest:
        return open_window(" ".join(rest))
    if cmd == "toggle" and rest:
        show = rest[0] == "--show"
        rest = rest[1:] if show else rest
        return toggle(" ".join(rest), show_only=show) if rest else 2
    if cmd == "place" and len(rest) == 2:
        return 0 if place_window(rest[0], rest[1]) else 1
    if cmd == "hide" and len(rest) == 1:
        return 0 if hide_window(rest[0]) else 1
    if cmd == "close-key":
        print(close_key())
        return 0
    if cmd == "browse" and rest:
        print(json.dumps(browse(" ".join(rest))))
        return 0
    if cmd == "unmount" and rest:
        print(json.dumps(unmount_files(" ".join(rest))))
        return 0
    if cmd == "mounts":
        print(json.dumps(mounted_files()))
        return 0
    if cmd == "restart-gvfs":
        print(json.dumps(restart_gvfs()))
        return 0
    if cmd == "hotkeys":
        print(json.dumps(hypr_hotkeys()))
        return 0
    if cmd == "hypr-hotkeys":
        try:
            print(json.dumps(hypr_hotkeys_sync()))
        except OSError as e:
            print(json.dumps({"error": str(e)}))
            return 1
        return 0
    if cmd == "fullscreen":
        toggle_fullscreen()
        return 0
    if cmd == "plugin-check":
        offline, latest, args = False, "", list(rest)
        while args:
            arg = args.pop(0)
            if arg == "--offline":
                offline = True
            elif arg == "--latest" and args:
                latest = args.pop(0)
            else:
                print(__doc__.strip(), file=sys.stderr)
                return 2
        print(json.dumps(plugin_check(offline=offline, latest=latest)))
        return 0
    if cmd == "update-check" and len(rest) == 1:
        try:
            print(json.dumps(update_check(rest[0])))
        except (OSError, ValueError) as e:
            print(f"update check failed: {e}", file=sys.stderr)
            return 1
        return 0
    if cmd == "focus" and len(rest) == 2 and rest[0] in ("class", "pid"):
        return 0 if focus_window(rest[0], rest[1]) else 1
    if cmd == "monitor-scale":
        print(monitor_scale())
        return 0
    if cmd == "secret" and len(rest) in (2, 3):
        # secret <set|clear|has> <connection-id>   or   secret <set|clear|has> credential <set-id>
        # or   secret <set|clear|has> gateway <connection-id>
        action, kind, key = (rest[0], "connection", rest[1]) if len(rest) == 2 else rest
        if kind not in ("connection", "credential", "gateway"):
            return 2
        if action == "set":
            return 0 if secret_set(key, sys.stdin.read().rstrip("\n"), secret_label(key, kind), kind) else 1
        if action == "clear":
            secret_clear(key, kind)
            return 0
        if action == "has":
            return 0 if secret_get(key, kind) else 1
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
