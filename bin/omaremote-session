#!/usr/bin/env python3
"""omaremote session backend.

Owns everything the UI should not: the FreeRDP command line, the keyring, and
the lifetime of each session. A session is supervised by a detached process,
so closing the window never closes a remote desktop.

  omaremote-session launch <id|name> [--tab WxH@scale]
                                          start a session (returns at once); --tab runs it for a
                                          tab in the UI, sized in device pixels
  omaremote-session list                 running and recent sessions, JSON
  omaremote-session paths                runtime paths the UI watches, JSON
  omaremote-session stop <session-id>    disconnect a session
  omaremote-session forget <session-id>  drop a finished session from the list
  omaremote-session args <id|name>       the FreeRDP arguments, password redacted
  omaremote-session secret set|clear|has [credential|gateway] <id>   keyring password (set reads stdin)
  omaremote-session monitor-scale        the focused Hyprland monitor scale, in percent
  omaremote-session focus class|pid <v>  bring a window forward, switching workspace if needed
  omaremote-session update-check <ver>   the newest release on GitHub for this machine, JSON
  omaremote-session plugin-check [--offline] [--latest <ver>]   the Omarchy bar plugin: installed,
                                         newer release (--latest: compare with a release already known)
  omaremote-session view <id> tab|window [pid]   where a session is shown (window: its process)
  omaremote-session fullscreen           toggle fullscreen for the focused window
  omaremote-session float pid <pid> [%]  float a window at % (90) of its monitor, centred
  omaremote-session summon pid <pid>     move a window to the current workspace and focus it
  omaremote-session terminal-tag <pid> on|off   tag a window as a terminal for Hyprland (an SSH session shows)
  omaremote-session open-window <name>   a connection in a floating window of its own, here
  omaremote-session toggle [--show] <name>   a hotkey window: show it (connecting if needed) or hide it
  omaremote-session place <session> <pid>    a new own window: float it, and into its special workspace
                                         when it is a hotkey window
  omaremote-session hide <session>       hide a hotkey window (ctrl+alt+h)
  omaremote-session browse <id>          an SSH connection's files (GVFS) in the default file manager
  omaremote-session unmount <id>         unmount them again
  omaremote-session mounts               the SSH connections whose files are mounted, JSON
  omaremote-session restart-gvfs         restart gvfs-daemon, when its folder layer is gone
  omaremote-session hotkeys              the shortcuts Hyprland already binds, JSON (for conflicts)
  omaremote-session close-key            the key Hyprland closes a window with ("super+w")
  omaremote-session hypr-hotkeys         write ~/.config/hypr/omaremote.lua when Settings allow it
  omaremote-session export <file|folder> connections and groups to a file (no user names or passwords)
  omaremote-session import <file>        merge an export: prints the result for the UI, JSON
  omaremote-session sync [--allow-deletions <system,…>] [--allow-address <id,…>]
                                         one round of folder sync, JSON for the UI
  omaremote-session system-name          this system's name in the sync folder
  omaremote-session watch-folder <dir>   print each *.omaremote.json that arrives or changes there
  omaremote-session ssh-keys             keys in ~/.ssh (files, and agent keys by their .pub), JSON
  omaremote-session ssh-config           write ~/.ssh/omaremote.conf for SSH connections with a key
  omaremote-session pick folder|open|save|key|import|1remote [--title T] [--current PATH] [--name NAME]
                                         the desktop's file chooser (portal); prints {"path"}, "" if cancelled
"""

