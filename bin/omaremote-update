#!/bin/bash
# omaremote-update: install the newest OMARemote release for this machine with pacman, then restart
# the open OMARemote window on it. Running sessions are separate processes: they keep going and come
# back as tabs. The update button in OMARemote runs this in a floating Omarchy terminal, where sudo
# can ask for the password.
set -uo pipefail

here="$(dirname "$(readlink -f "$0")")"
current=$("$here/omaremote" --version 2>/dev/null | awk '{print $2}')

check=$("$here/omaremote-session" update-check "${current:-0}") || {
  echo "Could not reach GitHub to look for a newer OMARemote."
  exit 1
}
read -r latest url < <(python3 -c 'import json,sys; d=json.load(sys.stdin); print(d["latest"] or "-", d["url"] or "-")' <<<"$check")
if [[ $url == - ]]; then
  echo "The newest OMARemote release has no package for $(uname -m)."
  exit 1
fi
if [[ $latest == "$current" ]]; then
  echo "OMARemote $current is the newest release already."
  exit 0
fi

# Releases are signed with OMARemote's release key (packaging/arch/omaremote-release.gpg, installed
# beside the UI): a package whose signature does not check out against it is never installed.
keyring=/usr/share/omaremote/omaremote-release.gpg
[[ -f $keyring ]] || keyring="$(dirname "$here")/packaging/arch/omaremote-release.gpg"

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
package="$work/${url##*/}"
echo "Updating OMARemote $current to $latest…"
curl -fL --proto '=https' --progress-bar -o "$package" "$url" || exit 1
curl -fsSL --proto '=https' -o "$package.sig" "$url.sig" || {
  echo "The release has no signature ($url.sig): not installing it."
  exit 1
}
if ! gpgv --status-fd 1 --keyring "$keyring" "$package.sig" "$package" 2>/dev/null | grep -q '^\[GNUPG:\] VALIDSIG '; then
  echo "The package's signature does not check out against OMARemote's release key: not installing it."
  exit 1
fi
echo "Signature checked: signed with OMARemote's release key."

# The tab renderer is a Qt plugin: it loads only on the Qt it was built against or newer. A
# package built on a newer Qt than this system has (Arch Linux ARM can be ahead of an Omarchy
# that has not updated yet) waits for a system update; pacman would otherwise upgrade Qt's base
# alone and leave the rest of Qt behind, which breaks more than OMARemote.
built=$(bsdtar -xOf "$package" .BUILDINFO 2>/dev/null | sed -n 's/^installed = qt6-base-\([0-9]*\.[0-9]*\)\..*/\1/p')
have=$(pacman -Q qt6-base 2>/dev/null | awk '{ split($2, v, "."); print v[1] "." v[2] }')
if [[ -n $built && -n $have ]] && (( $(vercmp "$built" "$have") > 0 )); then
  echo "OMARemote $latest needs Qt $built; this system has Qt $have."
  echo "Update the system first (omarchy update), then update OMARemote again."
  exit 1
fi
sudo pacman -U "$package" || exit 1

# The open window still runs the old version from memory: close it and start the new one.
pid=$(hyprctl clients -j 2>/dev/null | python3 -c 'import json,sys
for c in json.load(sys.stdin):
    if c.get("class") == "omaremote": print(c["pid"]); break' 2>/dev/null)
if [[ -n $pid ]]; then
  qs ipc --pid "$pid" call omaremote quit >/dev/null 2>&1
  for _ in $(seq 50); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
fi
setsid -f uwsm-app -- omaremote >/dev/null 2>&1
echo "OMARemote $latest is installed."
